/-!
# The martingale route to Theorem 4(b)

This file develops the martingale argument behind part (b) of Theorem 4 of the paper
(asymptotic normality of the joint-projection Mundlak estimator under interaction components).
The degenerate multilinear score of Lemma SM.C.2 is re-indexed as a martingale-difference array,
to which the martingale central limit theorem `StatLean.TimeSeries.mds_clt` (Brown 1971;
Hall and Heyde 1980, Corollary 3.1) applies. The first condition of that theorem is derived from
Lemma SM.C.3 (concentration of the conditional variance), the truncation limit `L → ∞` is
taken on characteristic functions, and the conditioning on the design `𝒟` is removed through
the regular conditional law `ProbabilityTheory.condExpKernel`.

## Main results

* `isMDSArray_degenDiff`, `tendsto_charFun_degenSum`: the martingale CLT for `T_n(L)/s_n(L)`.
* `CondD.tendstoInDistribution_of_design`: removal of the conditioning on the design.
* `Trunc.tendsto_charFun_of_l2_approx`: the truncation limit `L → ∞`.
* `Orth.integral_degenTerm_mul_eq_zero_of_or`: orthogonality of completely degenerate terms.
* `Var.tendstoInProb_condVar_of_concentration`: `V_n²/s_n²(L) →ᵖ 1` from Lemma SM.C.3.
* `Step2.degenDiff_prodKernel_factor`, `Alg.halg_of_multiKernel`: the conditional-variance
  algebra for the tensor-product basis expansion.
* `Cell.tendsto_charFun_total_of_concentration`: the martingale CLT for the full statistic,
  latent and cell steps together.
-/

open MeasureTheory ProbabilityTheory Filter Finset
open scoped MeasureTheory Topology RealInnerProductSpace ENNReal NNReal

namespace Multiway

namespace CLTMartingale

open DegenerateSum StatLean.TimeSeries

/-! ### The martingale differences as an array -/

section Array

variable {Ω : Type*} {m0 : MeasurableSpace Ω} {μ : Measure Ω} [IsProbabilityMeasure μ]
  {V ι T : Type*} [Fintype ι] [Fintype T] [DecidableEq T]

set_option warn.classDefReducibility false in
/-- The row filtration: `ℱ_κ` is generated by the latent variables revealed by step `κ`,
indexed by `Fin (k n + 1)` for each row `n`. -/
def rowSigma (U : ℕ → V → Ω → ℝ) (step : ℕ → V → ℕ) (k : ℕ → ℕ)
    (n : ℕ) (i : Fin (k n + 1)) : MeasurableSpace Ω :=
  latentSigma (U n) (revealed (step n) (i : ℕ))

/-- The row array `X_{n,i} = D_i` for the `n`-th design. -/
noncomputable def rowDiff (μ : Measure Ω) (U : ℕ → V → Ω → ℝ) (coord : ℕ → T → ι → V)
    (g : ℕ → (ι → ℝ) → ℝ) (c : ℕ → T → ℝ) (step : ℕ → V → ℕ) (k : ℕ → ℕ)
    (n : ℕ) (i : Fin (k n)) : Ω → ℝ :=
  degenDiff μ (U n) (coord n) (g n) (c n) (step n) (i : ℕ)

omit [Fintype ι] [DecidableEq T] in
/-- The martingale differences of Lemma SM.C.2, one row per design, form a
`StatLean.TimeSeries.IsMDSArray` for the row filtration `rowSigma`. -/
theorem isMDSArray_degenDiff {U : ℕ → V → Ω → ℝ} {coord : ℕ → T → ι → V}
    {g : ℕ → (ι → ℝ) → ℝ} {c : ℕ → T → ℝ} {step : ℕ → V → ℕ} {k : ℕ → ℕ}
    (hU : ∀ n v, Measurable (U n v))
    (hsq : ∀ n t, MemLp (degenTerm (U n) (coord n) (g n) t) 2 μ) :
    IsMDSArray k (rowDiff μ U coord g c step k) (rowSigma U step k) μ where
  le_ambient n i := latentSigma_le (hU n) _
  mono n i j hij := latentSigma_mono (U n) fun _ hv => lt_of_lt_of_le hv (Fin.le_def.mp hij)
  adapted n i := by
    have hmono : latentSigma (U n) (revealed (step n) (i : ℕ))
        ≤ latentSigma (U n) (revealed (step n) ((i : ℕ) + 1)) :=
      latentSigma_mono (U n) fun _ hv => lt_of_lt_of_le hv (Nat.le_succ _)
    have h1 : StronglyMeasurable[latentSigma (U n) (revealed (step n) ((i : ℕ) + 1))]
        (μ[degenSum (U n) (coord n) (g n) (c n) |
          latentSigma (U n) (revealed (step n) ((i : ℕ) + 1))]) :=
      stronglyMeasurable_condExp
    have h2 : StronglyMeasurable[latentSigma (U n) (revealed (step n) ((i : ℕ) + 1))]
        (μ[degenSum (U n) (coord n) (g n) (c n) |
          latentSigma (U n) (revealed (step n) (i : ℕ))]) :=
      stronglyMeasurable_condExp.mono hmono
    exact (h1.sub h2).measurable
  memLp n i := by
    have hsum : MemLp (degenSum (U n) (coord n) (g n) (c n)) 2 μ :=
      memLp_finsetSum' (Finset.univ : Finset T)
        fun t _ => (hsq n t).const_smul (c n t)
    exact ((hsum.condExp one_le_two).sub (hsum.condExp one_le_two))
  condexp_zero n i :=
    condExp_degenDiff_eq_zero (μ := μ) (U := U n) (coord := coord n) (g := g n)
      (c := c n) (step := step n) (hU n) (i : ℕ)

/-- The row sum of the array is `T_n(L) = ∑_κ D_κ`, which equals `degenSum` almost surely once
`N` exceeds the last reveal. -/
theorem mdsRowSum_degenDiff_ae [Nonempty ι] {U : ℕ → V → Ω → ℝ} {coord : ℕ → T → ι → V}
    {g : ℕ → (ι → ℝ) → ℝ} {c : ℕ → T → ℝ} {step : ℕ → V → ℕ} {k : ℕ → ℕ}
    (hU : ∀ n v, Measurable (U n v)) (hindep : ∀ n, iIndepFun (U n) μ)
    (hg : ∀ n, Measurable (g n))
    (hint : ∀ n t, Integrable (degenTerm (U n) (coord n) (g n) t) μ)
    (hdeg : ∀ (n : ℕ) (t : T) (e' : Set ι), e' ≠ Set.univ →
      μ[degenTerm (U n) (coord n) (g n) t | latentSigma (U n) (coord n t '' e')] =ᵐ[μ] 0)
    (hN : ∀ n v, step n v < k n) (n : ℕ) :
    mdsRowSum k (rowDiff μ U coord g c step k) n
      =ᵐ[μ] degenSum (U n) (coord n) (g n) (c n) := by
  have h := degenSum_eq_sum_degenDiff (μ := μ) (U := U n) (coord := coord n) (g := g n)
    (c := c n) (step := step n) (hU n) (hindep n) (hg n) (hint n) (hdeg n) (k n) (hN n)
  have hrow : ∀ ω, mdsRowSum k (rowDiff μ U coord g c step k) n ω
      = ∑ κ ∈ Finset.range (k n), degenDiff μ (U n) (coord n) (g n) (c n) (step n) κ ω := by
    intro ω
    simp only [mdsRowSum, rowDiff]
    exact Fin.sum_univ_eq_sum_range
      (fun κ => degenDiff μ (U n) (coord n) (g n) (c n) (step n) κ ω) (k n)
  filter_upwards [h] with ω hω
  rw [hrow ω]
  exact hω.symm

/-! ### The martingale central limit theorem for `T_n(L)` -/

/-- `T_n(L)/s_n(L) →ᵈ N(0,1)` for each fixed `L`, in the `charFun` form of
`StatLean.TimeSeries.mds_clt`. The hypotheses `hvar` (`V_n²/s_n²(L) →ᵖ 1`) and `hlind` (the
Lindeberg condition) are the two conditions of the martingale CLT; see
`Var.tendsto_charFun_degenSum_of_concentration` for a version in which `hvar` is proved. The
coefficients `c n` are taken already divided by `s_n(L)`. -/
theorem tendsto_charFun_degenSum [Nonempty ι] {U : ℕ → V → Ω → ℝ} {coord : ℕ → T → ι → V}
    {g : ℕ → (ι → ℝ) → ℝ} {c : ℕ → T → ℝ} {step : ℕ → V → ℕ} {k : ℕ → ℕ}
    (hU : ∀ n v, Measurable (U n v)) (hindep : ∀ n, iIndepFun (U n) μ)
    (hg : ∀ n, Measurable (g n))
    (hsq : ∀ n t, MemLp (degenTerm (U n) (coord n) (g n) t) 2 μ)
    (hdeg : ∀ (n : ℕ) (t : T) (e' : Set ι), e' ≠ Set.univ →
      μ[degenTerm (U n) (coord n) (g n) t | latentSigma (U n) (coord n t '' e')] =ᵐ[μ] 0)
    (hN : ∀ n v, step n v < k n)
    {σ2 : ℝ} (hσ : 0 ≤ σ2)
    (hvar : ∀ δ : ℝ, 0 < δ →
      Tendsto (fun n => (μ {ω | δ ≤
        |mdsCondVariance k (rowDiff μ U coord g c step k) (rowSigma U step k) μ n ω
          - σ2|}).toReal) atTop (𝓝 0))
    (hlind : ∀ ε : ℝ, 0 < ε →
      Tendsto (fun n => ∑ i, ∫ ω in {ω | ε ≤ |rowDiff μ U coord g c step k n i ω|},
        (rowDiff μ U coord g c step k n i ω) ^ 2 ∂μ) atTop (𝓝 0))
    (u : ℝ) :
    Tendsto (fun n => charFun (μ.map (degenSum (U n) (coord n) (g n) (c n))) u) atTop
      (𝓝 (charFun (gaussianReal 0 (Real.toNNReal σ2)) u)) := by
  have hint : ∀ n t, Integrable (degenTerm (U n) (coord n) (g n) t) μ :=
    fun n t => (hsq n t).integrable one_le_two
  have hmap : ∀ n : ℕ, μ.map (degenSum (U n) (coord n) (g n) (c n))
      = μ.map (mdsRowSum k (rowDiff μ U coord g c step k) n) := fun n =>
    Measure.map_congr
      (mdsRowSum_degenDiff_ae hU hindep hg hint hdeg hN n).symm
  simp only [hmap]
  exact mds_clt (isMDSArray_degenDiff hU hsq) hσ hvar hlind u

end Array

/-! ### Removing the conditioning on the design

Every `P.map` below is written `@Measure.map Ω E mΩ _ Y P`, so that the σ-algebra arguments are
not synthesized as `𝒟`. -/

namespace CondD

variable {Ω : Type*} {mΩ : MeasurableSpace Ω}
  {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E]

/-- The conditional characteristic function `φ_n(t) := 𝔼[exp(i⟪Y,t⟫) ∣ 𝒟]`. -/
noncomputable def condCharFunD (𝒟 : MeasurableSpace Ω) (P : @Measure Ω mΩ) (Y : Ω → E) (t : E) :
    Ω → ℂ :=
  condExp 𝒟 P fun ω => Complex.exp (⟪Y ω, t⟫ * Complex.I)

omit [MeasurableSpace E] in
/-- `φ_n(t)` is `𝒟`-measurable, hence measurable, being a conditional expectation. -/
theorem stronglyMeasurable_condCharFunD (𝒟 : MeasurableSpace Ω) (h𝒟 : 𝒟 ≤ mΩ)
    (P : @Measure Ω mΩ) (Y : Ω → E) (t : E) :
    StronglyMeasurable[mΩ] (condCharFunD 𝒟 P Y t) :=
  (stronglyMeasurable_condExp (m := 𝒟)).mono h𝒟

omit [MeasurableSpace E] in
/-- `|φ_n(t)| ≤ 1`, by conditional Jensen. -/
theorem norm_condCharFunD_le_one (𝒟 : MeasurableSpace Ω) (h𝒟 : 𝒟 ≤ mΩ) (P : @Measure Ω mΩ)
    [IsFiniteMeasure P] (Y : Ω → E) (t : E) :
    ∀ᵐ ω ∂P, ‖condCharFunD 𝒟 P Y t ω‖ ≤ 1 := by
  have h1 := norm_condExp_le (m := 𝒟) (μ := P)
    (fun ω => Complex.exp ((⟪Y ω, t⟫ : ℝ) * Complex.I))
  have h2 : (fun ω : Ω => ‖Complex.exp ((⟪Y ω, t⟫ : ℝ) * Complex.I)‖) = fun _ : Ω => (1 : ℝ) := by
    funext ω
    exact Complex.norm_exp_ofReal_mul_I _
  rw [h2, condExp_const h𝒟] at h1
  exact h1

/-- `𝔼[φ_n(t)] = 𝔼[exp(i⟪Y_n,t⟫)]`, by the tower property. -/
theorem integral_condCharFunD (𝒟 : MeasurableSpace Ω) (h𝒟 : 𝒟 ≤ mΩ) (P : @Measure Ω mΩ)
    [IsProbabilityMeasure P] [BorelSpace E] [SecondCountableTopology E]
    {Y : Ω → E} (hY : AEMeasurable Y P) (t : E) :
    ∫ ω, condCharFunD 𝒟 P Y t ω ∂P = charFun (@Measure.map Ω E mΩ _ Y P) t := by
  have hcont : Continuous fun x : E => Complex.exp ((⟪x, t⟫ : ℝ) * Complex.I) := by fun_prop
  rw [charFun_apply, integral_map hY hcont.aestronglyMeasurable]
  exact integral_condExp h𝒟

/-- Fix `t`. If every subsequence of `φ_n(t)` has a further subsequence converging almost
surely to `ψ`, then the unconditional characteristic functions converge to `∫ψ`. The limit `ψ`
may be random. -/
theorem tendsto_charFun_of_forall_subseq
    (𝒟 : MeasurableSpace Ω) (h𝒟 : 𝒟 ≤ mΩ) (P : @Measure Ω mΩ) [IsProbabilityMeasure P]
    [BorelSpace E] [SecondCountableTopology E]
    {Y : ℕ → Ω → E} (hY : ∀ n, AEMeasurable (Y n) P) {t : E} {ψ : Ω → ℂ}
    (hsub : ∀ ns : ℕ → ℕ, Tendsto ns atTop atTop → ∃ ms : ℕ → ℕ,
      ∀ᵐ ω ∂P, Tendsto (fun i => condCharFunD 𝒟 P (Y (ns (ms i))) t ω) atTop (𝓝 (ψ ω))) :
    Tendsto (fun n => charFun (@Measure.map Ω E mΩ _ (Y n) P) t) atTop
      (𝓝 (∫ ω, ψ ω ∂P)) := by
  refine tendsto_of_subseq_tendsto fun ns hns => ?_
  obtain ⟨ms, hae⟩ := hsub ns hns
  refine ⟨ms, ?_⟩
  have hrw : (fun i => charFun (@Measure.map Ω E mΩ _ (Y (ns (ms i))) P) t)
      = fun i => ∫ ω, condCharFunD 𝒟 P (Y (ns (ms i))) t ω ∂P := by
    funext i
    exact (integral_condCharFunD 𝒟 h𝒟 P (hY _) t).symm
  rw [hrw]
  exact tendsto_integral_of_dominated_convergence (fun _ => (1 : ℝ))
    (fun i => (stronglyMeasurable_condCharFunD 𝒟 h𝒟 P _ t).aestronglyMeasurable)
    (integrable_const _)
    (fun i => norm_condCharFunD_le_one 𝒟 h𝒟 P _ t) hae

/-- Deconditioning of characteristic functions. The design convergences are stated for a
single sequence `d` into a pseudo-emetric space, so that one subsequence works for all of them;
`hcond` is the conditional convergence along almost every realization of the design. -/
theorem tendsto_charFun_of_deconditioning
    (𝒟 : MeasurableSpace Ω) (h𝒟 : 𝒟 ≤ mΩ) (P : @Measure Ω mΩ) [IsProbabilityMeasure P]
    [BorelSpace E] [SecondCountableTopology E]
    {F : Type*} [PseudoEMetricSpace F] {d : ℕ → Ω → F} {L : Ω → F}
    (hdes : TendstoInMeasure P d atTop L)
    {Y : ℕ → Ω → E} (hY : ∀ n, AEMeasurable (Y n) P) {t : E} {ψ : Ω → ℂ}
    (hcond : ∀ ns : ℕ → ℕ, Tendsto ns atTop atTop →
      (∀ᵐ ω ∂P, Tendsto (fun i => d (ns i) ω) atTop (𝓝 (L ω))) →
      ∀ᵐ ω ∂P, Tendsto (fun i => condCharFunD 𝒟 P (Y (ns i)) t ω) atTop (𝓝 (ψ ω))) :
    Tendsto (fun n => charFun (@Measure.map Ω E mΩ _ (Y n) P) t) atTop
      (𝓝 (∫ ω, ψ ω ∂P)) := by
  refine tendsto_charFun_of_forall_subseq 𝒟 h𝒟 P hY fun ns hns => ?_
  obtain ⟨ms, hms, hae⟩ := (hdes.comp hns).exists_seq_tendsto_ae
  exact ⟨ms, hcond (fun i => ns (ms i)) (hns.comp hms.tendsto_atTop) hae⟩

/-- Deconditioning followed by Lévy's continuity theorem: convergence in distribution to a
random variable `Z` whose law is the limit law. -/
theorem tendstoInDistribution_of_deconditioning
    [FiniteDimensional ℝ E] [BorelSpace E]
    (𝒟 : MeasurableSpace Ω) (h𝒟 : 𝒟 ≤ mΩ) (P : @Measure Ω mΩ) [IsProbabilityMeasure P]
    {F : Type*} [PseudoEMetricSpace F] {d : ℕ → Ω → F} {L : Ω → F}
    (hdes : TendstoInMeasure P d atTop L)
    {Y : ℕ → Ω → E} (hY : ∀ n, AEMeasurable (Y n) P)
    {Ω' : Type*} {mΩ' : MeasurableSpace Ω'} {P' : @Measure Ω' mΩ'} [IsProbabilityMeasure P']
    {Z : Ω' → E} (hZ : AEMeasurable Z P')
    (hcond : ∀ t : E, ∀ ns : ℕ → ℕ, Tendsto ns atTop atTop →
      (∀ᵐ ω ∂P, Tendsto (fun i => d (ns i) ω) atTop (𝓝 (L ω))) →
      ∀ᵐ ω ∂P, Tendsto (fun i => condCharFunD 𝒟 P (Y (ns i)) t ω) atTop
        (𝓝 (charFun (P'.map Z) t))) :
    TendstoInDistribution (m := fun _ : ℕ => mΩ) Y atTop Z (fun _ => P) P' := by
  have : ∀ n : ℕ, IsProbabilityMeasure ((fun _ : ℕ => P) n) := fun _ => by assumption
  refine TendstoInDistribution.of_tendsto_charFun (fun n => hY n) hZ fun t => ?_
  have h := tendsto_charFun_of_deconditioning 𝒟 h𝒟 P hdes hY (t := t)
    (ψ := fun _ => charFun (P'.map Z) t) (hcond t)
  simpa using h

end CondD

namespace CondD

/-! ### The regular conditional law and freezing of the design

The regular conditional law `ℙ_ω` is `ProbabilityTheory.condExpKernel P 𝒟`, which requires
`[StandardBorelSpace Ω]`. The conditional characteristic function is the characteristic function
of `ℙ_ω`, and a `𝒟`-measurable design is `ℙ_ω`-almost surely constant. -/

variable {Ω : Type*} {𝒟 : MeasurableSpace Ω} [mΩ : MeasurableSpace Ω] [StandardBorelSpace Ω]
  {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E]
  [BorelSpace E] [SecondCountableTopology E]

/-- A `𝒟`-measurable variable is almost surely constant under `ℙ_ω`. The proof uses
`compProd_trim_condExpKernel`, which identifies `(P.trim h𝒟) ⊗ₘ condExpKernel P 𝒟` with the image
of `P` under the diagonal map, and `Measure.ae_ae_of_ae_compProd`. -/
theorem ae_ae_eq_condExpKernel (h𝒟 : 𝒟 ≤ mΩ) (P : Measure Ω) [IsFiniteMeasure P]
    {γ : Type*} [MeasurableSpace γ] [MeasurableEq γ] {W : Ω → γ} (hW : Measurable[𝒟] W) :
    ∀ᵐ ω ∂P, ∀ᵐ y ∂(condExpKernel P 𝒟 ω), W y = W ω := by
  classical
  have hdiagmeas : @Measurable Ω (Ω × Ω) mΩ (𝒟.prod mΩ) Function.diag :=
    (measurable_id'' h𝒟).prodMk measurable_id
  have hdiagae : @AEMeasurable Ω (Ω × Ω) (𝒟.prod mΩ) mΩ Function.diag P :=
    @Measurable.aemeasurable Ω (Ω × Ω) mΩ (𝒟.prod mΩ) Function.diag P hdiagmeas
  have h1 : @Measurable (Ω × Ω) γ (𝒟.prod mΩ) _ (fun z => W z.1) :=
    hW.comp (@measurable_fst Ω Ω 𝒟 mΩ)
  have h2 : @Measurable (Ω × Ω) γ (𝒟.prod mΩ) _ (fun z => W z.2) :=
    (hW.mono h𝒟 le_rfl).comp (@measurable_snd Ω Ω 𝒟 mΩ)
  have hS : MeasurableSet[𝒟.prod mΩ] {z : Ω × Ω | W z.2 = W z.1} :=
    measurableSet_eq_fun h2 h1
  have hcp : ∀ᵐ z ∂((P.trim h𝒟) ⊗ₘ condExpKernel P 𝒟), W z.2 = W z.1 := by
    rw [compProd_trim_condExpKernel h𝒟]
    exact (ae_map_iff hdiagae hS).2 (Filter.Eventually.of_forall fun _ => rfl)
  exact ae_of_ae_trim h𝒟 (Measure.ae_ae_of_ae_compProd hcp)

omit [StandardBorelSpace Ω] [SecondCountableTopology E] in
/-- `exp(i⟪Y,t⟫)` is integrable: it has modulus one and `P` is finite. -/
theorem integrable_cexp_inner (P : Measure Ω) [IsFiniteMeasure P] {Y : Ω → E}
    (hY : AEMeasurable Y P) (t : E) :
    Integrable (fun ω => Complex.exp ((⟪Y ω, t⟫ : ℝ) * Complex.I)) P := by
  have hcont : Continuous fun x : E => Complex.exp ((⟪x, t⟫ : ℝ) * Complex.I) := by fun_prop
  refine (integrable_const (1 : ℝ)).mono'
    (hcont.aestronglyMeasurable.comp_aemeasurable hY) ?_
  exact Filter.Eventually.of_forall fun ω => le_of_eq (Complex.norm_exp_ofReal_mul_I _)

omit [SecondCountableTopology E] in
/-- `φ_n(t) = ∫exp(i⟪Y_n,t⟫)dℙ_ω`: the conditional characteristic function is the
characteristic function of the conditional law. -/
theorem condCharFunD_eq_charFun_condExpKernel (h𝒟 : 𝒟 ≤ mΩ)
    (P : Measure Ω) [IsProbabilityMeasure P] {Y : Ω → E} (hY : Measurable Y) (t : E) :
    condCharFunD 𝒟 P Y t
      =ᵐ[P] fun ω => charFun (@Measure.map Ω E mΩ _ Y (condExpKernel P 𝒟 ω)) t := by
  have hcont : Continuous fun x : E => Complex.exp ((⟪x, t⟫ : ℝ) * Complex.I) := by fun_prop
  have hint := integrable_cexp_inner P hY.aemeasurable t
  have h := condExp_ae_eq_integral_condExpKernel (m := 𝒟) h𝒟 hint
  filter_upwards [h] with ω hω
  rw [condCharFunD, hω, charFun_apply,
    integral_map hY.aemeasurable hcont.aestronglyMeasurable]

omit [SecondCountableTopology E] in
/-- Freezing the design. If `D` is `𝒟`-measurable and `G g` is the statistic computed at the
design `g`, then the conditional characteristic function of `ω ↦ G (D ω) ω` is, for almost every
`ω`, the characteristic function of `G (D ω)` under `ℙ_ω`. -/
theorem condCharFunD_eq_charFun_frozen (h𝒟 : 𝒟 ≤ mΩ)
    (P : Measure Ω) [IsProbabilityMeasure P]
    {γ : Type*} [MeasurableSpace γ] [MeasurableEq γ] {D : Ω → γ} (hD : Measurable[𝒟] D)
    {G : γ → Ω → E} (hG : Measurable (Function.uncurry G)) (t : E) :
    condCharFunD 𝒟 P (fun ω => G (D ω) ω) t
      =ᵐ[P] fun ω => charFun (@Measure.map Ω E mΩ _ (G (D ω)) (condExpKernel P 𝒟 ω)) t := by
  have hDm : Measurable D := hD.mono h𝒟 le_rfl
  have hY : Measurable (fun ω => G (D ω) ω) := hG.comp (hDm.prodMk measurable_id)
  filter_upwards [condCharFunD_eq_charFun_condExpKernel h𝒟 P hY t,
    ae_ae_eq_condExpKernel h𝒟 P hD] with ω h1 h2
  have hmap : @Measure.map Ω E mΩ _ (fun y => G (D y) y) (condExpKernel P 𝒟 ω)
      = @Measure.map Ω E mΩ _ (G (D ω)) (condExpKernel P 𝒟 ω) := by
    refine Measure.map_congr ?_
    filter_upwards [h2] with y hy
    rw [hy]
  rw [h1, hmap]

omit [StandardBorelSpace Ω] [SecondCountableTopology E] in
/-- The constant sequence `0` converges to `0` in probability. -/
theorem tendstoInMeasure_trivial (P : Measure Ω) [IsProbabilityMeasure P] :
    TendstoInMeasure P (fun (_ : ℕ) (_ : Ω) => (0 : ℝ)) atTop (fun _ => (0 : ℝ)) := by
  intro ε hε
  have hset : {_x : Ω | ε ≤ edist (0 : ℝ) 0} = (∅ : Set Ω) := by
    ext x
    simp only [Set.mem_ofPred_eq, Set.mem_empty_iff_false, iff_false, edist_self,
      nonpos_iff_eq_zero]
    exact hε.ne'
  simp only [hset, measure_empty]
  exact tendsto_const_nhds

omit [StandardBorelSpace Ω] [SecondCountableTopology E] in
/-- Deconditioning when the conditional convergence holds along the whole sequence, at a
general `E`. -/
theorem tendstoInDistribution_of_tendsto_condCharFunD
    [FiniteDimensional ℝ E]
    (h𝒟 : 𝒟 ≤ mΩ) (P : Measure Ω) [IsProbabilityMeasure P]
    {Y : ℕ → Ω → E} (hY : ∀ n, AEMeasurable (Y n) P)
    {Ω' : Type*} {mΩ' : MeasurableSpace Ω'} {P' : @Measure Ω' mΩ'} [IsProbabilityMeasure P']
    {Z : Ω' → E} (hZ : AEMeasurable Z P')
    (hcond : ∀ t : E, ∀ᵐ ω ∂P, Tendsto (fun n : ℕ => condCharFunD 𝒟 P (Y n) t ω) atTop
      (𝓝 (charFun (P'.map Z) t))) :
    TendstoInDistribution (m := fun _ : ℕ => mΩ) Y atTop Z (fun _ => P) P' := by
  refine tendstoInDistribution_of_deconditioning 𝒟 h𝒟 P (tendstoInMeasure_trivial P) hY hZ ?_
  intro t ns hns _
  filter_upwards [hcond t] with ω hω
  exact hω.comp hns

omit [SecondCountableTopology E] in
/-- Deconditioning with the design frozen, at a general `E`. The estimator is a measurable
function `F n` of the design `D n` and the disturbances (`hY`), the design is `𝒟`-measurable
(`hD`), and the frozen-design limit theorem holds for almost every realization under `ℙ_ω`
(`hfrozen`). -/
theorem tendstoInDistribution_of_design
    [FiniteDimensional ℝ E]
    (h𝒟 : 𝒟 ≤ mΩ) (P : Measure Ω) [IsProbabilityMeasure P]
    [∀ ω : Ω, IsProbabilityMeasure (condExpKernel P 𝒟 ω)]
    {γ : Type*} [MeasurableSpace γ] [MeasurableEq γ]
    {D : ℕ → Ω → γ} (hD : ∀ n, Measurable[𝒟] (D n))
    {F : ℕ → γ → Ω → E} (hF : ∀ n, Measurable (Function.uncurry (F n)))
    {Y : ℕ → Ω → E} (hY : ∀ n ω, Y n ω = F n (D n ω) ω)
    {Ω' : Type*} {mΩ' : MeasurableSpace Ω'} {P' : @Measure Ω' mΩ'} [IsProbabilityMeasure P']
    {Z : Ω' → E} (hZ : AEMeasurable Z P')
    (hfrozen : ∀ᵐ ω ∂P, TendstoInDistribution (m := fun _ : ℕ => mΩ)
      (fun (n : ℕ) (y : Ω) => F n (D n ω) y) atTop Z (fun _ => condExpKernel P 𝒟 ω) P') :
    TendstoInDistribution (m := fun _ : ℕ => mΩ) Y atTop Z (fun _ => P) P' := by
  have heq : ∀ n, Y n = fun ω => F n (D n ω) ω := fun n => funext (hY n)
  have hYm : ∀ n, Measurable (Y n) := by
    intro n
    rw [heq n]
    exact (hF n).comp (((hD n).mono h𝒟 le_rfl).prodMk measurable_id)
  refine tendstoInDistribution_of_tendsto_condCharFunD h𝒟 P
    (fun n => (hYm n).aemeasurable) hZ fun t => ?_
  have hall : ∀ᵐ ω ∂P, ∀ n : ℕ, condCharFunD 𝒟 P (Y n) t ω
      = charFun (@Measure.map Ω E mΩ _ (F n (D n ω)) (condExpKernel P 𝒟 ω)) t := by
    refine ae_all_iff.2 fun n => ?_
    rw [heq n]
    exact condCharFunD_eq_charFun_frozen h𝒟 P (hD n) (hF n) t
  filter_upwards [hall, hfrozen] with ω hω hcl
  exact Tendsto.congr (fun n => (hω n).symm) (hcl.tendsto_charFun t)


/-! #### Example: a nontrivial design σ-field

On `Ω = Bool × Bool` with two fair coins and `𝒟 = σ(first coin)`, the conditional law differs
from the unconditional one. -/

namespace FrozenWitness

/-- A fair coin on `Bool`. -/
noncomputable def coin : Measure Bool :=
  (2 : ℝ≥0∞)⁻¹ • (Measure.dirac true + Measure.dirac false)

theorem coin_singleton (b : Bool) : coin {b} = 2⁻¹ := by
  cases b <;> simp [coin, Measure.smul_apply, Measure.add_apply]

instance : IsProbabilityMeasure coin := by
  constructor
  have h : (Set.univ : Set Bool) = {true} ∪ {false} := by ext b; cases b <;> simp
  rw [h, measure_union (by simp) (measurableSet_singleton _), coin_singleton,
    coin_singleton, ENNReal.inv_two_add_inv_two]

/-- The sample space: a design coin and a disturbance coin. -/
abbrev Omg : Type := Bool × Bool

/-- The law: the two coins independent and fair. -/
noncomputable def Pw : Measure Omg := coin.prod coin

instance : IsProbabilityMeasure Pw := by unfold Pw; infer_instance

example : StandardBorelSpace Omg := inferInstance

set_option warn.classDefReducibility false in
/-- The design σ-field, generated by the first coin. -/
def Dsig : MeasurableSpace Omg := MeasurableSpace.comap Prod.fst inferInstance

theorem Dsig_le : Dsig ≤ (inferInstance : MeasurableSpace Omg) :=
  measurable_fst.comap_le

/-- The design: the first coin, `𝒟`-measurable by construction. -/
theorem meas_fst : Measurable[Dsig] (Prod.fst : Omg → Bool) :=
  measurable_iff_comap_le.2 le_rfl

theorem Pw_fst (b : Bool) : Pw {y : Omg | y.1 = b} = 2⁻¹ := by
  have hset : {y : Omg | y.1 = b} = ({b} : Set Bool) ×ˢ (Set.univ : Set Bool) :=
    Set.ext fun y => by simp [Set.mem_prod, Set.mem_singleton_iff]
  rw [hset, Pw, Measure.prod_prod, coin_singleton, measure_univ, mul_one]

/-- `𝒟` is a proper sub-σ-field: the second coin is not `𝒟`-measurable. -/
theorem Dsig_proper : ∃ B : Set Omg, MeasurableSet B ∧ ¬ MeasurableSet[Dsig] B := by
  refine ⟨{y : Omg | y.2 = true}, measurable_snd (measurableSet_singleton true), ?_⟩
  rintro ⟨t, -, ht⟩
  have h1 : ((true, true) : Omg) ∈ Prod.fst ⁻¹' t := by rw [ht]; rfl
  have h2 : ((true, false) : Omg) ∉ Prod.fst ⁻¹' t := by rw [ht]; simp
  exact h2 h1

/-- The design is `𝒟`-measurable, the freezing theorem applies to it, each value of the
design has probability `1/2`, `𝒟` is strictly smaller than the ambient σ-field, and the
conditional law is not the unconditional law. -/
theorem freeze_witness :
    Measurable[Dsig] (Prod.fst : Omg → Bool)
    ∧ (∀ᵐ ω ∂Pw, ∀ᵐ y ∂(condExpKernel Pw Dsig ω), y.1 = ω.1)
    ∧ Pw {y : Omg | y.1 = true} = 2⁻¹
    ∧ (∃ B : Set Omg, MeasurableSet B ∧ ¬ MeasurableSet[Dsig] B)
    ∧ ¬ (∀ᵐ ω ∂Pw, condExpKernel Pw Dsig ω = Pw) := by
  have hfz := ae_ae_eq_condExpKernel Dsig_le Pw meas_fst
  refine ⟨meas_fst, hfz, Pw_fst true, Dsig_proper, ?_⟩
  intro h
  have hall : ∀ᵐ ω ∂Pw, ∀ᵐ y ∂Pw, y.1 = ω.1 := by
    filter_upwards [h, hfz] with ω hq hf
    rwa [hq] at hf
  obtain ⟨ω₀, hω₀⟩ := hall.exists
  obtain ⟨a, c⟩ := ω₀
  have hz : Pw {y : Omg | ¬ (y.1 = a)} = 0 := ae_iff.1 hω₀
  have hset : {y : Omg | ¬ (y.1 = a)} = {y : Omg | y.1 = !a} := by
    ext y
    obtain ⟨y1, y2⟩ := y
    cases y1 <;> cases a <;> simp
  rw [hset, Pw_fst] at hz
  exact (ENNReal.inv_ne_zero.2 (by simp)) hz

end FrozenWitness
end CondD


/-! ### The truncation limit `L → ∞`

Given `T_n(L)/s_n(L) →ᵈ N(0,1)` for each fixed `L` (`hstep3`), the bound
`|s_n²(L)/n - c'Sc| ≤ δ(L)` (`hstep4`), and an `L²` bound `δ(L)` on the distance between
`n^{-1/2}c'X̃'ν` and `n^{-1/2}T_n(L)` (`hstep5`), the two limits are interchanged. The proof
works with characteristic functions and uses the following bounds.

* `norm_charFun_map_sub_le`: `‖φ_X(u) - φ_Y(u)‖ ≤ |u|·‖X-Y‖_{L²}`;
* `norm_charFun_map_sub_arg_le`: `‖φ_X(u) - φ_X(v)‖ ≤ |u-v|·‖X‖_{L²}`;
* `charFun_gaussianReal_scale`: the `N(0,σ²)` characteristic function at `u` is the `N(0,1)`
  one at `σu`.

`Tr L n` is `T_n(L)/s_n(L)`, `sc L n` is `σ_{n,L} = s_n(L)/√n`, and `sig2 > 0` is `c'Sc > 0`. -/

section Trunc

namespace Trunc


variable {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω}

/-- `(∫|f|)² ≤ ∫f²` on a probability measure. -/
theorem sq_integral_abs_le [IsProbabilityMeasure P] {f : Ω → ℝ} (hf : MemLp f 2 P) :
    (∫ ω, |f ω| ∂P) ^ 2 ≤ ∫ ω, f ω ^ 2 ∂P := by
  have habs : MemLp (fun ω => |f ω|) 2 P := hf.abs
  have h1 : (0:ℝ) ≤ Var[fun ω => |f ω|; P] := variance_nonneg _ _
  rw [variance_eq_sub habs] at h1
  have h2 : P[(fun ω => |f ω|) ^ 2] = ∫ ω, f ω ^ 2 ∂P := by
    refine integral_congr_ae (Filter.Eventually.of_forall fun ω => ?_)
    simp [sq_abs]
  have h3 : P[fun ω => |f ω|] = ∫ ω, |f ω| ∂P := rfl
  rw [h2, h3] at h1
  linarith

theorem integral_abs_le_sqrt [IsProbabilityMeasure P] {f : Ω → ℝ} (hf : MemLp f 2 P) :
    ∫ ω, |f ω| ∂P ≤ Real.sqrt (∫ ω, f ω ^ 2 ∂P) := by
  have hnn : 0 ≤ ∫ ω, |f ω| ∂P :=
    integral_nonneg fun ω => abs_nonneg _
  rw [show (∫ ω, |f ω| ∂P) = |∫ ω, |f ω| ∂P| from (abs_of_nonneg hnn).symm]
  exact Real.abs_le_sqrt (by simpa [sq_abs] using sq_integral_abs_le hf)


/-- `charFun` of a push-forward, written as an integral over the base space. -/
theorem charFun_map_eq_integral [IsProbabilityMeasure P] {f : Ω → ℝ} (hf : AEMeasurable f P)
    (u : ℝ) :
    charFun (P.map f) u = ∫ ω, Complex.exp ((u * f ω : ℝ) * Complex.I) ∂P := by
  rw [charFun_apply_real, integral_map hf (by fun_prop)]
  push_cast
  rfl

/-- `‖e^{ia} - e^{ib}‖ ≤ |a - b|`, pointwise. -/
theorem norm_cexp_sub_cexp_le (a b : ℝ) :
    ‖Complex.exp ((a : ℝ) * Complex.I) - Complex.exp ((b : ℝ) * Complex.I)‖ ≤ |a - b| := by
  have hfac : Complex.exp ((a : ℝ) * Complex.I) - Complex.exp ((b : ℝ) * Complex.I)
      = Complex.exp ((b : ℝ) * Complex.I) * (Complex.exp (Complex.I * ((a - b : ℝ) : ℂ)) - 1) := by
    rw [mul_sub, mul_one, ← Complex.exp_add]
    push_cast
    ring_nf
  rw [hfac, norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul]
  simpa using (Real.norm_exp_I_mul_ofReal_sub_one_le (x := a - b))

/-- The characteristic-function distance is bounded by the `L¹` distance. -/
theorem norm_charFun_map_sub_gen [IsProbabilityMeasure P] {f g : Ω → ℝ}
    (hf : AEMeasurable f P) (hg : AEMeasurable g P) (u v : ℝ)
    (hint : Integrable (fun ω => |u * f ω - v * g ω|) P) :
    ‖charFun (P.map f) u - charFun (P.map g) v‖ ≤ ∫ ω, |u * f ω - v * g ω| ∂P := by
  have hm1 : AEStronglyMeasurable (fun ω => Complex.exp ((u * f ω : ℝ) * Complex.I)) P := by
    have : Continuous fun x : ℝ => Complex.exp ((x : ℝ) * Complex.I) := by fun_prop
    exact this.aestronglyMeasurable.comp_aemeasurable (hf.const_mul u)
  have hm2 : AEStronglyMeasurable (fun ω => Complex.exp ((v * g ω : ℝ) * Complex.I)) P := by
    have : Continuous fun x : ℝ => Complex.exp ((x : ℝ) * Complex.I) := by fun_prop
    exact this.aestronglyMeasurable.comp_aemeasurable (hg.const_mul v)
  have hi1 : Integrable (fun ω => Complex.exp ((u * f ω : ℝ) * Complex.I)) P :=
    (integrable_const (1 : ℝ)).mono' hm1
      (Filter.Eventually.of_forall fun ω => le_of_eq (Complex.norm_exp_ofReal_mul_I _))
  have hi2 : Integrable (fun ω => Complex.exp ((v * g ω : ℝ) * Complex.I)) P :=
    (integrable_const (1 : ℝ)).mono' hm2
      (Filter.Eventually.of_forall fun ω => le_of_eq (Complex.norm_exp_ofReal_mul_I _))
  rw [charFun_map_eq_integral hf u, charFun_map_eq_integral hg v, ← integral_sub hi1 hi2]
  refine (norm_integral_le_integral_norm _).trans ?_
  refine integral_mono ((hi1.sub hi2).norm) hint ?_
  intro ω
  exact norm_cexp_sub_cexp_le _ _


/-- Two statistics close in `L²` have close characteristic functions. -/
theorem norm_charFun_map_sub_le [IsProbabilityMeasure P] {f g : Ω → ℝ}
    (hf : MemLp f 2 P) (hg : MemLp g 2 P) (u : ℝ) :
    ‖charFun (P.map f) u - charFun (P.map g) u‖
      ≤ |u| * Real.sqrt (∫ ω, (f ω - g ω) ^ 2 ∂P) := by
  have hd : MemLp (fun ω => f ω - g ω) 2 P := hf.sub hg
  have habs : Integrable (fun ω => |f ω - g ω|) P := (hd.integrable one_le_two).abs
  have hrw : ∀ ω, |u * f ω - u * g ω| = |u| * |f ω - g ω| := by
    intro ω
    rw [← mul_sub, abs_mul]
  have h1 := norm_charFun_map_sub_gen (P := P) hf.aemeasurable hg.aemeasurable u u
    (by simpa only [hrw] using habs.const_mul |u|)
  refine h1.trans ?_
  rw [show (∫ ω, |u * f ω - u * g ω| ∂P) = ∫ ω, |u| * |f ω - g ω| ∂P from
      integral_congr_ae (Filter.Eventually.of_forall hrw), integral_const_mul]
  exact mul_le_mul_of_nonneg_left (integral_abs_le_sqrt hd) (abs_nonneg u)

/-- The characteristic function of an `L²` statistic is Lipschitz in its argument, with
constant `√(𝔼X²)`. -/
theorem norm_charFun_map_sub_arg_le [IsProbabilityMeasure P] {f : Ω → ℝ}
    (hf : MemLp f 2 P) (u v : ℝ) :
    ‖charFun (P.map f) u - charFun (P.map f) v‖
      ≤ |u - v| * Real.sqrt (∫ ω, f ω ^ 2 ∂P) := by
  have habs : Integrable (fun ω => |f ω|) P := (hf.integrable one_le_two).abs
  have hrw : ∀ ω, |u * f ω - v * f ω| = |u - v| * |f ω| := by
    intro ω
    rw [← sub_mul, abs_mul]
  have h1 := norm_charFun_map_sub_gen (P := P) hf.aemeasurable hf.aemeasurable u v
    (by simpa only [hrw] using habs.const_mul |u - v|)
  refine h1.trans ?_
  rw [show (∫ ω, |u * f ω - v * f ω| ∂P) = ∫ ω, |u - v| * |f ω| ∂P from
      integral_congr_ae (Filter.Eventually.of_forall hrw), integral_const_mul]
  exact mul_le_mul_of_nonneg_left (integral_abs_le_sqrt hf) (abs_nonneg _)


/-- The Gaussian characteristic function at two scalings. -/
theorem charFun_gaussianReal_scale {s : ℝ} (hs : 0 ≤ s) (u : ℝ) :
    charFun (gaussianReal 0 (Real.toNNReal s)) u
      = charFun (gaussianReal 0 1) (Real.sqrt s * u) := by
  have h1 : ((Real.toNNReal s : ℝ≥0) : ℝ) = s := Real.coe_toNNReal _ hs
  have h3 : ((Real.sqrt s : ℝ) : ℂ) ^ 2 = (s : ℂ) := by
    rw [← Complex.ofReal_pow, Real.sq_sqrt hs]
  rw [charFun_gaussianReal, charFun_gaussianReal]
  congr 1
  push_cast [h1]
  ring_nf
  rw [h3]

/-- The truncation limit, on characteristic functions. -/
theorem tendsto_charFun_of_l2_approx [IsProbabilityMeasure P]
    {xi : ℕ → Ω → ℝ} {Tr : ℕ → ℕ → Ω → ℝ} {sc : ℕ → ℕ → ℝ} {del : ℕ → ℝ} {sig2 : ℝ}
    (hsig2 : 0 < sig2)
    (hxi : ∀ n, MemLp (xi n) 2 P)
    (hTr : ∀ L n, MemLp (Tr L n) 2 P)
    (hsc : ∀ L n, 0 ≤ sc L n)
    (hdel : Tendsto del atTop (𝓝 0))
    (hsecond : ∀ L n, ∫ ω, Tr L n ω ^ 2 ∂P ≤ 1)
    (hstep3 : ∀ L u, Tendsto (fun n => charFun (P.map (Tr L n)) u) atTop
      (𝓝 (charFun (gaussianReal 0 1) u)))
    (hstep4 : ∀ L, ∀ᶠ n in atTop, |sc L n ^ 2 - sig2| ≤ del L)
    (hstep5 : ∀ L, ∀ᶠ n in atTop, ∫ ω, (xi n ω - sc L n * Tr L n ω) ^ 2 ∂P ≤ del L)
    (u : ℝ) :
    Tendsto (fun n => charFun (P.map (xi n)) u) atTop
      (𝓝 (charFun (gaussianReal 0 (Real.toNNReal sig2)) u)) := by
  classical
  set sg : ℝ := Real.sqrt sig2 with hsgdef
  have hsgpos : 0 < sg := Real.sqrt_pos.2 hsig2
  have hsgsq : sg ^ 2 = sig2 := Real.sq_sqrt hsig2.le
  rw [charFun_gaussianReal_scale hsig2.le u, Metric.tendsto_atTop]
  intro eps heps
  have hdelnn : ∀ L, 0 ≤ del L := by
    intro L
    obtain ⟨n, hn⟩ := (hstep4 L).exists
    exact le_trans (abs_nonneg _) hn
  have hbig : Tendsto (fun L => |u| * Real.sqrt (del L) + |u| * (del L / sg)) atTop (𝓝 0) := by
    have h1 : Tendsto (fun L => Real.sqrt (del L)) atTop (𝓝 0) := by
      have h := (Real.continuous_sqrt.tendsto 0).comp hdel
      simp only [Real.sqrt_zero, Function.comp_def] at h
      exact h
    have h2 : Tendsto (fun L => del L / sg) atTop (𝓝 0) := by
      simpa using hdel.div_const sg
    simpa using (h1.const_mul |u|).add (h2.const_mul |u|)
  obtain ⟨L, hL⟩ :=
    (hbig.eventually_lt_const (show (0 : ℝ) < eps / 2 by linarith)).exists
  have h3 : ∀ᶠ n in atTop,
      ‖charFun (P.map (Tr L n)) (sg * u) - charFun (gaussianReal 0 1) (sg * u)‖ < eps / 2 := by
    obtain ⟨N, hN⟩ := Metric.tendsto_atTop.1 (hstep3 L (sg * u)) (eps / 2) (by linarith)
    filter_upwards [eventually_ge_atTop N] with n hn
    simpa [dist_eq_norm] using hN n hn
  refine eventually_atTop.1 ?_
  filter_upwards [hstep4 L, hstep5 L, h3] with n h4 h5 h3n
  have hscL2 : MemLp (fun ω => sc L n * Tr L n ω) 2 P := (hTr L n).const_mul _
  have e1 : ‖charFun (P.map (xi n)) u - charFun (P.map fun ω => sc L n * Tr L n ω) u‖
      ≤ |u| * Real.sqrt (del L) := by
    refine (norm_charFun_map_sub_le (hxi n) hscL2 u).trans ?_
    exact mul_le_mul_of_nonneg_left (Real.sqrt_le_sqrt h5) (abs_nonneg u)
  have emid : charFun (P.map fun ω => sc L n * Tr L n ω) u
      = charFun (P.map (Tr L n)) (sc L n * u) :=
    charFun_map_mul_comp (hTr L n).aemeasurable (sc L n) u
  have hscsig : |sc L n - sg| ≤ del L / sg := by
    have hA : 0 ≤ sc L n := hsc L n
    have hx : |sc L n - sg| * sg ≤ |sc L n - sg| * (sc L n + sg) :=
      mul_le_mul_of_nonneg_left (by linarith) (abs_nonneg _)
    have hy : |sc L n - sg| * (sc L n + sg) = |sc L n ^ 2 - sig2| := by
      rw [← abs_of_nonneg (show (0 : ℝ) ≤ sc L n + sg by linarith), ← abs_mul]
      congr 1
      rw [← hsgsq]
      ring
    rw [le_div_iff₀ hsgpos]
    rw [hy] at hx
    exact hx.trans h4
  have e2 : ‖charFun (P.map (Tr L n)) (sc L n * u) - charFun (P.map (Tr L n)) (sg * u)‖
      ≤ |u| * (del L / sg) := by
    refine (norm_charFun_map_sub_arg_le (hTr L n) _ _).trans ?_
    have hs1 : Real.sqrt (∫ ω, Tr L n ω ^ 2 ∂P) ≤ 1 := by
      rw [show (1 : ℝ) = Real.sqrt 1 from Real.sqrt_one.symm]
      exact Real.sqrt_le_sqrt (hsecond L n)
    have habs : |sc L n * u - sg * u| = |sc L n - sg| * |u| := by
      rw [← sub_mul, abs_mul]
    rw [habs]
    calc |sc L n - sg| * |u| * Real.sqrt (∫ ω, Tr L n ω ^ 2 ∂P)
        ≤ |sc L n - sg| * |u| * 1 := mul_le_mul_of_nonneg_left hs1 (by positivity)
      _ = |u| * |sc L n - sg| := by ring
      _ ≤ |u| * (del L / sg) := mul_le_mul_of_nonneg_left hscsig (abs_nonneg u)
  have hsplit : charFun (P.map (xi n)) u - charFun (gaussianReal 0 1) (sg * u)
      = (charFun (P.map (xi n)) u - charFun (P.map fun ω => sc L n * Tr L n ω) u)
        + (charFun (P.map (Tr L n)) (sc L n * u) - charFun (P.map (Tr L n)) (sg * u))
        + (charFun (P.map (Tr L n)) (sg * u) - charFun (gaussianReal 0 1) (sg * u)) := by
    rw [emid]; ring
  rw [dist_eq_norm, hsplit]
  set Aq := charFun (P.map (xi n)) u - charFun (P.map fun ω => sc L n * Tr L n ω) u with hAq
  set Bq := charFun (P.map (Tr L n)) (sc L n * u) - charFun (P.map (Tr L n)) (sg * u) with hBq
  set Cq := charFun (P.map (Tr L n)) (sg * u) - charFun (gaussianReal 0 1) (sg * u) with hCq
  have htri : ‖Aq + Bq + Cq‖ ≤ ‖Aq‖ + ‖Bq‖ + ‖Cq‖ := by
    refine (norm_add_le (Aq + Bq) Cq).trans ?_
    have h := norm_add_le Aq Bq
    linarith
  linarith [htri, e1, e2, h3n, hL]



/-- The truncation limit, as convergence in distribution. -/
theorem tendstoInDistribution_of_l2_approx [IsProbabilityMeasure P]
    {xi : ℕ → Ω → ℝ} {Tr : ℕ → ℕ → Ω → ℝ} {sc : ℕ → ℕ → ℝ} {del : ℕ → ℝ} {sig2 : ℝ}
    (hsig2 : 0 < sig2)
    (hxi : ∀ n, MemLp (xi n) 2 P)
    (hTr : ∀ L n, MemLp (Tr L n) 2 P)
    (hsc : ∀ L n, 0 ≤ sc L n)
    (hdel : Tendsto del atTop (𝓝 0))
    (hsecond : ∀ L n, ∫ ω, Tr L n ω ^ 2 ∂P ≤ 1)
    (hstep3 : ∀ L u, Tendsto (fun n => charFun (P.map (Tr L n)) u) atTop
      (𝓝 (charFun (gaussianReal 0 1) u)))
    (hstep4 : ∀ L, ∀ᶠ n in atTop, |sc L n ^ 2 - sig2| ≤ del L)
    (hstep5 : ∀ L, ∀ᶠ n in atTop, ∫ ω, (xi n ω - sc L n * Tr L n ω) ^ 2 ∂P ≤ del L) :
    TendstoInDistribution xi atTop (id : ℝ → ℝ) (fun _ => P)
      (gaussianReal 0 (Real.toNNReal sig2)) := by
  refine TendstoInDistribution.of_tendsto_charFun (fun n => (hxi n).aemeasurable)
    aemeasurable_id fun u => ?_
  rw [Measure.map_id]
  exact tendsto_charFun_of_l2_approx hsig2 hxi hTr hsc hdel hsecond hstep3 hstep4 hstep5 u

/-! #### Example -/

namespace ApproxWitness

/-- A standard Gaussian on `ℝ`, so that the truncated statistic is standard normal at every
`n`. -/
noncomputable def Pg : Measure ℝ := gaussianReal 0 1

instance : IsProbabilityMeasure Pg := by unfold Pg; infer_instance

theorem integral_sq_Pg : ∫ ω, ω ^ 2 ∂Pg = 1 := by
  have hm : MemLp (id : ℝ → ℝ) 2 (gaussianReal (0 : ℝ) 1) := memLp_id_gaussianReal 2
  have h := variance_eq_sub (μ := gaussianReal (0 : ℝ) 1) hm
  rw [variance_id_gaussianReal] at h
  simp only [Pi.pow_apply, id_eq, integral_id_gaussianReal] at h
  show ∫ ω, ω ^ 2 ∂(gaussianReal (0 : ℝ) 1) = 1
  norm_num at h
  linarith

/-- `𝔼[(cX)²] = c²` on the standard Gaussian. -/
theorem integral_const_mul_sq (c : ℝ) : ∫ ω, (c * ω) ^ 2 ∂Pg = c ^ 2 := by
  have h : ∀ ω : ℝ, (c * ω) ^ 2 = c ^ 2 * ω ^ 2 := fun ω => by ring
  rw [integral_congr_ae (Filter.Eventually.of_forall h), integral_const_mul, integral_sq_Pg,
    mul_one]

/-- The truncated statistic: standard normal at every level and every `n`. -/
noncomputable def wTr (_L _n : ℕ) : ℝ → ℝ := id

/-- The scale `σ_{n,L} = s_n(L)/√n`, strictly below its limit `1` at every level. -/
noncomputable def wsc (L : ℕ) (_n : ℕ) : ℝ := 1 - 1 / ((L : ℝ) + 1)

/-- The untruncated statistic, varying with `n`. -/
noncomputable def wxi (n : ℕ) : ℝ → ℝ := fun ω => (1 + 1 / ((n : ℝ) + 1)) * ω

/-- The level-`L` error bound `δ(L)`, strictly positive at every level. -/
noncomputable def wdel (L : ℕ) : ℝ := 4 / ((L : ℝ) + 1)

theorem wdel_pos (L : ℕ) : 0 < wdel L := by
  have : (0 : ℝ) < (L : ℝ) + 1 := by positivity
  unfold wdel
  positivity

theorem inv_le_one (L : ℕ) : 1 / ((L : ℝ) + 1) ≤ 1 := by
  rw [div_le_one (by positivity)]
  have : (0 : ℝ) ≤ (L : ℝ) := Nat.cast_nonneg L
  linarith

theorem inv_pos' (L : ℕ) : 0 < 1 / ((L : ℝ) + 1) := by positivity

/-- `tendsto_charFun_of_l2_approx` on this model, with `δ(L) > 0` at every level and a nonzero
`L²` gap at every `n`. -/
theorem approx_witness (u : ℝ) :
    Tendsto (fun n : ℕ => charFun (Pg.map (wxi n)) u) atTop
        (𝓝 (charFun (gaussianReal 0 (Real.toNNReal (1 : ℝ))) u))
      ∧ (∀ L : ℕ, 0 < wdel L)
      ∧ (∀ L n : ℕ, ∫ ω, (wxi n ω - wsc L n * wTr L n ω) ^ 2 ∂Pg ≠ 0) := by
  have hTrL2 : ∀ L n : ℕ, MemLp (wTr L n) 2 Pg := fun _ _ => memLp_id_gaussianReal 2
  have hgap : ∀ L n : ℕ, ∫ ω, (wxi n ω - wsc L n * wTr L n ω) ^ 2 ∂Pg
      = (1 / ((n : ℝ) + 1) + 1 / ((L : ℝ) + 1)) ^ 2 := by
    intro L n
    have h : ∀ ω : ℝ, wxi n ω - wsc L n * wTr L n ω
        = (1 / ((n : ℝ) + 1) + 1 / ((L : ℝ) + 1)) * ω := by
      intro ω
      unfold wxi wsc wTr
      simp only [id_eq]
      ring
    rw [integral_congr_ae (Filter.Eventually.of_forall fun ω => by rw [h ω]),
      integral_const_mul_sq]
  refine ⟨?_, wdel_pos, ?_⟩
  · refine tendsto_charFun_of_l2_approx (P := Pg) (Tr := wTr) (sc := wsc) (del := wdel)
      (sig2 := 1) one_pos ?_ hTrL2 ?_ ?_ ?_ ?_ ?_ ?_ u
    · intro n
      have h : MemLp (id : ℝ → ℝ) 2 Pg := memLp_id_gaussianReal 2
      exact h.const_mul (1 + 1 / ((n : ℝ) + 1))
    · intro L n
      have h1 := inv_le_one L
      unfold wsc
      linarith
    · have h : Tendsto (fun L : ℕ => 1 / ((L : ℝ) + 1)) atTop (𝓝 0) :=
        tendsto_one_div_add_atTop_nhds_zero_nat
      have h4 := h.const_mul (4 : ℝ)
      rw [mul_zero] at h4
      refine h4.congr fun L => ?_
      unfold wdel
      ring
    · intro L n
      unfold wTr
      simp only [id_eq]
      exact le_of_eq integral_sq_Pg
    · intro L v
      unfold wTr
      rw [Measure.map_id]
      exact tendsto_const_nhds
    · intro L
      filter_upwards with n
      have hx : (0 : ℝ) < 1 / ((L : ℝ) + 1) := inv_pos' L
      have hx1 : 1 / ((L : ℝ) + 1) ≤ 1 := inv_le_one L
      have hval : wsc L n ^ 2 - 1
          = (1 / ((L : ℝ) + 1)) ^ 2 - 2 * (1 / ((L : ℝ) + 1)) := by unfold wsc; ring
      have hd : wdel L = 4 * (1 / ((L : ℝ) + 1)) := by unfold wdel; ring
      rw [hval, hd, abs_le]
      constructor <;> nlinarith [hx, hx1]
    · intro L
      filter_upwards [eventually_ge_atTop L] with n hn
      have hy : 1 / ((n : ℝ) + 1) ≤ 1 / ((L : ℝ) + 1) := by
        apply one_div_le_one_div_of_le (by positivity)
        exact_mod_cast Nat.add_le_add_right hn 1
      have hx : (0 : ℝ) < 1 / ((L : ℝ) + 1) := inv_pos' L
      have hx1 : 1 / ((L : ℝ) + 1) ≤ 1 := inv_le_one L
      have hy0 : (0 : ℝ) < 1 / ((n : ℝ) + 1) := inv_pos' n
      rw [hgap L n]
      have hrw : wdel L = 4 * (1 / ((L : ℝ) + 1)) := by unfold wdel; ring
      rw [hrw]
      have h1 : 1 / ((n : ℝ) + 1) + 1 / ((L : ℝ) + 1) ≤ 2 * (1 / ((L : ℝ) + 1)) := by linarith
      have h2 : (0 : ℝ) ≤ 1 / ((n : ℝ) + 1) + 1 / ((L : ℝ) + 1) := by linarith
      nlinarith [h1, h2, hx, hx1]
  · intro L n
    rw [hgap L n]
    have hx : (0 : ℝ) < 1 / ((L : ℝ) + 1) := inv_pos' L
    have hy0 : (0 : ℝ) < 1 / ((n : ℝ) + 1) := inv_pos' n
    positivity

end ApproxWitness


end Trunc

end Trunc

/-! ### Orthogonality of completely degenerate terms

Two completely degenerate terms are uncorrelated when one depends on a latent variable on which
the other does not. The proof conditions on all latent variables except that one and applies
complete degeneracy and the tower property. The hypothesis is stated as a support condition,
`coord' s k ∉ tupleSupport coord t`. -/

namespace Orth


variable {Ω : Type*} {m0 : MeasurableSpace Ω} {μ : Measure Ω}

section
variable {V ι T : Type*} [Fintype ι] [IsProbabilityMeasure μ]
  {U : V → Ω → ℝ} {coord : T → ι → V} {g : (ι → ℝ) → ℝ}

omit [Fintype ι] in
/-- A term whose support is not contained in `S` conditions to zero on `latentSigma U S`. -/
theorem condExp_degenTerm_eq_zero_of_set
    (hU : ∀ v, Measurable (U v)) (hindep : iIndepFun U μ)
    (hg : Measurable g) {t : T} (hint : Integrable (degenTerm U coord g t) μ)
    (hdeg : ∀ e' : Set ι, e' ≠ Set.univ →
      μ[degenTerm U coord g t | latentSigma U (coord t '' e')] =ᵐ[μ] 0)
    {S : Set V} (hS : (coord t) ⁻¹' S ≠ Set.univ) :
    μ[degenTerm U coord g t | latentSigma U S] =ᵐ[μ] 0 := by
  have hsplit : latentSigma U S =
      latentSigma U (S ∩ tupleSupport coord t) ⊔ latentSigma U (S \ tupleSupport coord t) := by
    rw [← latentSigma_union]
    exact congrArg _ (Set.inter_union_sdiff _ _).symm
  have h0 : μ[degenTerm U coord g t | latentSigma U (S ∩ tupleSupport coord t)] =ᵐ[μ] 0 := by
    have himg : coord t '' ((coord t) ⁻¹' S) = S ∩ tupleSupport coord t :=
      Set.image_preimage_eq_inter_range
    rw [← himg]
    exact hdeg _ hS
  rw [hsplit]
  exact condExp_sup_eq_zero (𝒞 := latentSigma U (tupleSupport coord t))
    (latentSigma_mono U Set.inter_subset_right) (latentSigma_le hU _) (latentSigma_le hU _)
    (latentSigma_indep hU hindep (Set.disjoint_left.2 fun v hv hv' => hv'.2 hv))
    (stronglyMeasurable_degenTerm U coord hg t le_rfl) hint h0

omit [Fintype ι] in
/-- A variable measurable with respect to the latent variables in `S` is uncorrelated with a
completely degenerate term that depends on a latent variable outside `S`. -/
theorem integral_mul_degenTerm_eq_zero
    (hU : ∀ v, Measurable (U v)) (hindep : iIndepFun U μ)
    (hg : Measurable g) {t : T}
    (hdeg : ∀ e' : Set ι, e' ≠ Set.univ →
      μ[degenTerm U coord g t | latentSigma U (coord t '' e')] =ᵐ[μ] 0)
    (hint : Integrable (degenTerm U coord g t) μ)
    {X : Ω → ℝ} {S : Set V} (hXm : StronglyMeasurable[latentSigma U S] X)
    (hS : (coord t) ⁻¹' S ≠ Set.univ)
    (hintXY : Integrable (fun ω => X ω * degenTerm U coord g t ω) μ) :
    ∫ ω, X ω * degenTerm U coord g t ω ∂μ = 0 := by
  have hle : latentSigma U S ≤ m0 := latentSigma_le hU S
  have hsf : SigmaFinite (μ.trim hle) := by
    have : IsFiniteMeasure (μ.trim hle) := isFiniteMeasure_trim hle
    infer_instance
  have h1 : μ[fun ω => X ω * degenTerm U coord g t ω | latentSigma U S]
      =ᵐ[μ] fun ω => X ω * (μ[degenTerm U coord g t | latentSigma U S]) ω :=
    condExp_mul_of_stronglyMeasurable_left hXm hintXY hint
  have h2 : μ[fun ω => X ω * degenTerm U coord g t ω | latentSigma U S] =ᵐ[μ] 0 := by
    refine h1.trans ?_
    filter_upwards [condExp_degenTerm_eq_zero_of_set hU hindep hg hint hdeg hS] with ω hω
    simp only [hω, Pi.zero_apply, mul_zero]
  calc ∫ ω, X ω * degenTerm U coord g t ω ∂μ
      = ∫ ω, (μ[fun ω => X ω * degenTerm U coord g t ω | latentSigma U S]) ω ∂μ :=
        (integral_condExp hle).symm
    _ = 0 := by rw [integral_congr_ae h2]; simp

omit [Fintype ι] in
/-- If the term at `s` depends on a latent variable that does not occur in `t`, the two
completely degenerate terms are uncorrelated. -/
theorem integral_degenTerm_mul_eq_zero {ι' T' : Type*} [Fintype ι']
    {coord' : T' → ι' → V} {g' : (ι' → ℝ) → ℝ}
    (hU : ∀ v, Measurable (U v)) (hindep : iIndepFun U μ)
    (hg : Measurable g) (hg' : Measurable g') {t : T} {s : T'}
    (hdeg' : ∀ e' : Set ι', e' ≠ Set.univ →
      μ[degenTerm U coord' g' s | latentSigma U (coord' s '' e')] =ᵐ[μ] 0)
    (h2 : MemLp (degenTerm U coord g t) 2 μ) (h2' : MemLp (degenTerm U coord' g' s) 2 μ)
    {k : ι'} (hk : coord' s k ∉ tupleSupport coord t) :
    ∫ ω, degenTerm U coord g t ω * degenTerm U coord' g' s ω ∂μ = 0 := by
  refine integral_mul_degenTerm_eq_zero (S := {coord' s k}ᶜ) hU hindep hg' hdeg'
    (h2'.integrable one_le_two) (stronglyMeasurable_degenTerm U coord hg t ?_) ?_
    (h2.integrable_mul h2')
  · intro v hv
    exact fun hv' => hk (hv' ▸ hv)
  · intro hcon
    have hmem : k ∈ (coord' s) ⁻¹' ({coord' s k}ᶜ) := by rw [hcon]; trivial
    exact hmem rfl

/-- Orthogonality when, for some coordinate `k` of one of the two tuples, the tuples do not
share the latent variable at `k`. -/
theorem integral_degenTerm_mul_eq_zero_of_or {ι' T' : Type*} [Fintype ι']
    {coord' : T' → ι' → V} {g' : (ι' → ℝ) → ℝ}
    (hU : ∀ v, Measurable (U v)) (hindep : iIndepFun U μ)
    (hg : Measurable g) (hg' : Measurable g') {t : T} {s : T'}
    (hdeg : ∀ e' : Set ι, e' ≠ Set.univ →
      μ[degenTerm U coord g t | latentSigma U (coord t '' e')] =ᵐ[μ] 0)
    (hdeg' : ∀ e' : Set ι', e' ≠ Set.univ →
      μ[degenTerm U coord' g' s | latentSigma U (coord' s '' e')] =ᵐ[μ] 0)
    (h2 : MemLp (degenTerm U coord g t) 2 μ) (h2' : MemLp (degenTerm U coord' g' s) 2 μ)
    (hk : (∃ k : ι', coord' s k ∉ tupleSupport coord t) ∨
          (∃ k : ι, coord t k ∉ tupleSupport coord' s)) :
    ∫ ω, degenTerm U coord g t ω * degenTerm U coord' g' s ω ∂μ = 0 := by
  rcases hk with ⟨k, hk⟩ | ⟨k, hk⟩
  · exact integral_degenTerm_mul_eq_zero hU hindep hg hg' hdeg' h2 h2' hk
  · have h := integral_degenTerm_mul_eq_zero hU hindep hg' hg hdeg h2' h2 hk
    rw [← h]
    exact integral_congr_ae (Filter.Eventually.of_forall fun ω => mul_comm _ _)

end

end Orth

/-! ## The variance of a linear combination of uncorrelated centred variables -/

section Uncorrelated

variable {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]

/-- `Var(∑_a w_aY_a) = ∑_a w_a²𝔼[Y_a²]` for pairwise uncorrelated, centred, square integrable
`Y_a`. -/
theorem variance_sum_of_uncorrelated {A : Type*} [Fintype A] (Y : A → Ω → ℝ) (wt : A → ℝ)
    (hL2 : ∀ a, MemLp (Y a) 2 P) (hmean : ∀ a, ∫ ω, Y a ω ∂P = 0)
    (horth : ∀ a b, a ≠ b → ∫ ω, Y a ω * Y b ω ∂P = 0) :
    Var[fun ω => ∑ a, wt a * Y a ω; P] = ∑ a, wt a ^ 2 * ∫ ω, Y a ω ^ 2 ∂P := by
  classical
  have hWL2 : MemLp (fun ω => ∑ a, wt a * Y a ω) 2 P :=
    memLp_finsetSum (Finset.univ : Finset A) (fun a _ => (hL2 a).const_mul (wt a))
  have hWmean : ∫ ω, (∑ a, wt a * Y a ω) ∂P = 0 := by
    rw [integral_finsetSum _ (fun a _ => ((hL2 a).integrable one_le_two).const_mul _)]
    exact Finset.sum_eq_zero fun a _ => by rw [integral_const_mul, hmean a, mul_zero]
  rw [variance_of_integral_eq_zero hWL2.aemeasurable hWmean]
  have hexp : ∀ ω, (∑ a, wt a * Y a ω) ^ 2
      = ∑ a, ∑ b, (wt a * Y a ω) * (wt b * Y b ω) := by
    intro ω
    rw [sq, Finset.sum_mul_sum]
  rw [integral_congr_ae (Filter.Eventually.of_forall hexp)]
  have hint : ∀ a b : A, Integrable (fun ω => (wt a * Y a ω) * (wt b * Y b ω)) P := by
    intro a b
    have := ((hL2 a).const_mul (wt a)).integrable_mul ((hL2 b).const_mul (wt b))
    exact this
  rw [integral_finsetSum _ (fun a _ => integrable_finsetSum _ (fun b _ => hint a b))]
  refine Finset.sum_congr rfl fun a _ => ?_
  rw [integral_finsetSum _ (fun b _ => hint a b)]
  rw [Finset.sum_eq_single a]
  · have h : (fun ω => (wt a * Y a ω) * (wt a * Y a ω)) = fun ω => wt a ^ 2 * (Y a ω ^ 2) := by
      funext ω; ring
    rw [h, integral_const_mul]
  · intro b _ hba
    have h : (fun ω => (wt a * Y a ω) * (wt b * Y b ω))
        = fun ω => (wt a * wt b) * (Y a ω * Y b ω) := by funext ω; ring
    rw [h, integral_const_mul, horth a b (Ne.symm hba), mul_zero]
  · intro h; exact absurd (Finset.mem_univ a) h

end Uncorrelated

/-! ### The conditional variance condition from Lemma SM.C.3

`tendstoInProb_condVar_of_concentration` derives `V_n²/s_n²(L) →ᵖ 1` from clauses (a) and (b) of
Lemma SM.C.3, a rate estimate and Chebyshev's inequality, given the identification `halg` of the
conditional-variance process with the quadratic form `∑_{γ,γ'}λ_γλ_{γ'}X_{γγ'}`.
`tendsto_charFun_degenSum_of_concentration` is the martingale CLT with `hvar` obtained in this way. -/

namespace Var

/-! #### One step of the conditional-variance algebra

At the step revealing a new latent variable `W`, independent of the past `𝒢`, a difference of
the form `∑_γ λ_γψ_{ρ(γ)}(W)A_γ` with `𝒢`-measurable `A_γ` has conditional second moment
`∑_{γ,γ'} λ_γλ_{γ'}A_γA_{γ'}𝟙{ρ(γ) = ρ(γ')}`, by orthonormality of `{ψ_r}`. The bound `hbd` is
used only for integrability. -/

section Step


variable {Ω : Type*} {m0 : MeasurableSpace Ω} {μ : Measure Ω}

/-- The conditional second moment at one step, with the orthonormality indicator. -/
theorem condExp_sq_step [IsProbabilityMeasure μ]
    {𝒢 : MeasurableSpace Ω} (h𝒢 : 𝒢 ≤ m0)
    {Γ : Type*} [Fintype Γ] {R : Type*} [DecidableEq R]
    {W : Ω → ℝ} (hW : Measurable[m0] W) {ψ : R → ℝ → ℝ} {B₀ : ℝ}
    (hψ : ∀ r, Measurable (ψ r)) (hbd : ∀ r x, |ψ r x| ≤ B₀)
    (hortho : ∀ r r', ∫ ω, ψ r (W ω) * ψ r' (W ω) ∂μ = if r = r' then (1:ℝ) else 0)
    (hindep : Indep (MeasurableSpace.comap W (inferInstance : MeasurableSpace ℝ)) 𝒢 μ)
    (lam : Γ → ℝ) (ρ : Γ → R) (A : Γ → Ω → ℝ)
    (hA : ∀ γ, StronglyMeasurable[𝒢] (A γ))
    (hAint : ∀ γ γ', Integrable (fun ω => A γ ω * A γ' ω) μ) :
    μ[fun ω => (∑ γ, lam γ * (ψ (ρ γ) (W ω) * A γ ω)) ^ 2 | 𝒢]
      =ᵐ[μ] fun ω => ∑ γ, ∑ γ',
        lam γ * lam γ' * (if ρ γ = ρ γ' then (1:ℝ) else 0) * (A γ ω * A γ' ω) := by
  classical
  set m₁ : MeasurableSpace Ω := MeasurableSpace.comap W (inferInstance : MeasurableSpace ℝ)
    with hm₁
  have hm₁le : m₁ ≤ m0 := by rw [hm₁]; exact (measurable_iff_comap_le (f := W)).mp hW
  have hWm₁ : Measurable[m₁] W := by
    rw [hm₁]; exact (measurable_iff_comap_le (f := W)).mpr le_rfl
  have hPsim₁ : ∀ γ γ' : Γ, StronglyMeasurable[m₁] (fun ω => ψ (ρ γ) (W ω) * ψ (ρ γ') (W ω)) :=
    fun γ γ' => (((hψ (ρ γ)).comp hWm₁).mul ((hψ (ρ γ')).comp hWm₁)).stronglyMeasurable
  have hPsimeas : ∀ γ γ' : Γ, Measurable[m0] (fun ω => ψ (ρ γ) (W ω) * ψ (ρ γ') (W ω)) :=
    fun γ γ' => ((hψ (ρ γ)).comp hW).mul ((hψ (ρ γ')).comp hW)
  have hPsibd : ∀ (γ γ' : Γ) (ω : Ω), ‖ψ (ρ γ) (W ω) * ψ (ρ γ') (W ω)‖ ≤ B₀ * B₀ := by
    intro γ γ' ω
    have h1 := hbd (ρ γ) (W ω)
    have h2 := hbd (ρ γ') (W ω)
    have hB : (0:ℝ) ≤ B₀ := le_trans (abs_nonneg _) h1
    rw [Real.norm_eq_abs, abs_mul]
    exact mul_le_mul h1 h2 (abs_nonneg _) hB
  have hPsiint : ∀ γ γ' : Γ, Integrable (fun ω => ψ (ρ γ) (W ω) * ψ (ρ γ') (W ω)) μ := by
    intro γ γ'
    refine Integrable.mono' (g := fun _ => B₀ * B₀) (integrable_const _)
      (hPsimeas γ γ').aestronglyMeasurable (Eventually.of_forall fun ω => hPsibd γ γ' ω)
  -- the conditional expectation of the basis pair is the orthonormality indicator
  have hkey : ∀ γ γ' : Γ, μ[fun ω => ψ (ρ γ) (W ω) * ψ (ρ γ') (W ω) | 𝒢]
      =ᵐ[μ] fun _ => (if ρ γ = ρ γ' then (1:ℝ) else 0) := by
    intro γ γ'
    have h := condExp_indep_eq (m := m0) hm₁le h𝒢 (hPsim₁ γ γ') hindep
    refine h.trans ?_
    filter_upwards with ω
    exact hortho (ρ γ) (ρ γ')
  -- expand the square into a sum over pairs of components
  set Psi : Γ → Γ → Ω → ℝ := fun γ γ' ω => ψ (ρ γ) (W ω) * ψ (ρ γ') (W ω) with hPsidef
  set F : Γ × Γ → Ω → ℝ :=
    fun p ω => (lam p.1 * lam p.2) * ((A p.1 ω * A p.2 ω) * Psi p.1 p.2 ω) with hFdef
  have hexp : ∀ ω, (∑ γ, lam γ * (ψ (ρ γ) (W ω) * A γ ω)) ^ 2 = ∑ p : Γ × Γ, F p ω := by
    intro ω
    rw [Fintype.sum_prod_type, sq, Finset.sum_mul_sum]
    exact Finset.sum_congr rfl fun γ _ => Finset.sum_congr rfl fun γ' _ => by
      simp only [hFdef, hPsidef]; ring
  have hFint : ∀ p : Γ × Γ, Integrable (F p) μ := by
    intro p
    have h1 : Integrable (fun ω => (A p.1 ω * A p.2 ω) * Psi p.1 p.2 ω) μ :=
      (hAint p.1 p.2).mul_bdd (hPsimeas p.1 p.2).aestronglyMeasurable
        (Eventually.of_forall fun ω => hPsibd p.1 p.2 ω)
    simpa only [hFdef] using h1.const_mul (lam p.1 * lam p.2)
  have hstep : ∀ p : Γ × Γ, μ[F p | 𝒢]
      =ᵐ[μ] fun ω => (lam p.1 * lam p.2) *
        ((A p.1 ω * A p.2 ω) * (if ρ p.1 = ρ p.2 then (1:ℝ) else 0)) := by
    intro p
    have hAAmeas : StronglyMeasurable[𝒢] (fun ω => A p.1 ω * A p.2 ω) :=
      (hA p.1).mul (hA p.2)
    have hfg : Integrable ((fun ω => A p.1 ω * A p.2 ω) * Psi p.1 p.2) μ :=
      (hAint p.1 p.2).mul_bdd (hPsimeas p.1 p.2).aestronglyMeasurable
        (Eventually.of_forall fun ω => hPsibd p.1 p.2 ω)
    have hpull := condExp_mul_of_stronglyMeasurable_left (m := 𝒢) hAAmeas hfg (hPsiint p.1 p.2)
    have hsm : F p = (lam p.1 * lam p.2) • ((fun ω => A p.1 ω * A p.2 ω) * Psi p.1 p.2) := rfl
    rw [hsm]
    refine (condExp_smul (lam p.1 * lam p.2) _ 𝒢).trans ?_
    filter_upwards [hpull, hkey p.1 p.2] with ω hω hω2
    show (lam p.1 * lam p.2) * (μ[(fun ω => A p.1 ω * A p.2 ω) * Psi p.1 p.2 | 𝒢]) ω = _
    rw [hω]
    show (lam p.1 * lam p.2) * ((A p.1 ω * A p.2 ω) * (μ[Psi p.1 p.2 | 𝒢]) ω) = _
    rw [hω2]
  have hcongr : (fun ω => (∑ γ, lam γ * (ψ (ρ γ) (W ω) * A γ ω)) ^ 2)
      =ᵐ[μ] ∑ p : Γ × Γ, F p := by
    filter_upwards with ω
    rw [hexp ω]
    simp only [Finset.sum_apply]
  refine (condExp_congr_ae hcongr).trans ?_
  refine (condExp_finsetSum (fun p _ => hFint p) 𝒢).trans ?_
  filter_upwards [ae_all_iff.2 hstep] with ω hω
  simp only [Finset.sum_apply]
  rw [Finset.sum_congr rfl fun p _ => hω p, Fintype.sum_prod_type]
  exact Finset.sum_congr rfl fun γ _ => Finset.sum_congr rfl fun γ' _ => by ring

end Step

section Cheb

variable {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}

/-! #### Chebyshev's inequality -/

/-- Chebyshev's inequality in the form of the first condition of `mds_clt`: a sequence with
mean `1` and variance bounded by a null sequence converges to `1` in probability. -/
theorem tendstoInProb_of_variance_le [IsProbabilityMeasure μ]
    {W : ℕ → Ω → ℝ} {σ2 : ℝ} {b : ℕ → ℝ}
    (hW : ∀ n, MemLp (W n) 2 μ)
    (hmean : ∀ n, ∫ ω, W n ω ∂μ = σ2)
    (hvarb : ∀ n, variance (W n) μ ≤ b n)
    (hb : Tendsto b atTop (𝓝 0)) :
    ∀ δ : ℝ, 0 < δ →
      Tendsto (fun n => (μ {ω | δ ≤ |W n ω - σ2|}).toReal) atTop (𝓝 0) := by
  intro δ hδ
  have hδ2 : (0:ℝ) < δ ^ 2 := by positivity
  refine squeeze_zero (g := fun n => b n / δ ^ 2) (fun n => ENNReal.toReal_nonneg)
    (fun n => ?_) ?_
  · have h := meas_ge_le_variance_div_sq (μ := μ) (hW n) hδ
    rw [hmean n] at h
    have h2 : (μ {ω | δ ≤ |W n ω - σ2|}).toReal
        ≤ (ENNReal.ofReal (variance (W n) μ / δ ^ 2)).toReal :=
      ENNReal.toReal_mono ENNReal.ofReal_ne_top h
    refine h2.trans ?_
    rw [ENNReal.toReal_ofReal (div_nonneg (variance_nonneg _ _) hδ2.le)]
    exact div_le_div_of_nonneg_right (hvarb n) hδ2.le
  · simpa using hb.div_const (δ ^ 2)

end Cheb

section Rate

/-! #### The rate

`cut·tot / s_n⁴ → 0` when `cut = o(n)`, `tot = O(n)` and `s_n²(L)` is bounded below by a
positive multiple of `n` (`hs2`). -/

/-- The rate: `cut·tot / s_n⁴ = o(n)·O(n)/Θ(n²) → 0`. -/
theorem tendsto_cut_tot_div_sq
    {cut tot s2 : ℕ → ℝ} {C Ctot a : ℝ} (hC : 0 ≤ C) (hCtot : 0 ≤ Ctot) (ha : 0 < a)
    (hcutnn : ∀ n, 0 ≤ cut n) (htotnn : ∀ n, 0 ≤ tot n)
    (hcut : Tendsto (fun n : ℕ => cut n / n) atTop (𝓝 0))
    (htot : ∀ᶠ n : ℕ in atTop, tot n ≤ Ctot * n)
    (hs2 : ∀ᶠ n : ℕ in atTop, a * n ≤ s2 n) :
    Tendsto (fun n : ℕ => C * (cut n / s2 n * (tot n / s2 n))) atTop (𝓝 0) := by
  have hlim : Tendsto (fun n : ℕ => C * Ctot / a ^ 2 * (cut n / n)) atTop (𝓝 0) := by
    simpa using hcut.const_mul (C * Ctot / a ^ 2)
  refine squeeze_zero' ?_ ?_ hlim
  · filter_upwards [hs2, eventually_ge_atTop 1] with n hn hn1
    have hnpos : (0:ℝ) < n := by exact_mod_cast hn1
    have hs2pos : (0:ℝ) < s2 n := lt_of_lt_of_le (by positivity) hn
    have : 0 ≤ cut n / s2 n * (tot n / s2 n) :=
      mul_nonneg (div_nonneg (hcutnn n) hs2pos.le) (div_nonneg (htotnn n) hs2pos.le)
    exact mul_nonneg hC this
  · filter_upwards [hs2, htot, eventually_ge_atTop 1] with n hn hnt hn1
    have hnpos : (0:ℝ) < n := by exact_mod_cast hn1
    have hanpos : (0:ℝ) < a * n := by positivity
    have hs2pos : (0:ℝ) < s2 n := lt_of_lt_of_le hanpos hn
    have hkey : cut n / s2 n * (tot n / s2 n) ≤ Ctot / a ^ 2 * (cut n / n) := by
      have h1 : cut n / s2 n * (tot n / s2 n) = cut n * tot n / (s2 n * s2 n) := by
        field_simp
      have h2 : Ctot / a ^ 2 * (cut n / n) = cut n * (Ctot * n) / ((a * n) * (a * n)) := by
        field_simp
      rw [h1, h2]
      have hnum : cut n * tot n ≤ cut n * (Ctot * n) :=
        mul_le_mul_of_nonneg_left hnt (hcutnn n)
      have hden : (a * n) * (a * n) ≤ s2 n * s2 n :=
        mul_le_mul hn hn hanpos.le hs2pos.le
      exact div_le_div₀ (mul_nonneg (hcutnn n) (mul_nonneg hCtot hnpos.le)) hnum
        (by positivity) hden
    calc C * (cut n / s2 n * (tot n / s2 n)) ≤ C * (Ctot / a ^ 2 * (cut n / n)) :=
          mul_le_mul_of_nonneg_left hkey hC
      _ = C * Ctot / a ^ 2 * (cut n / n) := by ring

end Rate

section QuadForm

variable {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
variable {V : Type*} [Fintype V] [DecidableEq V]
variable {R : Type*} [DecidableEq R] {U : V → Ω → ℝ} {ψ : R → ℝ → ℝ} {Rpos : Set R} {B₀ : ℝ}
variable {Γ : Type*} [Fintype Γ] [DecidableEq Γ] {S : Γ → Type*} [∀ γ, Fintype (S γ)]
variable {I : Type*} [Fintype I] {τ : Type*} [DecidableEq τ]
variable {sites : ∀ γ, S γ → Finset V} {rIdx : Γ → V → R} {arr : ∀ γ, S γ → I → ℝ}
variable {tag : Γ → τ} {lam : Γ → ℝ}

/-! #### The mean and variance of the quadratic form

`quadForm` is `∑_{γ,γ'} λ_γλ_{γ'}X_{γγ'}` written on `cvarEntry`. `integral_quadForm` is clause
(a) of Lemma SM.C.3 summed, and `variance_quadForm_le` is clause (b). -/

/-- The quadratic form `∑_{γ,γ'} λ_γ λ_{γ'} X_{γγ'}` on `cvarEntry`. -/
noncomputable def quadForm (U : V → Ω → ℝ) (ψ : R → ℝ → ℝ)
    (sites : ∀ γ, S γ → Finset V) (rIdx : Γ → V → R) (arr : ∀ γ, S γ → I → ℝ)
    (tag : Γ → τ) (lam : Γ → ℝ) : Ω → ℝ :=
  fun ω => ∑ γ : Γ, ∑ γ' : Γ, lam γ * lam γ' * cvarEntry U ψ sites rIdx arr tag γ γ' ω

omit [DecidableEq V] [DecidableEq Γ] in
theorem memLp_quadForm (h : IsBasisSystem μ U ψ Rpos B₀) :
    MemLp (quadForm U ψ sites rIdx arr tag lam) 2 μ := by
  have h2 : MemLp (∑ γ : Γ, ∑ γ' : Γ, fun ω : Ω =>
      lam γ * lam γ' * cvarEntry U ψ sites rIdx arr tag γ γ' ω) 2 μ :=
    memLp_finsetSum' _ fun γ _ =>
      memLp_finsetSum' _ fun γ' _ => (memLp_cvarEntry h γ γ').const_mul (lam γ * lam γ')
  have heq : (∑ γ : Γ, ∑ γ' : Γ, fun ω : Ω =>
      lam γ * lam γ' * cvarEntry U ψ sites rIdx arr tag γ γ' ω)
      = quadForm U ψ sites rIdx arr tag lam := by
    funext ω
    simp only [quadForm, Finset.sum_apply]
  rwa [heq] at h2

omit [DecidableEq Γ] in
theorem integral_quadForm (h : IsBasisSystem μ U ψ Rpos B₀)
    (hpos : ∀ (γ : Γ) (s : S γ), ∀ w ∈ sites γ s, rIdx γ w ∈ Rpos)
    (hinj : ∀ (γ : Γ) (s s' : S γ), sites γ s = sites γ s' → s = s')
    (hsep : ∀ (γ γ' : Γ) (s : S γ) (s' : S γ'), tag γ = tag γ' → sites γ s = sites γ' s' →
      (∀ w ∈ sites γ s, rIdx γ w = rIdx γ' w) → γ = γ') :
    ∫ ω, quadForm U ψ sites rIdx arr tag lam ω ∂μ
      = ∑ γ : Γ, lam γ ^ 2 * rectFrobSq (arr γ) := by
  classical
  have : IsProbabilityMeasure μ := h.isProbabilityMeasure
  obtain ⟨hdiag, hoff⟩ := concentration_clause_a (arr := arr) (tag := tag) h hpos hinj hsep
  have hint : ∀ γ γ' : Γ,
      Integrable (fun ω => lam γ * lam γ' * cvarEntry U ψ sites rIdx arr tag γ γ' ω) μ :=
    fun γ γ' => ((memLp_cvarEntry h γ γ').integrable one_le_two).const_mul _
  have hrow : ∀ γ : Γ, Integrable
      (fun ω => ∑ γ' : Γ, lam γ * lam γ' * cvarEntry U ψ sites rIdx arr tag γ γ' ω) μ :=
    fun γ => integrable_finsetSum _ fun γ' _ => hint γ γ'
  show ∫ ω, (∑ γ : Γ, ∑ γ' : Γ, lam γ * lam γ' *
    cvarEntry U ψ sites rIdx arr tag γ γ' ω) ∂μ = _
  rw [integral_finsetSum _ fun γ _ => hrow γ]
  refine Finset.sum_congr rfl fun γ _ => ?_
  rw [integral_finsetSum _ fun γ' _ => hint γ γ']
  rw [Finset.sum_eq_single γ]
  · rw [integral_const_mul, hdiag γ]; ring
  · intro γ' _ hne
    rw [integral_const_mul, hoff γ γ' (Ne.symm hne), mul_zero]
  · intro hγ; exact absurd (Finset.mem_univ γ) hγ

end QuadForm

section Assembly

open Matrix

variable {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}

/-! #### Assembly

The constant `clauseBConst` depends only on `B_0`, `|Γ|` and `M = |K|`, so it is uniform along a
sequence of designs. -/

/-- The constant of `concentration_clause_b_general_closed_uniform`, as a function of `B_0`,
`|Γ|` and the number `M = |K|` of interaction coordinates. -/
noncomputable def clauseBConst (B₀ : ℝ) (cΓ cK : ℕ) : ℝ :=
  4 * (cΓ : ℝ) ^ 2 *
    (2 * (((max B₀ 1 ^ cK) ^ 2) ^ 2 * (cK : ℝ)
        + 4 * (2:ℝ) ^ cK * (2:ℝ) ^ cK * (2:ℝ) ^ cK * max B₀ 1 ^ (4 * cK)) +
      (4:ℝ) ^ cK * max B₀ 1 ^ (4 * cK))

/-- Clause (b) of Lemma SM.C.3 on `quadForm`, with the constant `clauseBConst`. -/
theorem variance_quadForm_le
    {K : Type*} [Fintype K] [DecidableEq K] {N : K → Type*}
    [∀ k, Fintype (N k)] [∀ k, DecidableEq (N k)]
    {R : Type*} [DecidableEq R] {U : Site K N → Ω → ℝ} {ψ : R → ℝ → ℝ} {Rpos : Set R} {B₀ : ℝ}
    {Γ : Type*} [Fintype Γ] [DecidableEq Γ] {S : Γ → Type*} [∀ γ, Fintype (S γ)]
    {I : Type*} [Fintype I] {τ : Type*} [DecidableEq τ] {tag : Γ → τ}
    {sites : ∀ γ, S γ → Finset (Site K N)} {rIdx : Γ → Site K N → R}
    {arr : ∀ γ, S γ → I → ℝ} {lev : Γ → Finset K} {pt : ∀ γ, S γ → K → Site K N}
    {lam : Γ → ℝ} {cutmax totmax : ℝ}
    (h : IsBasisSystem μ U ψ Rpos B₀)
    (hsite : ∀ (g : Γ) (x : S g), sites g x = (lev g).image (pt g x))
    (hptc : ∀ (g g' : Γ) (x : S g) (y : S g') (k k' : K), pt g x k = pt g' y k' → k = k')
    (hptf : ∀ (g : Γ) (x : S g), ∀ k ∈ lev g, (pt g x k).1 = k)
    (hpos : ∀ (g : Γ) (x : S g), ∀ w ∈ sites g x, rIdx g w ∈ Rpos)
    (hinj : ∀ (g : Γ) (x y : S g), sites g x = sites g y → x = y)
    (hsep : ∀ (g g' : Γ) (x : S g) (y : S g'), tag g = tag g' → sites g x = sites g' y →
      (∀ w ∈ sites g x, rIdx g w = rIdx g' w) → g = g')
    (hlam : ∑ γ, lam γ ^ 2 ≤ 1)
    (hcut : ∀ γ : Γ, rectFrobNorm (Matrix.of (arr γ) * (Matrix.of (arr γ))ᵀ) ≤ cutmax)
    (hcutA : ∀ (g : Γ), ∀ Bs ⊂ lev g,
      rectFrobNorm (Matrix.of (levMat lev pt Bs g (arr g)) *
        (Matrix.of (levMat lev pt Bs g (arr g)))ᵀ) ≤ cutmax)
    (htot : ∀ γ : Γ, rectFrobSq (arr γ) ≤ totmax) :
    variance (quadForm U ψ sites rIdx arr tag lam) μ
      ≤ clauseBConst B₀ (Fintype.card Γ) (Fintype.card K) * (cutmax * totmax) :=
  concentration_clause_b_general_closed_uniform h hsite hptc hptf hpos hinj hsep hlam hcut
    hcutA htot

theorem clauseBConst_nonneg (B₀ : ℝ) (cΓ cK : ℕ) : 0 ≤ clauseBConst B₀ cΓ cK := by
  have h1 : (0:ℝ) ≤ max B₀ 1 := le_trans zero_le_one (le_max_right _ _)
  unfold clauseBConst
  positivity

/-- The rate hypothesis in terms of `cut` and `tot` divided by `s_n²(L)`, which is the scaling
of the coefficient array `W^{(e)}_c/s_n(L)` to which Lemma SM.C.3 is applied. -/
theorem rate_of_contraction {B₀ : ℝ} {cΓ cK : ℕ}
    {cutraw totraw s2 : ℕ → ℝ} {Ctot a : ℝ} (hCtot : 0 ≤ Ctot) (ha : 0 < a)
    (hcutnn : ∀ n, 0 ≤ cutraw n) (htotnn : ∀ n, 0 ≤ totraw n)
    (hcut : Tendsto (fun n : ℕ => cutraw n / n) atTop (𝓝 0))
    (htot : ∀ᶠ n : ℕ in atTop, totraw n ≤ Ctot * n)
    (hs2 : ∀ᶠ n : ℕ in atTop, a * n ≤ s2 n) :
    Tendsto (fun n => clauseBConst B₀ cΓ cK * (cutraw n / s2 n * (totraw n / s2 n)))
      atTop (𝓝 0) :=
  tendsto_cut_tot_div_sq (clauseBConst_nonneg B₀ cΓ cK) hCtot ha hcutnn htotnn hcut htot hs2

/-- With `B_0 = 2` and site count `|V_n| = n + 1`, the factor `max(B_0,1)^{4|V_n|}` times
`1/(n+1)⁴` is at least `1` for every `n`: a constant growing with the site count would prevent
the rate from tending to `0`. -/
theorem weak_constant_bounded_below (n : ℕ) :
    (1:ℝ) ≤ max (2:ℝ) 1 ^ (4 * (n + 1)) *
      (1 / ((n:ℝ) + 1) ^ 2 * (1 / ((n:ℝ) + 1) ^ 2)) := by
  have hpos : (0:ℝ) < ((n:ℝ) + 1) ^ 4 := by positivity
  have hm : ((n:ℝ) + 1) ≤ (2:ℝ) ^ (n + 1) := by
    have h0 : (n + 1 : ℕ) < 2 ^ (n + 1) := Nat.lt_two_pow_self
    have h1 : ((n + 1 : ℕ) : ℝ) ≤ ((2 ^ (n + 1) : ℕ) : ℝ) := by exact_mod_cast h0.le
    push_cast at h1
    exact h1
  have h4 : ((n:ℝ) + 1) ^ 4 ≤ (2:ℝ) ^ (4 * (n + 1)) := by
    calc ((n:ℝ) + 1) ^ 4 ≤ ((2:ℝ) ^ (n + 1)) ^ 4 := by
          exact pow_le_pow_left₀ (by positivity) hm 4
      _ = (2:ℝ) ^ (4 * (n + 1)) := by rw [← pow_mul, Nat.mul_comm]
  have hdiv : (1:ℝ) ≤ (2:ℝ) ^ (4 * (n + 1)) / ((n:ℝ) + 1) ^ 4 :=
    (le_div_iff₀ hpos).mpr (by simpa using h4)
  have hmax : max (2:ℝ) 1 = 2 := by norm_num
  have heq : max (2:ℝ) 1 ^ (4 * (n + 1)) *
      (1 / ((n:ℝ) + 1) ^ 2 * (1 / ((n:ℝ) + 1) ^ 2))
      = (2:ℝ) ^ (4 * (n + 1)) / ((n:ℝ) + 1) ^ 4 := by
    rw [hmax]
    have hne : ((n:ℝ) + 1) ≠ 0 := by positivity
    field_simp
  rw [heq]
  exact hdiv

/-- `V_n²/s_n²(L) →ᵖ 1` from Lemma SM.C.3. `Vn` is the conditional-variance process and
`halg` identifies it with the quadratic form plus the cell constant `cellc n`.

* `hnorm` is the display `∑_γλ_γ²‖W^{(e_γ)}_c‖_F² + ∑_o(c'x̃_o)²σ²_ε(o) = s_n²(L)` after division
  by `s_n²(L)`, so that the mean of `Vn n` is `1`.
* `cellc n` is the sum of the cell-step conditional variances `(c'x̃_o)²σ²_ε(o)`.

The index types `N n`, `S n`, `Ix n` may vary with `n`; the components `Γ` and their
coefficients are fixed at a fixed truncation level `L`. -/
theorem tendstoInProb_condVar_of_concentration
    {K : Type*} [Fintype K] [DecidableEq K] {N : ℕ → K → Type*}
    [∀ n k, Fintype (N n k)] [∀ n k, DecidableEq (N n k)]
    {R : Type*} [DecidableEq R] {ψ : R → ℝ → ℝ} {Rpos : Set R} {B₀ : ℝ}
    {Γ : Type*} [Fintype Γ] [DecidableEq Γ] {S : ℕ → Γ → Type*} [∀ n γ, Fintype (S n γ)]
    {Ix : ℕ → Type*} [∀ n, Fintype (Ix n)] {τ : Type*} [DecidableEq τ] {tag : Γ → τ}
    {U : ∀ n : ℕ, Site K (N n) → Ω → ℝ}
    {sites : ∀ (n : ℕ) (γ : Γ), S n γ → Finset (Site K (N n))}
    {rIdx : ∀ n : ℕ, Γ → Site K (N n) → R}
    {arr : ∀ (n : ℕ) (γ : Γ), S n γ → Ix n → ℝ}
    {lev : Γ → Finset K} {pt : ∀ (n : ℕ) (γ : Γ), S n γ → K → Site K (N n)}
    {lam : Γ → ℝ} {cellc : ℕ → ℝ} {cutmax totmax : ℕ → ℝ} {Vn : ℕ → Ω → ℝ}
    (hbs : ∀ n, IsBasisSystem μ (U n) ψ Rpos B₀)
    (hsite : ∀ (n : ℕ) (g : Γ) (x : S n g), sites n g x = (lev g).image (pt n g x))
    (hptc : ∀ (n : ℕ) (g g' : Γ) (x : S n g) (y : S n g') (k k' : K),
      pt n g x k = pt n g' y k' → k = k')
    (hptf : ∀ (n : ℕ) (g : Γ) (x : S n g), ∀ k ∈ lev g, (pt n g x k).1 = k)
    (hpos : ∀ (n : ℕ) (g : Γ) (x : S n g), ∀ w ∈ sites n g x, rIdx n g w ∈ Rpos)
    (hinj : ∀ (n : ℕ) (g : Γ) (x y : S n g), sites n g x = sites n g y → x = y)
    (hsep : ∀ (n : ℕ) (g g' : Γ) (x : S n g) (y : S n g'), tag g = tag g' →
      sites n g x = sites n g' y → (∀ w ∈ sites n g x, rIdx n g w = rIdx n g' w) → g = g')
    (hlam : ∑ γ, lam γ ^ 2 ≤ 1)
    (hcut : ∀ (n : ℕ) (γ : Γ),
      rectFrobNorm (Matrix.of (arr n γ) * (Matrix.of (arr n γ))ᵀ) ≤ cutmax n)
    (hcutA : ∀ (n : ℕ) (g : Γ), ∀ Bs ⊂ lev g,
      rectFrobNorm (Matrix.of (levMat lev (pt n) Bs g (arr n g)) *
        (Matrix.of (levMat lev (pt n) Bs g (arr n g)))ᵀ) ≤ cutmax n)
    (htot : ∀ (n : ℕ) (γ : Γ), rectFrobSq (arr n γ) ≤ totmax n)
    (hnorm : ∀ n, (∑ γ, lam γ ^ 2 * rectFrobSq (arr n γ)) + cellc n = 1)
    (halg : ∀ n, Vn n
      =ᵐ[μ] fun ω => quadForm (U n) ψ (sites n) (rIdx n) (arr n) tag lam ω + cellc n)
    (hrate : Tendsto (fun n =>
        clauseBConst B₀ (Fintype.card Γ) (Fintype.card K)
          * (cutmax n * totmax n)) atTop (𝓝 0)) :
    ∀ δ : ℝ, 0 < δ → Tendsto (fun n => (μ {ω | δ ≤ |Vn n ω - 1|}).toReal) atTop (𝓝 0) := by
  classical
  have hP : IsProbabilityMeasure μ := (hbs 0).isProbabilityMeasure
  set Wn : ℕ → Ω → ℝ :=
    fun n ω => quadForm (U n) ψ (sites n) (rIdx n) (arr n) tag lam ω + cellc n with hWndef
  have hWL2 : ∀ n, MemLp (Wn n) 2 μ := fun n =>
    (memLp_quadForm (hbs n)).add (memLp_const _)
  have hmean : ∀ n, ∫ ω, Wn n ω ∂μ = 1 := by
    intro n
    have hq : Integrable (quadForm (U n) ψ (sites n) (rIdx n) (arr n) tag lam) μ :=
      (memLp_quadForm (hbs n)).integrable one_le_two
    rw [hWndef]
    rw [integral_add hq (integrable_const _), integral_const,
      integral_quadForm (hbs n) (hpos n) (hinj n) (hsep n)]
    simpa using hnorm n
  have hvarb : ∀ n, variance (Wn n) μ
      ≤ clauseBConst B₀ (Fintype.card Γ) (Fintype.card K)
          * (cutmax n * totmax n) := by
    intro n
    have hvc : variance (Wn n) μ
        = variance (quadForm (U n) ψ (sites n) (rIdx n) (arr n) tag lam) μ :=
      variance_add_const (memLp_quadForm (hbs n)).aestronglyMeasurable (cellc n)
    rw [hvc]
    exact variance_quadForm_le (hbs n) (hsite n) (hptc n) (hptf n) (hpos n) (hinj n) (hsep n)
      hlam (hcut n) (hcutA n) (htot n)
  have hW := tendstoInProb_of_variance_le (W := Wn) (σ2 := 1) hWL2 hmean hvarb hrate
  intro δ hδ
  have hset : ∀ n, μ {ω | δ ≤ |Vn n ω - 1|} = μ {ω | δ ≤ |Wn n ω - 1|} := by
    intro n
    refine measure_congr ?_
    filter_upwards [halg n] with ω hω
    show (δ ≤ |Vn n ω - 1|) = (δ ≤ |Wn n ω - 1|)
    rw [hω]
  simpa only [hset] using hW δ hδ

/-- The martingale CLT for `T_n(L)/s_n(L)` with `hvar` supplied by
`tendstoInProb_condVar_of_concentration`. The Lindeberg condition `hlind` concerns `rowDiff`
alone and remains a hypothesis. -/
theorem tendsto_charFun_degenSum_of_concentration [IsProbabilityMeasure μ]
    {ι : Type*} [Fintype ι] [Nonempty ι] {T : Type*} [Fintype T] [DecidableEq T]
    {K : Type*} [Fintype K] [DecidableEq K] {N : K → Type*}
    [∀ k, Fintype (N k)] [∀ k, DecidableEq (N k)]
    {R : Type*} [DecidableEq R] {ψ : R → ℝ → ℝ} {Rpos : Set R} {B₀ : ℝ}
    {Γ : Type*} [Fintype Γ] [DecidableEq Γ] {S : ℕ → Γ → Type*} [∀ n γ, Fintype (S n γ)]
    {Ix : ℕ → Type*} [∀ n, Fintype (Ix n)] {τ : Type*} [DecidableEq τ] {tag : Γ → τ}
    {U : ℕ → Site K N → Ω → ℝ}
    {sites : ∀ (n : ℕ) (γ : Γ), S n γ → Finset (Site K N)}
    {rIdx : ∀ _n : ℕ, Γ → Site K N → R}
    {arr : ∀ (n : ℕ) (γ : Γ), S n γ → Ix n → ℝ}
    {lev : Γ → Finset K} {pt : ∀ (n : ℕ) (γ : Γ), S n γ → K → Site K N}
    {lam : Γ → ℝ} {cellc : ℕ → ℝ} {cutmax totmax : ℕ → ℝ}
    {coord : ℕ → T → ι → Site K N} {g : ℕ → (ι → ℝ) → ℝ} {c : ℕ → T → ℝ}
    {step : ℕ → Site K N → ℕ} {k : ℕ → ℕ}
    (hbs : ∀ n, IsBasisSystem μ (U n) ψ Rpos B₀)
    (hg : ∀ n, Measurable (g n))
    (hsq : ∀ n t, MemLp (degenTerm (U n) (coord n) (g n) t) 2 μ)
    (hdeg : ∀ (n : ℕ) (t : T) (e' : Set ι), e' ≠ Set.univ →
      μ[degenTerm (U n) (coord n) (g n) t | latentSigma (U n) (coord n t '' e')] =ᵐ[μ] 0)
    (hN : ∀ n v, step n v < k n)
    (hsite : ∀ (n : ℕ) (q : Γ) (x : S n q), sites n q x = (lev q).image (pt n q x))
    (hptc : ∀ (n : ℕ) (q q' : Γ) (x : S n q) (y : S n q') (a b : K),
      pt n q x a = pt n q' y b → a = b)
    (hptf : ∀ (n : ℕ) (q : Γ) (x : S n q), ∀ a ∈ lev q, (pt n q x a).1 = a)
    (hpos : ∀ (n : ℕ) (q : Γ) (x : S n q), ∀ w ∈ sites n q x, rIdx n q w ∈ Rpos)
    (hinj : ∀ (n : ℕ) (q : Γ) (x y : S n q), sites n q x = sites n q y → x = y)
    (hsep : ∀ (n : ℕ) (q q' : Γ) (x : S n q) (y : S n q'), tag q = tag q' →
      sites n q x = sites n q' y → (∀ w ∈ sites n q x, rIdx n q w = rIdx n q' w) → q = q')
    (hlam : ∑ γ, lam γ ^ 2 ≤ 1)
    (hcut : ∀ (n : ℕ) (γ : Γ),
      rectFrobNorm (Matrix.of (arr n γ) * (Matrix.of (arr n γ))ᵀ) ≤ cutmax n)
    (hcutA : ∀ (n : ℕ) (q : Γ), ∀ Bs ⊂ lev q,
      rectFrobNorm (Matrix.of (levMat lev (pt n) Bs q (arr n q)) *
        (Matrix.of (levMat lev (pt n) Bs q (arr n q)))ᵀ) ≤ cutmax n)
    (htot : ∀ (n : ℕ) (γ : Γ), rectFrobSq (arr n γ) ≤ totmax n)
    (hnorm : ∀ n, (∑ γ, lam γ ^ 2 * rectFrobSq (arr n γ)) + cellc n = 1)
    (halg : ∀ n, mdsCondVariance k (rowDiff μ U coord g c step k) (rowSigma U step k) μ n
      =ᵐ[μ] fun ω => quadForm (U n) ψ (sites n) (rIdx n) (arr n) tag lam ω + cellc n)
    (hrate : Tendsto (fun n =>
        clauseBConst B₀ (Fintype.card Γ) (Fintype.card K)
          * (cutmax n * totmax n)) atTop (𝓝 0))
    (hlind : ∀ ε : ℝ, 0 < ε →
      Tendsto (fun n => ∑ i, ∫ ω in {ω | ε ≤ |rowDiff μ U coord g c step k n i ω|},
        (rowDiff μ U coord g c step k n i ω) ^ 2 ∂μ) atTop (𝓝 0))
    (u : ℝ) :
    Tendsto (fun n => charFun (μ.map (degenSum (U n) (coord n) (g n) (c n))) u) atTop
      (𝓝 (charFun (gaussianReal 0 1) u)) := by
  have hvar := tendstoInProb_condVar_of_concentration (N := fun _ => N) (S := S) (Ix := Ix)
    (U := U) (sites := sites) (rIdx := rIdx) (arr := arr) (lev := lev) (pt := pt)
    (lam := lam) (cellc := cellc) (cutmax := cutmax) (totmax := totmax)
    (Vn := fun n => mdsCondVariance k (rowDiff μ U coord g c step k) (rowSigma U step k) μ n)
    hbs hsite hptc hptf hpos hinj hsep hlam hcut hcutA htot hnorm halg hrate
  have h := tendsto_charFun_degenSum (μ := μ) (U := U) (coord := coord) (g := g) (c := c)
    (step := step) (k := k) (fun n v => (hbs n).measurable_latent v) (fun n => (hbs n).indep)
    hg hsq hdeg hN (σ2 := 1) zero_le_one hvar hlind u
  simpa using h

end Assembly

/-! #### Example

Consider two components with equal tags on two interaction coordinates, independent fair
signs, `λ_γ = 1/2` and a coefficient array shrinking like `1/(n+1)`. The variance of `V_n` is
`(n+1)^{-4}/4 > 0` at every index, and the rate is obtained through `rate_of_contraction`. The
identity `halg` holds by definition of `V_n`. -/

section WitnessBridge

open ClauseAWitness ClauseBWitness GeneralWitness Matrix

namespace BridgeWitness

/-- The two interaction coordinates, each with two latent indices, so that `V = Σ_k 𝒩_k` with
`|K| = 2`. -/
abbrev bK : Type := Fin 2
abbrev bN : bK → Type := fun _ => Fin 2
abbrev bSite : Type := Site bK bN

def blev : ∀ _γ : Fin 2, Finset bK := fun _ => Finset.univ
def bpt : ∀ _γ : Fin 2, Unit → bK → bSite := fun γ _ k => ⟨k, γ⟩
def bsites : ∀ _γ : Fin 2, Unit → Finset bSite := fun γ _ => {⟨0, γ⟩, ⟨1, γ⟩}
def brIdx : Fin 2 → bSite → Fin 2 := fun _ _ => 1
def btag : Fin 2 → Unit := fun _ => ()
noncomputable def blam : Fin 2 → ℝ := fun _ => 1 / 2
noncomputable def bscale (n : ℕ) : ℝ := 1 / ((n : ℝ) + 1)
noncomputable def barr (n : ℕ) : ∀ _γ : Fin 2, Unit → Unit → ℝ := fun _ _ _ => bscale n
noncomputable def bcell (n : ℕ) : ℝ := 1 - bscale n ^ 2 / 2

noncomputable def bs2 (n : ℕ) : ℝ := ((n : ℝ) + 1) ^ 2

theorem bscale_pos (n : ℕ) : 0 < bscale n := by
  unfold bscale; positivity

theorem bscale_sq (n : ℕ) : bscale n ^ 2 = 1 / bs2 n := by
  unfold bscale bs2; rw [div_pow]; norm_num

theorem bHsite : ∀ (g : Fin 2) (x : Unit), bsites g x = (blev g).image (bpt g x) := by decide
theorem bHptc : ∀ (g g' : Fin 2) (x y : Unit) (k k' : bK), bpt g x k = bpt g' y k' → k = k' :=
  fun _ _ _ _ _ _ h => congrArg Sigma.fst h
theorem bHptf : ∀ (g : Fin 2) (x : Unit), ∀ k ∈ blev g, (bpt g x k).1 = k :=
  fun _ _ _ _ => rfl
theorem bHpos : ∀ (g : Fin 2) (x : Unit), ∀ w ∈ bsites g x, brIdx g w ∈ ({1} : Set (Fin 2)) :=
  fun _ _ _ _ => rfl
theorem bHinj : ∀ (g : Fin 2) (x y : Unit), bsites g x = bsites g y → x = y :=
  fun _ _ _ _ => rfl
theorem bHsep : ∀ (g g' : Fin 2) (x y : Unit), btag g = btag g' → bsites g x = bsites g' y →
    (∀ w ∈ bsites g x, brIdx g w = brIdx g' w) → g = g' := by
  intro g g' x y _ hs _
  have hs' : ({⟨0, g⟩, ⟨1, g⟩} : Finset bSite) = {⟨0, g'⟩, ⟨1, g'⟩} := hs
  clear hs
  fin_cases g <;> fin_cases g' <;> first | rfl | (exfalso; revert hs'; decide)

theorem brectFrobSq (n : ℕ) (γ : Fin 2) : rectFrobSq (barr n γ) = bscale n ^ 2 := by
  simp [rectFrobSq, barr]

theorem bHtot (n : ℕ) (γ : Fin 2) : rectFrobSq (barr n γ) ≤ 1 / bs2 n := by
  rw [brectFrobSq, bscale_sq]

theorem bHcut (n : ℕ) (γ : Fin 2) :
    rectFrobNorm (Matrix.of (barr n γ) * (Matrix.of (barr n γ))ᵀ) ≤ 1 / bs2 n :=
  le_trans (rectFrobNorm_mul_transpose_self_le _) (bHtot n γ)

theorem bHcutA (n : ℕ) (g : Fin 2) : ∀ Bs ⊂ blev g,
    rectFrobNorm (Matrix.of (levMat blev bpt Bs g (barr n g)) *
      (Matrix.of (levMat blev bpt Bs g (barr n g)))ᵀ) ≤ 1 / bs2 n := by
  intro Bs _
  refine le_trans (rectFrobNorm_mul_transpose_self_le _) ?_
  have hz : rectFrobSq (Matrix.of (levMat blev bpt Bs g (barr n g))) = rectFrobSq (barr n g) :=
    rectFrobSq_levMat (sites := bsites) bHsite bHinj Bs g (barr n g)
  rw [hz]
  exact bHtot n g

theorem bHlam : ∑ γ : Fin 2, blam γ ^ 2 ≤ 1 := by norm_num [blam, Fin.sum_univ_two]

theorem bHnorm (n : ℕ) :
    (∑ γ : Fin 2, blam γ ^ 2 * rectFrobSq (barr n γ)) + bcell n = 1 := by
  simp only [brectFrobSq, blam, bcell, Fin.sum_univ_two]
  ring

/-- `π^γ`, the basis product of a sub-tuple, which is a product of two signs. -/
noncomputable def bpi (γ : Fin 2) (ω : bSite → ℝ) : ℝ :=
  basisProd (gU bSite) wψ bsites brIdx γ () ω

theorem bsite_pair (γ : Fin 2) : (⟨0, γ⟩ : bSite) ≠ ⟨1, γ⟩ :=
  fun h => absurd (congrArg Sigma.fst h) (by decide : ¬ ((0 : bK) = 1))

theorem bpi_apply (γ : Fin 2) (ω : bSite → ℝ) :
    bpi γ ω = wψ 1 (ω ⟨0, γ⟩) * wψ 1 (ω ⟨1, γ⟩) := by
  simp only [bpi, basisProd, bsites, brIdx, gU]
  rw [Finset.prod_pair (bsite_pair γ)]

theorem bpi_sq (γ : Fin 2) (ω : bSite → ℝ) : bpi γ ω ^ 2 = 1 := by
  rw [bpi_apply, mul_pow, wψ_sq, wψ_sq]; norm_num

theorem bquadForm_apply (n : ℕ) (ω : bSite → ℝ) :
    quadForm (gU bSite) wψ bsites brIdx (barr n) btag blam ω
      = bscale n ^ 2 / 4 * (bpi 0 ω + bpi 1 ω) ^ 2 := by
  simp only [quadForm, cvarEntry, blockSum, btag, blam, barr, bpi, Fin.sum_univ_two,
    Finset.univ_unique, Finset.sum_singleton, ite_true]
  ring

theorem bquadForm_eq (n : ℕ) (ω : bSite → ℝ) :
    quadForm (gU bSite) wψ bsites brIdx (barr n) btag blam ω
      = bscale n ^ 2 / 2 * (1 + bpi 0 ω * bpi 1 ω) := by
  rw [bquadForm_apply]
  have h0 := bpi_sq 0 ω
  have h1 := bpi_sq 1 ω
  nlinarith [h0, h1]

theorem bQ_integrable : Integrable (fun ω => bpi 0 ω * bpi 1 ω) (gmu bSite) :=
  integrable_basisProd_mul (gIsBasisSystem bSite) (sites := bsites) (rIdx := brIdx) 0 1 () ()

theorem bQ_integral : ∫ ω, bpi 0 ω * bpi 1 ω ∂(gmu bSite) = 0 := by
  have h := integral_basisProd_mul (gIsBasisSystem bSite) (sites := bsites) bHpos 0 1 () ()
  rw [show (fun ω => bpi 0 ω * bpi 1 ω) = fun ω =>
    basisProd (gU bSite) wψ bsites brIdx 0 () ω * basisProd (gU bSite) wψ bsites brIdx 1 () ω
    from rfl]
  rw [h, ite_eq_right]
  rintro ⟨hs, -⟩
  exact absurd hs (by decide)

theorem bQ_sq (ω : bSite → ℝ) : (bpi 0 ω * bpi 1 ω) ^ 2 = 1 := by
  rw [mul_pow, bpi_sq, bpi_sq]; norm_num

theorem bquadSq_apply (n : ℕ) (ω : bSite → ℝ) :
    (quadForm (gU bSite) wψ bsites brIdx (barr n) btag blam ω) ^ 2
      = bscale n ^ 4 / 4 * (2 + 2 * (bpi 0 ω * bpi 1 ω)) := by
  rw [bquadForm_eq]
  have hQ := bQ_sq ω
  have hexp : (1 + bpi 0 ω * bpi 1 ω) ^ 2
      = 1 + 2 * (bpi 0 ω * bpi 1 ω) + (bpi 0 ω * bpi 1 ω) ^ 2 := by ring
  have : (bscale n ^ 2 / 2 * (1 + bpi 0 ω * bpi 1 ω)) ^ 2
      = bscale n ^ 4 / 4 * (1 + 2 * (bpi 0 ω * bpi 1 ω) + (bpi 0 ω * bpi 1 ω) ^ 2) := by ring
  rw [this, hQ]; ring

theorem bquadSq_integral (n : ℕ) :
    ∫ ω, (quadForm (gU bSite) wψ bsites brIdx (barr n) btag blam ω) ^ 2 ∂(gmu bSite)
      = bscale n ^ 4 / 2 := by
  simp only [bquadSq_apply]
  rw [integral_const_mul,
    integral_add (integrable_const _) (bQ_integrable.const_mul 2),
    integral_const_mul, bQ_integral, integral_const]
  simp
  ring

theorem bmean (n : ℕ) :
    ∫ ω, quadForm (gU bSite) wψ bsites brIdx (barr n) btag blam ω ∂(gmu bSite)
      = bscale n ^ 2 / 2 := by
  rw [integral_quadForm (gIsBasisSystem bSite) bHpos bHinj bHsep]
  simp only [brectFrobSq, blam, Fin.sum_univ_two]
  ring

/-- The conditional variance is random on this model, with variance `(bscale n)^4/4 > 0` at
every index. -/
theorem bvariance (n : ℕ) :
    variance (quadForm (gU bSite) wψ bsites brIdx (barr n) btag blam) (gmu bSite)
      = bscale n ^ 4 / 4 := by
  rw [variance_eq_sub (memLp_quadForm (gIsBasisSystem bSite))]
  have h1 : (gmu bSite)[(quadForm (gU bSite) wψ bsites brIdx (barr n) btag blam) ^ 2]
      = bscale n ^ 4 / 2 := bquadSq_integral n
  have h2 : (gmu bSite)[quadForm (gU bSite) wψ bsites brIdx (barr n) btag blam]
      = bscale n ^ 2 / 2 := bmean n
  rw [h1, h2]; ring

/-- The rate, through `rate_of_contraction`: `cut = 1 = o(n)`, `tot = 1 = O(n)`,
`s_n² = (n+1)² ≥ n`. -/
theorem brate : Tendsto (fun n : ℕ =>
    clauseBConst 1 (Fintype.card (Fin 2)) (Fintype.card bK)
      * (1 / bs2 n * (1 / bs2 n))) atTop (𝓝 0) := by
  refine rate_of_contraction (cutraw := fun _ => 1) (totraw := fun _ => 1) (s2 := bs2)
    (Ctot := 1) (a := 1) zero_le_one one_pos (fun _ => zero_le_one) (fun _ => zero_le_one)
    ?_ ?_ ?_
  · simpa using tendsto_one_div_atTop_nhds_zero_nat (𝕜 := ℝ)
  · filter_upwards [eventually_ge_atTop 1] with n hn
    have : (1:ℝ) ≤ (n : ℝ) := by exact_mod_cast hn
    linarith
  · filter_upwards [eventually_ge_atTop 0] with n _
    have hn : (0:ℝ) ≤ (n : ℝ) := Nat.cast_nonneg n
    unfold bs2
    nlinarith [hn]

/-- `tendstoInProb_condVar_of_concentration` on this model, with the variance of the
conditional-variance process strictly positive at every index. -/
theorem bridge_witness :
    (∀ δ : ℝ, 0 < δ → Tendsto (fun n => ((gmu bSite) {ω | δ ≤
        |(quadForm (gU bSite) wψ bsites brIdx (barr n) btag blam ω + bcell n) - 1|}).toReal)
      atTop (𝓝 0))
    ∧ (∀ n : ℕ, variance (quadForm (gU bSite) wψ bsites brIdx (barr n) btag blam) (gmu bSite)
        = bscale n ^ 4 / 4)
    ∧ (∀ n : ℕ, (0:ℝ) < bscale n ^ 4 / 4) := by
  refine ⟨?_, bvariance, fun n => by have := bscale_pos n; positivity⟩
  exact tendstoInProb_condVar_of_concentration
    (N := fun _ => bN) (S := fun _ _ => Unit) (Ix := fun _ => Unit) (tag := btag)
    (U := fun _ => gU bSite) (sites := fun _ => bsites) (rIdx := fun _ => brIdx)
    (arr := barr) (lev := blev) (pt := fun _ => bpt) (lam := blam) (cellc := bcell)
    (cutmax := fun n => 1 / bs2 n) (totmax := fun n => 1 / bs2 n)
    (Vn := fun n ω => quadForm (gU bSite) wψ bsites brIdx (barr n) btag blam ω + bcell n)
    (fun _ => gIsBasisSystem bSite) (fun _ => bHsite) (fun _ => bHptc) (fun _ => bHptf)
    (fun _ => bHpos) (fun _ => bHinj) (fun _ => bHsep) bHlam bHcut bHcutA bHtot bHnorm
    (fun _ => EventuallyEq.rfl) brate

end BridgeWitness

end WitnessBridge

end Var

/-! ### The remaining hypotheses of the truncation limit

This section derives the normalization `hnorm`, the lower bound `s_n²(L) ≥ n(c'S_nc − δ(L))`,
the second-moment bound `hsecond`, and the measurability and fourth-moment side conditions of the
martingale differences. The second moment of a degenerate sum is computed from the orthogonality
of completely degenerate terms, both for one component (`integral_degenSum_sq`) and for the pooled
sum over components (`integral_multiDegenSum_sq`). -/

namespace Step45

/-! #### The normalization `hnorm` -/

section Norm

variable {α β : Type*} [Fintype α] [Fintype β]

/-- Dividing every entry of a coefficient array by `a` divides `‖·‖_F²` by `a²`. -/
theorem rectFrobSq_div (F : α → β → ℝ) (a : ℝ) :
    rectFrobSq (fun s i => F s i / a) = rectFrobSq F / a ^ 2 := by
  simp only [rectFrobSq, div_pow, ← Finset.sum_div]

end Norm

section Norm2

variable {Γ : Type*} [Fintype Γ] {Ix : Type*} [Fintype Ix]
  {Sg : Γ → Type*} [∀ γ, Fintype (Sg γ)]

/-- `hnorm` from the definition of `s_n²(L)`: dividing the statistic by `s_n(L)` divides every
coefficient array by `√(s_n²(L))` and the cell term by `s_n²(L)`. The hypothesis `0 < s_n²(L)` is required. -/
theorem hnorm_of_scaling (lam : Γ → ℝ) (arrRaw : ∀ γ, Sg γ → Ix → ℝ) (cellRaw s2 : ℝ)
    (hs2 : s2 = (∑ γ, lam γ ^ 2 * rectFrobSq (arrRaw γ)) + cellRaw) (hpos : 0 < s2) :
    (∑ γ, lam γ ^ 2 * rectFrobSq (fun s i => arrRaw γ s i / Real.sqrt s2))
      + cellRaw / s2 = 1 := by
  have hsq : Real.sqrt s2 ^ 2 = s2 := Real.sq_sqrt hpos.le
  have h : ∀ γ : Γ, lam γ ^ 2 * rectFrobSq (fun s i => arrRaw γ s i / Real.sqrt s2)
      = lam γ ^ 2 * rectFrobSq (arrRaw γ) / s2 := by
    intro γ; rw [rectFrobSq_div, hsq]; ring
  rw [Finset.sum_congr rfl fun γ _ => h γ, ← Finset.sum_div, ← add_div, ← hs2]
  exact div_self hpos.ne'

end Norm2

/-! #### The lower bound `s_n²(L) ≥ n(c'S_nc − δ(L))` -/

section Rate

/-- `|s_n²(L)/n − c'S_nc| ≤ δ(L)` gives `s_n²(L) ≥ n(c'S_nc − δ(L))`. -/
theorem eventually_le_sq_mul_of_step4 {sc : ℕ → ℝ} {sig2 del : ℝ}
    (hstep4 : ∀ᶠ n : ℕ in atTop, |sc n ^ 2 - sig2| ≤ del) :
    ∀ᶠ n : ℕ in atTop, (sig2 - del) * (n : ℝ) ≤ sc n ^ 2 * n := by
  filter_upwards [hstep4] with n hn
  have h1 : sig2 - del ≤ sc n ^ 2 := by
    have h := abs_le.1 hn
    linarith [h.1]
  exact mul_le_mul_of_nonneg_right h1 (Nat.cast_nonneg n)

/-- `Var.rate_of_contraction` with the lower bound `hs2` derived from `hstep4`, for `L` large
enough that `δ(L) < c'Sc`. -/
theorem rate_of_contraction_of_step4 {B₀ : ℝ} {cΓ cK : ℕ}
    {cutraw totraw sc : ℕ → ℝ} {Ctot sig2 del : ℝ} (hCtot : 0 ≤ Ctot) (hdel : del < sig2)
    (hcutnn : ∀ n, 0 ≤ cutraw n) (htotnn : ∀ n, 0 ≤ totraw n)
    (hcut : Tendsto (fun n : ℕ => cutraw n / n) atTop (𝓝 0))
    (htot : ∀ᶠ n : ℕ in atTop, totraw n ≤ Ctot * n)
    (hstep4 : ∀ᶠ n : ℕ in atTop, |sc n ^ 2 - sig2| ≤ del) :
    Tendsto (fun n => Var.clauseBConst B₀ cΓ cK *
        (cutraw n / (sc n ^ 2 * n) * (totraw n / (sc n ^ 2 * n)))) atTop (𝓝 0) :=
  Var.rate_of_contraction (s2 := fun n => sc n ^ 2 * (n : ℝ)) (a := sig2 - del) hCtot
    (by linarith) hcutnn htotnn
    hcut htot (eventually_le_sq_mul_of_step4 hstep4)

end Rate

/-! #### The second moment of the truncated statistic -/

section Second

variable {Ω : Type*} {m0 : MeasurableSpace Ω} {μ : Measure Ω} [IsProbabilityMeasure μ]
  {V : Type*}

/-- A completely degenerate term is centred: `𝔼[g(U_t)] = 0`, which is `hdeg` at `e' = ∅`. -/
theorem integral_degenTerm_eq_zero {ι T : Type*} [Nonempty ι]
    {U : V → Ω → ℝ} {coord : T → ι → V} {g : (ι → ℝ) → ℝ}
    (hU : ∀ v, Measurable (U v)) {t : T}
    (hdeg : ∀ e' : Set ι, e' ≠ Set.univ →
      μ[degenTerm U coord g t | latentSigma U (coord t '' e')] =ᵐ[μ] 0) :
    ∫ ω, degenTerm U coord g t ω ∂μ = 0 := by
  have h := hdeg ∅ Set.empty_ne_univ
  rw [Set.image_empty] at h
  calc ∫ ω, degenTerm U coord g t ω ∂μ
      = ∫ ω, (μ[degenTerm U coord g t | latentSigma U (∅ : Set V)]) ω ∂μ :=
        (integral_condExp (latentSigma_le hU _)).symm
    _ = 0 := by rw [integral_congr_ae h]; simp

/-- The second moment of a degenerate sum of one component: `𝔼[T²] = ∑_tc_t²𝔼[g(U_t)²]`. -/
theorem integral_degenSum_sq {ι T : Type*} [Fintype ι] [Nonempty ι] [Fintype T]
    {U : V → Ω → ℝ} {coord : T → ι → V} {g : (ι → ℝ) → ℝ} {c : T → ℝ}
    (hU : ∀ v, Measurable (U v)) (hindep : iIndepFun U μ) (hg : Measurable g)
    (hsq : ∀ t, MemLp (degenTerm U coord g t) 2 μ)
    (hdeg : ∀ (t : T) (e' : Set ι), e' ≠ Set.univ →
      μ[degenTerm U coord g t | latentSigma U (coord t '' e')] =ᵐ[μ] 0)
    (hsep : ∀ t s : T, t ≠ s →
      (∃ k : ι, coord s k ∉ tupleSupport coord t) ∨
      (∃ k : ι, coord t k ∉ tupleSupport coord s)) :
    ∫ ω, degenSum U coord g c ω ^ 2 ∂μ
      = ∑ t : T, c t ^ 2 * ∫ ω, degenTerm U coord g t ω ^ 2 ∂μ := by
  classical
  have hmean : ∀ t : T, ∫ ω, degenTerm U coord g t ω ∂μ = 0 := fun t =>
    integral_degenTerm_eq_zero hU (hdeg t)
  have horth : ∀ t s : T, t ≠ s →
      ∫ ω, degenTerm U coord g t ω * degenTerm U coord g s ω ∂μ = 0 := fun t s hts =>
    Orth.integral_degenTerm_mul_eq_zero_of_or hU hindep hg hg (hdeg t) (hdeg s)
      (hsq t) (hsq s) (hsep t s hts)
  have hfun : degenSum U coord g c = fun ω => ∑ t : T, c t * degenTerm U coord g t ω :=
    funext fun ω => degenSum_apply U coord g c ω
  have hL2 : MemLp (degenSum U coord g c) 2 μ :=
    memLp_finsetSum' _ fun t _ => (hsq t).const_smul (c t)
  have hz : ∫ ω, degenSum U coord g c ω ∂μ = 0 := by
    rw [hfun, integral_finsetSum _ fun t _ => ((hsq t).integrable one_le_two).const_mul _]
    exact Finset.sum_eq_zero fun t _ => by rw [integral_const_mul, hmean t, mul_zero]
  rw [← variance_of_integral_eq_zero hL2.aemeasurable hz, hfun,
    variance_sum_of_uncorrelated (fun t => degenTerm U coord g t) c hsq hmean horth]

/-- The second moment of the pooled sum `multiDegenSum`. The orthogonality is applied over
the sigma type `Σ γ, 𝒯_{e_γ}`, covering pairs of sub-tuples in different components. -/
theorem integral_multiDegenSum_sq {Γ : Type*} [Fintype Γ] {ι : Γ → Type*} [∀ γ, Fintype (ι γ)]
    [∀ γ, Nonempty (ι γ)] {T : Γ → Type*} [∀ γ, Fintype (T γ)] [∀ γ, DecidableEq (T γ)]
    {U : V → Ω → ℝ} {coord : ∀ γ, T γ → ι γ → V} {g : ∀ γ, (ι γ → ℝ) → ℝ} {c : ∀ γ, T γ → ℝ}
    (hU : ∀ v, Measurable (U v)) (hindep : iIndepFun U μ) (hg : ∀ γ : Γ, Measurable (g γ))
    (hsq : ∀ (γ : Γ) (t : T γ), MemLp (degenTerm U (coord γ) (g γ) t) 2 μ)
    (hdeg : ∀ (γ : Γ) (t : T γ) (e' : Set (ι γ)), e' ≠ Set.univ →
      μ[degenTerm U (coord γ) (g γ) t | latentSigma U (coord γ t '' e')] =ᵐ[μ] 0)
    (hsep : ∀ (γ γ' : Γ) (t : T γ) (s : T γ'), (⟨γ, t⟩ : Σ q : Γ, T q) ≠ ⟨γ', s⟩ →
      (∃ k : ι γ', coord γ' s k ∉ tupleSupport (coord γ) t) ∨
      (∃ k : ι γ, coord γ t k ∉ tupleSupport (coord γ') s)) :
    ∫ ω, multiDegenSum U coord g c ω ^ 2 ∂μ
      = ∑ γ : Γ, ∑ t : T γ, c γ t ^ 2 * ∫ ω, degenTerm U (coord γ) (g γ) t ω ^ 2 ∂μ := by
  classical
  have hL2 : ∀ p : Σ q : Γ, T q, MemLp (degenTerm U (coord p.1) (g p.1) p.2) 2 μ :=
    fun p => hsq p.1 p.2
  have hmean : ∀ p : Σ q : Γ, T q, ∫ ω, degenTerm U (coord p.1) (g p.1) p.2 ω ∂μ = 0 :=
    fun p => integral_degenTerm_eq_zero hU (hdeg p.1 p.2)
  have horth : ∀ p q : Σ r : Γ, T r, p ≠ q →
      ∫ ω, degenTerm U (coord p.1) (g p.1) p.2 ω
        * degenTerm U (coord q.1) (g q.1) q.2 ω ∂μ = 0 := by
    rintro ⟨γ, t⟩ ⟨γ', s⟩ hpq
    exact Orth.integral_degenTerm_mul_eq_zero_of_or hU hindep (hg γ) (hg γ')
      (hdeg γ t) (hdeg γ' s) (hsq γ t) (hsq γ' s) (hsep γ γ' t s hpq)
  have hfun : multiDegenSum U coord g c
      = fun ω => ∑ p : Σ q : Γ, T q, c p.1 p.2 * degenTerm U (coord p.1) (g p.1) p.2 ω := by
    funext ω
    rw [multiDegenSum_apply, ← Finset.univ_sigma_univ, Finset.sum_sigma]
  have hML : MemLp (multiDegenSum U coord g c) 2 μ := by
    rw [hfun]
    exact memLp_finsetSum _ fun p _ => (hL2 p).const_mul _
  have hz : ∫ ω, multiDegenSum U coord g c ω ∂μ = 0 := by
    rw [hfun, integral_finsetSum _ fun p _ => ((hL2 p).integrable one_le_two).const_mul _]
    exact Finset.sum_eq_zero fun p _ => by rw [integral_const_mul, hmean p, mul_zero]
  rw [← variance_of_integral_eq_zero hML.aemeasurable hz, hfun,
    variance_sum_of_uncorrelated (fun p : Σ q : Γ, T q => degenTerm U (coord p.1) (g p.1) p.2)
      (fun p => c p.1 p.2) hL2 hmean horth,
    ← Finset.univ_sigma_univ, Finset.sum_sigma]

/-- With kernel terms of unit second moment, `𝔼[(T_n(L)/s_n(L))²] ≤ 1` reduces to
`∑_tc_t² ≤ 1`. -/
theorem hsecond_of_coefficients {ι T : Type*} [Fintype ι] [Nonempty ι] [Fintype T]
    {U : V → Ω → ℝ} {coord : T → ι → V} {g : (ι → ℝ) → ℝ} {c : T → ℝ}
    (hU : ∀ v, Measurable (U v)) (hindep : iIndepFun U μ) (hg : Measurable g)
    (hsq : ∀ t, MemLp (degenTerm U coord g t) 2 μ)
    (hdeg : ∀ (t : T) (e' : Set ι), e' ≠ Set.univ →
      μ[degenTerm U coord g t | latentSigma U (coord t '' e')] =ᵐ[μ] 0)
    (hsep : ∀ t s : T, t ≠ s →
      (∃ k : ι, coord s k ∉ tupleSupport coord t) ∨
      (∃ k : ι, coord t k ∉ tupleSupport coord s))
    (hone : ∀ t : T, ∫ ω, degenTerm U coord g t ω ^ 2 ∂μ = 1)
    (hc : ∑ t : T, c t ^ 2 ≤ 1) :
    ∫ ω, degenSum U coord g c ω ^ 2 ∂μ ≤ 1 := by
  rw [integral_degenSum_sq hU hindep hg hsq hdeg hsep]
  refine le_trans (le_of_eq ?_) hc
  exact Finset.sum_congr rfl fun t _ => by rw [hone t, mul_one]

end Second

/-! #### Measurability and fourth moments of the differences -/

section Side

variable {Ω : Type*} {m0 : MeasurableSpace Ω} {μ : Measure Ω} [IsProbabilityMeasure μ]
  {V ι T : Type*} [Fintype ι] [Fintype T] [DecidableEq T]
  {U : V → Ω → ℝ} {coord : T → ι → V} {g : (ι → ℝ) → ℝ} {c : T → ℝ} {step : V → ℕ}

omit [IsProbabilityMeasure μ] [Fintype ι] [DecidableEq T] in
/-- `D_κ` is measurable: it is a difference of conditional expectations. -/
theorem measurable_degenDiff (hU : ∀ v, Measurable (U v)) (κ : ℕ) :
    Measurable (degenDiff μ U coord g c step κ) :=
  ((stronglyMeasurable_condExp.mono (latentSigma_le hU _)).measurable).sub
    ((stronglyMeasurable_condExp.mono (latentSigma_le hU _)).measurable)

/-- `|D_κ| ≤ (∑_t|c_t|)B` almost surely, given a bound `B` on the kernel. -/
theorem ae_abs_degenDiff_le {B : ℝ} (hB : 0 ≤ B) (hU : ∀ v, Measurable (U v))
    (hindep : iIndepFun U μ) (hg : Measurable g)
    (hint : ∀ t, Integrable (degenTerm U coord g t) μ)
    (hdeg : ∀ (t : T) (e' : Set ι), e' ≠ Set.univ →
      μ[degenTerm U coord g t | latentSigma U (coord t '' e')] =ᵐ[μ] 0)
    (hbd : ∀ t, ∀ᵐ ω ∂μ, |degenTerm U coord g t ω| ≤ B) (κ : ℕ) :
    ∀ᵐ ω ∂μ, |degenDiff μ U coord g c step κ ω| ≤ (∑ t : T, |c t|) * B := by
  filter_upwards [degenDiff_eq_sum_completedAt (c := c) hU hindep hg hint hdeg κ,
    ae_all_iff.2 hbd] with ω hω hbdω
  rw [hω]
  calc |∑ t ∈ completedAt coord step κ, c t * degenTerm U coord g t ω|
      ≤ ∑ t ∈ completedAt coord step κ, |c t * degenTerm U coord g t ω| :=
        Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ t ∈ completedAt coord step κ, |c t| * B := by
        refine Finset.sum_le_sum fun t _ => ?_
        rw [abs_mul]
        exact mul_le_mul_of_nonneg_left (hbdω t) (abs_nonneg _)
    _ ≤ ∑ t : T, |c t| * B :=
        Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _)
          (fun t _ _ => mul_nonneg (abs_nonneg _) hB)
    _ = (∑ t : T, |c t|) * B := by rw [Finset.sum_mul]

/-- `𝔼[D_κ⁴] < ∞`. -/
theorem integrable_pow_four_degenDiff {B : ℝ} (hB : 0 ≤ B) (hU : ∀ v, Measurable (U v))
    (hindep : iIndepFun U μ) (hg : Measurable g)
    (hint : ∀ t, Integrable (degenTerm U coord g t) μ)
    (hdeg : ∀ (t : T) (e' : Set ι), e' ≠ Set.univ →
      μ[degenTerm U coord g t | latentSigma U (coord t '' e')] =ᵐ[μ] 0)
    (hbd : ∀ t, ∀ᵐ ω ∂μ, |degenTerm U coord g t ω| ≤ B) (κ : ℕ) :
    Integrable (fun ω => degenDiff μ U coord g c step κ ω ^ 4) μ := by
  refine Integrable.mono' (g := fun _ => ((∑ t : T, |c t|) * B) ^ 4) (integrable_const _)
    (((measurable_degenDiff hU κ).pow_const 4).aestronglyMeasurable) ?_
  filter_upwards [ae_abs_degenDiff_le (c := c) (step := step) hB hU hindep hg hint hdeg hbd κ]
    with ω hω
  rw [Real.norm_eq_abs, abs_pow]
  exact pow_le_pow_left₀ (abs_nonneg _) hω 4

end Side

/-! #### Examples -/

section WitnessStep45

/-- `hnorm_of_scaling` at a design where neither term of the `s_n²(L)` display vanishes:
two components with `‖W^{(e_γ)}_c‖_F² = 4` and a cell term of `1`, so `s_n²(L) = 9`. -/
theorem norm_witness :
    (∑ _γ : Fin 2, (1:ℝ) ^ 2 *
        rectFrobSq (fun (_ : Fin 1) (_ : Fin 1) => (2:ℝ) / Real.sqrt 9)) + (1:ℝ) / 9 = 1 :=
  hnorm_of_scaling (Sg := fun _ : Fin 2 => Fin 1) (Ix := Fin 1) (fun _ => 1)
    (fun _ _ _ => 2) 1 9 (by simp [rectFrobSq]; norm_num) (by norm_num)

/-- `rate_of_contraction_of_step4` with every hypothesis verified and the constant taken at
`B_0 = 2`, `|Γ| = 3`, `M = 2`. -/
theorem rate_witness :
    Tendsto (fun n : ℕ => Var.clauseBConst 2 3 2 *
      (1 / ((1:ℝ) ^ 2 * n) * (((n : ℝ) + 1) / ((1:ℝ) ^ 2 * n)))) atTop (𝓝 0) := by
  refine rate_of_contraction_of_step4 (B₀ := 2) (cΓ := 3) (cK := 2)
    (cutraw := fun _ => 1) (totraw := fun n => (n : ℝ) + 1) (sc := fun _ => 1)
    (Ctot := 2) (sig2 := 1) (del := 1/2) (by norm_num) (by norm_num)
    (fun _ => zero_le_one) (fun n => by positivity) ?_ ?_ ?_
  · simpa using tendsto_one_div_atTop_nhds_zero_nat (𝕜 := ℝ)
  · filter_upwards [eventually_ge_atTop 1] with n hn
    have h : (1:ℝ) ≤ (n : ℝ) := by exact_mod_cast hn
    linarith
  · filter_upwards with n
    norm_num

end WitnessStep45

end Step45


/-! ### The tensor-product basis expansion on the site model

This section connects `Multiway.TensorBasis` with the site model. When the latent variables are
independent with a common law and `coord t` is injective, the latent tuple pushes `P` forward to
`Measure.pi` (`map_latentTuple_eq_pi`), so moments of kernel terms are `L²` norms of kernels. It
then derives `IsBasisSystem` from a uniformly bounded orthonormal system, the complete
degeneracy and unit second moments of product kernels, the moments of the truncated kernel
`h^{(e)}_L` and of its tail, the variance comparison `abs_varcomp_le`, `δ(L) → 0`, and the
one-step factorization `D^γ_κ = ψ_{r_{k⋆}}(U^{(k⋆)}_i)·A^γ_i`. -/

namespace Step2

open DegenerateSum
open scoped InnerProductSpace

variable {Ω : Type*} {m0 : MeasurableSpace Ω} {P : Measure Ω}
variable {V ι T : Type*} [Fintype ι]

/-! #### The law of the latent tuple -/

theorem map_latentTuple_eq_pi {U : V → Ω → ℝ} (hU : ∀ v, Measurable (U v))
    (hindep : iIndepFun U P) {ν : Measure ℝ} (hlaw : ∀ v, P.map (U v) = ν)
    {coord : T → ι → V} {t : T} (hinj : Function.Injective (coord t)) :
    P.map (latentTuple U coord t) = Measure.pi (fun _ : ι => ν) := by
  have hpre : iIndepFun (fun i : ι => U (coord t i)) P := hindep.precomp hinj
  have h := hpre.map_fun_eq_pi_map (fun i => (hU (coord t i)).aemeasurable)
  have hL : latentTuple U coord t = fun ω i => U (coord t i) ω := rfl
  rw [hL, h]
  exact congrArg Measure.pi (funext fun i => hlaw _)

omit [Fintype ι] in
theorem measurable_latentTuple {U : V → Ω → ℝ} (hU : ∀ v, Measurable (U v))
    (coord : T → ι → V) (t : T) : Measurable (latentTuple U coord t) :=
  Measurable.of_eval fun i => hU (coord t i)

theorem integral_comp_latentTuple {U : V → Ω → ℝ} (hU : ∀ v, Measurable (U v))
    (hindep : iIndepFun U P) {ν : Measure ℝ} (hlaw : ∀ v, P.map (U v) = ν)
    {coord : T → ι → V} {t : T} (hinj : Function.Injective (coord t))
    {F : (ι → ℝ) → ℝ} (hF : AEStronglyMeasurable F (Measure.pi (fun _ : ι => ν))) :
    ∫ ω, F (latentTuple U coord t ω) ∂P = ∫ u, F u ∂(Measure.pi (fun _ : ι => ν)) := by
  have hmap := map_latentTuple_eq_pi hU hindep hlaw hinj
  have hm : AEMeasurable (latentTuple U coord t) P :=
    (measurable_latentTuple hU coord t).aemeasurable
  rw [← integral_map hm (by rw [hmap]; exact hF), hmap]

/-- `∫ (x u)^2 dν = ‖x‖^2`. -/
theorem integral_sq_coeFn_eq_norm_sq {α : Type*} [MeasurableSpace α] (ν : Measure α)
    (x : Lp ℝ 2 ν) : ∫ u, (x : α → ℝ) u ^ 2 ∂ν = ‖x‖ ^ 2 := by
  have h := MeasureTheory.L2.inner_def (𝕜 := ℝ) x x
  rw [real_inner_self_eq_norm_sq] at h
  rw [h]
  refine integral_congr_ae (Eventually.of_forall fun u => ?_)
  simp only [real_inner_self_eq_norm_sq, Real.norm_eq_abs, sq_abs]

/-- The second moment of a kernel term is the `L²` norm of the kernel. -/
theorem integral_degenTerm_sq_eq_norm_sq {U : V → Ω → ℝ} (hU : ∀ v, Measurable (U v))
    (hindep : iIndepFun U P) {ν : Measure ℝ} (hlaw : ∀ v, P.map (U v) = ν)
    {coord : T → ι → V} {t : T} (hinj : Function.Injective (coord t))
    (x : Lp ℝ 2 (Measure.pi (fun _ : ι => ν))) {G : (ι → ℝ) → ℝ} (hGm : Measurable G)
    (hG : G =ᵐ[Measure.pi (fun _ : ι => ν)] (x : (ι → ℝ) → ℝ)) :
    ∫ ω, degenTerm U coord G t ω ^ 2 ∂P = ‖x‖ ^ 2 := by
  have h1 : ∫ ω, degenTerm U coord G t ω ^ 2 ∂P
      = ∫ u, G u ^ 2 ∂(Measure.pi (fun _ : ι => ν)) :=
    integral_comp_latentTuple hU hindep hlaw hinj (F := fun u => G u ^ 2)
      ((hGm.pow_const 2).aestronglyMeasurable)
  rw [h1, ← integral_sq_coeFn_eq_norm_sq]
  refine integral_congr_ae (hG.mono fun u hu => ?_)
  show G u ^ 2 = (x : (ι → ℝ) → ℝ) u ^ 2
  rw [hu]

/-! #### `IsBasisSystem` from a one-dimensional orthonormal system -/

section BasisSystem

variable {R : Type*} [DecidableEq R]

theorem isBasisSystem_of_law {U : V → Ω → ℝ} {ψ : R → ℝ → ℝ} {Rpos : Set R} {B₀ : ℝ}
    {ν : Measure ℝ} (hU : ∀ v, Measurable (U v)) (hψ : ∀ r, Measurable (ψ r))
    (hindep : iIndepFun U P) (hlaw : ∀ v, P.map (U v) = ν)
    (hbd : ∀ r x, |ψ r x| ≤ B₀)
    (hzero : ∀ r ∈ Rpos, ∫ x, ψ r x ∂ν = 0)
    (hortho : ∀ r r', ∫ x, ψ r x * ψ r' x ∂ν = if r = r' then (1 : ℝ) else 0) :
    IsBasisSystem P U ψ Rpos B₀ where
  measurable_latent := hU
  measurable_psi := hψ
  indep := hindep
  bound := hbd
  integral_eq_zero := by
    intro v r hr
    have h : ∫ y, ψ r y ∂(P.map (U v)) = ∫ ω, ψ r (U v ω) ∂P :=
      integral_map (hU v).aemeasurable (hψ r).aestronglyMeasurable
    rw [← h, hlaw v]
    exact hzero r hr
  integral_mul := by
    intro v r r'
    have h : ∫ y, ψ r y * ψ r' y ∂(P.map (U v)) = ∫ ω, ψ r (U v ω) * ψ r' (U v ω) ∂P :=
      integral_map (hU v).aemeasurable (((hψ r).mul (hψ r')).aestronglyMeasurable)
    rw [← h, hlaw v]
    exact hortho r r'

/-- A uniformly bounded orthonormal system `{ψ_r}` gives `IsBasisSystem`. -/
theorem isBasisSystem_of_hilbertBasis {U : V → Ω → ℝ} {ψ : R → ℝ → ℝ} {Rpos : Set R} {B₀ : ℝ}
    {ν : Measure ℝ} [IsProbabilityMeasure ν] (b : HilbertBasis R ℝ (Lp ℝ 2 ν))
    (hU : ∀ v, Measurable (U v)) (hψ : ∀ r, Measurable (ψ r))
    (hindep : iIndepFun U P) (hlaw : ∀ v, P.map (U v) = ν)
    (hbd : ∀ r x, |ψ r x| ≤ B₀)
    (hrep : ∀ r, (b r : ℝ → ℝ) =ᵐ[ν] ψ r)
    (hzero : ∀ r ∈ Rpos, ∫ x, ψ r x ∂ν = 0) :
    IsBasisSystem P U ψ Rpos B₀ := by
  refine isBasisSystem_of_law hU hψ hindep hlaw hbd hzero fun r r' => ?_
  have hinner : ⟪b r, b r'⟫_ℝ = if r = r' then (1 : ℝ) else 0 :=
    orthonormal_iff_ite.1 b.orthonormal r r'
  rw [MeasureTheory.L2.inner_def] at hinner
  rw [← hinner]
  refine integral_congr_ae ?_
  filter_upwards [hrep r, hrep r'] with x h1 h2
  show ψ r x * ψ r' x = ⟪(b r : ℝ → ℝ) x, (b r' : ℝ → ℝ) x⟫_ℝ
  rw [h1, h2, real_inner_comm]
  rfl

end BasisSystem

/-! #### The product kernel `⨂_k ψ_{r_k}` -/

section ProdKernel

variable {R : Type*}

/-- The product kernel `⨂_{k ∈ e} ψ_{r_k}`, as a function of the latent tuple. -/
def prodKernel (ψ : R → ℝ → ℝ) (ρ : ι → R) : (ι → ℝ) → ℝ := fun u => ∏ i, ψ (ρ i) (u i)

theorem prodKernel_apply (ψ : R → ℝ → ℝ) (ρ : ι → R) (u : ι → ℝ) :
    prodKernel ψ ρ u = ∏ i, ψ (ρ i) (u i) := rfl

theorem measurable_prodKernel {ψ : R → ℝ → ℝ} (hψ : ∀ r, Measurable (ψ r)) (ρ : ι → R) :
    Measurable (prodKernel ψ ρ) :=
  Finset.measurable_prod _ fun i _ => (hψ (ρ i)).comp (measurable_pi_apply i)

theorem abs_prodKernel_le {ψ : R → ℝ → ℝ} {B₀ : ℝ} (hbd : ∀ r x, |ψ r x| ≤ B₀) (ρ : ι → R)
    (u : ι → ℝ) : |prodKernel ψ ρ u| ≤ max B₀ 1 ^ Fintype.card ι := by
  calc |prodKernel ψ ρ u| = ∏ i, |ψ (ρ i) (u i)| := Finset.abs_prod _ _
    _ ≤ ∏ _i : ι, max B₀ 1 :=
        Finset.prod_le_prod₀ (fun i _ => abs_nonneg _)
          (fun i _ => le_trans (hbd _ _) (le_max_left _ _))
    _ = max B₀ 1 ^ Fintype.card ι := by rw [Finset.prod_const, Finset.card_univ]

/-- The factorization `D^γ_κ = ψ_{r_{k⋆}}(U^{(k⋆)}_i)·A^γ_i` at one coordinate, before
conditioning. -/
theorem prodKernel_split [DecidableEq ι] (ψ : R → ℝ → ℝ) (ρ : ι → R) (j : ι) (u : ι → ℝ) :
    prodKernel ψ ρ u = ψ (ρ j) (u j) * ∏ i ∈ Finset.univ.erase j, ψ (ρ i) (u i) :=
  (Finset.mul_prod_erase Finset.univ (fun i => ψ (ρ i) (u i)) (Finset.mem_univ j)).symm

/-- The same split, written on the latent variables themselves. -/
theorem degenTerm_prodKernel_split [DecidableEq ι] (U : V → Ω → ℝ) (coord : T → ι → V)
    (ψ : R → ℝ → ℝ) (ρ : ι → R) (t : T) (j : ι) (ω : Ω) :
    degenTerm U coord (prodKernel ψ ρ) t ω
      = ψ (ρ j) (U (coord t j) ω) *
        ∏ i ∈ Finset.univ.erase j, ψ (ρ i) (U (coord t i) ω) :=
  prodKernel_split ψ ρ j (latentTuple U coord t ω)

end ProdKernel

/-! #### Complete degeneracy and unit second moment -/

section Degeneracy

variable {R : Type*} [DecidableEq R] [IsProbabilityMeasure P]
variable {U : V → Ω → ℝ} {ψ : R → ℝ → ℝ} {Rpos : Set R} {B₀ : ℝ}

/-- Pull out a factor measurable for the conditioning field and remove the other by
independence, at arbitrary σ-fields. -/
private theorem condExp_mul_eq_zero_of_indep {α : Type*} {mα : MeasurableSpace α}
    {Q : Measure α} [IsFiniteMeasure Q] {𝒢 𝒵 : MeasurableSpace α}
    (h𝒢 : 𝒢 ≤ mα) (h𝒵 : 𝒵 ≤ mα) {Y Z : α → ℝ}
    (hY : StronglyMeasurable[𝒢] Y) (hZ : StronglyMeasurable[𝒵] Z)
    (hYZ : Integrable (Y * Z) Q) (hZi : Integrable Z Q)
    (hind : Indep 𝒵 𝒢 Q) (hz : ∫ ω, Z ω ∂Q = 0) :
    Q[Y * Z | 𝒢] =ᵐ[Q] 0 := by
  have h0 : Q[Z | 𝒢] =ᵐ[Q] 0 :=
    (condExp_indep_eq h𝒵 h𝒢 hZ hind).trans (by filter_upwards with _; exact hz)
  have hpull := condExp_mul_of_stronglyMeasurable_left (μ := Q) hY hYZ hZi
  filter_upwards [hpull, h0] with ω h1 h2
  rw [h1]
  simp only [Pi.mul_apply, h2, mul_zero, Pi.zero_apply]

variable [DecidableEq ι]

/-- A product of mean-zero basis factors over distinct latent variables conditions to zero on
any proper sub-collection of its coordinates. -/
theorem condExp_degenTerm_prodKernel_eq_zero (h : IsBasisSystem P U ψ Rpos B₀)
    {coord : T → ι → V} {t : T} (hinj : Function.Injective (coord t))
    {ρ : ι → R} (hρ : ∀ i, ρ i ∈ Rpos) (e' : Set ι) (hne : e' ≠ Set.univ) :
    P[degenTerm U coord (prodKernel ψ ρ) t | latentSigma U (coord t '' e')] =ᵐ[P] 0 := by
  classical
  obtain ⟨j, hj⟩ : ∃ j : ι, j ∉ e' := by
    by_contra hcon
    exact hne (Set.eq_univ_of_forall fun k => not_not.mp fun hk => hcon ⟨k, hk⟩)
  set w : V := coord t j with hw
  set Y : Ω → ℝ := fun ω => ∏ i ∈ Finset.univ.erase j, ψ (ρ i) (U (coord t i) ω) with hY
  set Z : Ω → ℝ := fun ω => ψ (ρ j) (U w ω) with hZ
  have hsplit : degenTerm U coord (prodKernel ψ ρ) t = Y * Z := by
    funext ω
    rw [degenTerm_prodKernel_split U coord ψ ρ t j ω]
    exact mul_comm _ _
  -- `Y` is measurable for the latent variables other than `w`
  have hYm' : Measurable[latentSigma U ({w}ᶜ : Set V)] Y := by
    refine Finset.measurable_prod _ fun i hi => ?_
    have hne' : coord t i ≠ w := by
      intro hcon
      exact (Finset.mem_erase.1 hi).1 (hinj (hcon.trans hw))
    exact (h.measurable_psi (ρ i)).comp
      (measurable_latentSigma U (S := ({w}ᶜ : Set V)) hne')
  have hYm : StronglyMeasurable[latentSigma U ({w}ᶜ : Set V)] Y := hYm'.stronglyMeasurable
  have hZm : StronglyMeasurable[latentSigma U ({w} : Set V)] Z :=
    ((h.measurable_psi (ρ j)).comp
      (measurable_latentSigma U (S := ({w} : Set V)) rfl)).stronglyMeasurable
  have hZmeas : Measurable Z := (h.measurable_psi (ρ j)).comp (h.measurable_latent w)
  have hYmeas : Measurable Y :=
    Finset.measurable_prod _ fun i _ =>
      (h.measurable_psi (ρ i)).comp (h.measurable_latent (coord t i))
  have hbdZ : ∀ ω, |Z ω| ≤ max B₀ 1 := fun ω => le_trans (h.bound _ _) (le_max_left _ _)
  have hbdY : ∀ ω, |Y ω| ≤ max B₀ 1 ^ Fintype.card ι := by
    intro ω
    calc |Y ω| = ∏ i ∈ Finset.univ.erase j, |ψ (ρ i) (U (coord t i) ω)| := Finset.abs_prod _ _
      _ ≤ ∏ _i ∈ Finset.univ.erase j, max B₀ 1 :=
          Finset.prod_le_prod₀ (fun i _ => abs_nonneg _)
            (fun i _ => le_trans (h.bound _ _) (le_max_left _ _))
      _ = max B₀ 1 ^ (Finset.univ.erase j).card := by rw [Finset.prod_const]
      _ ≤ max B₀ 1 ^ Fintype.card ι :=
          pow_le_pow_right₀ (le_max_right _ _) (le_trans (Finset.card_le_univ _) (le_refl _))
  have hZi : Integrable Z P :=
    Integrable.mono' (g := fun _ => max B₀ 1) (integrable_const _)
      hZmeas.aestronglyMeasurable (Eventually.of_forall fun ω => by
        rw [Real.norm_eq_abs]; exact hbdZ ω)
  have hYZi : Integrable (Y * Z) P := by
    refine Integrable.mono' (g := fun _ => max B₀ 1 ^ Fintype.card ι * max B₀ 1)
      (integrable_const _) (hYmeas.mul hZmeas).aestronglyMeasurable
      (Eventually.of_forall fun ω => ?_)
    rw [Real.norm_eq_abs, Pi.mul_apply, abs_mul]
    exact mul_le_mul (hbdY ω) (hbdZ ω) (abs_nonneg _)
      (pow_nonneg (le_trans zero_le_one (le_max_right _ _)) _)
  -- the conditional expectation given all latent variables except `w` is zero
  have hcompl : P[degenTerm U coord (prodKernel ψ ρ) t | latentSigma U ({w}ᶜ : Set V)]
      =ᵐ[P] 0 := by
    rw [hsplit]
    exact condExp_mul_eq_zero_of_indep (latentSigma_le h.measurable_latent _)
      (latentSigma_le h.measurable_latent _) hYm hZm hYZi hZi
      (latentSigma_indep h.measurable_latent h.indep
        (S := ({w} : Set V)) (S' := ({w}ᶜ : Set V)) disjoint_compl_right)
      (h.integral_eq_zero w (hρ j))
  -- the conditioning field of the statement is smaller
  have hsub : coord t '' e' ⊆ ({w}ᶜ : Set V) := by
    rintro _ ⟨i, hi, rfl⟩
    simp only [Set.mem_compl_iff, Set.mem_singleton_iff]
    intro hcon
    have hij : i = j := hinj (hcon.trans hw)
    exact hj (hij ▸ hi)
  have hmono : latentSigma U (coord t '' e') ≤ latentSigma U ({w}ᶜ : Set V) :=
    latentSigma_mono U hsub
  have hle2 : latentSigma U ({w}ᶜ : Set V) ≤ m0 := latentSigma_le h.measurable_latent _
  have hsf : SigmaFinite (P.trim hle2) := by
    have : IsFiniteMeasure (P.trim hle2) := isFiniteMeasure_trim hle2
    infer_instance
  have htower := condExp_condExp_of_le (μ := P)
    (f := degenTerm U coord (prodKernel ψ ρ) t) hmono hle2
  refine htower.symm.trans ?_
  refine (condExp_congr_ae hcompl).trans ?_
  rw [condExp_zero]

omit [IsProbabilityMeasure P] [DecidableEq ι] in
/-- `𝔼[(⨂_kψ_{r_k})(U_t)²] = 1`, by orthonormality. -/
theorem integral_degenTerm_prodKernel_sq (h : IsBasisSystem P U ψ Rpos B₀)
    {coord : T → ι → V} {t : T} (hinj : Function.Injective (coord t)) (ρ : ι → R) :
    ∫ ω, degenTerm U coord (prodKernel ψ ρ) t ω ^ 2 ∂P = 1 := by
  have hpre : iIndepFun (fun i : ι => U (coord t i)) P := h.indep.precomp hinj
  have hfm : ∀ i : ι, Measurable (fun x : ℝ => ψ (ρ i) x * ψ (ρ i) x) :=
    fun i => (h.measurable_psi (ρ i)).mul (h.measurable_psi (ρ i))
  have hprod := hpre.integral_fun_prod_comp
    (f := fun i => fun x : ℝ => ψ (ρ i) x * ψ (ρ i) x)
    (fun i => (h.measurable_latent (coord t i)).aemeasurable)
    (fun i => (hfm i).aestronglyMeasurable)
  have hpt : ∀ ω, degenTerm U coord (prodKernel ψ ρ) t ω ^ 2
      = ∏ i : ι, (ψ (ρ i) (U (coord t i) ω) * ψ (ρ i) (U (coord t i) ω)) := by
    intro ω
    rw [Finset.prod_mul_distrib, ← pow_two]
    rfl
  rw [integral_congr_ae (Eventually.of_forall hpt), hprod]
  refine Finset.prod_eq_one fun i _ => ?_
  rw [h.integral_mul (coord t i) (ρ i) (ρ i)]
  simp

omit [DecidableEq ι] in
/-- The kernel term is bounded, hence square-integrable. -/
theorem memLp_degenTerm_prodKernel (h : IsBasisSystem P U ψ Rpos B₀)
    (coord : T → ι → V) (t : T) (ρ : ι → R) :
    MemLp (degenTerm U coord (prodKernel ψ ρ) t) 2 P := by
  have hm : Measurable (degenTerm U coord (prodKernel ψ ρ) t) :=
    (measurable_prodKernel h.measurable_psi ρ).comp
      (measurable_latentTuple h.measurable_latent coord t)
  refine (memLp_two_iff_integrable_sq hm.aestronglyMeasurable).2 ?_
  refine Integrable.mono' (g := fun _ => (max B₀ 1 ^ Fintype.card ι) ^ 2)
    (integrable_const _) ((hm.pow_const 2).aestronglyMeasurable)
    (Eventually.of_forall fun ω => ?_)
  rw [Real.norm_eq_abs, abs_pow]
  exact pow_le_pow_left₀ (abs_nonneg _)
    (abs_prodKernel_le h.bound ρ (latentTuple U coord t ω)) 2

end Degeneracy

/-! #### The truncated kernel `h^{(e)}_L` -/

section Truncation

variable {R : Type*} [DecidableEq R]
variable {U : V → Ω → ℝ} {ψ : R → ℝ → ℝ} {Rpos : Set R} {B₀ : ℝ}

/-- The truncated kernel `h^{(e)}_L := ∑_{𝐫 : max_k r_k ≤ L} λ^{(e)}_𝐫 ⨂_k ψ_{r_k}`, as a
function of the latent tuple. -/
def kernelTrunc (ψ : R → ℝ → ℝ) (lam : (ι → R) → ℝ) (F : Finset (ι → R)) : (ι → ℝ) → ℝ :=
  fun u => ∑ r ∈ F, lam r * prodKernel ψ r u

omit [DecidableEq R] in
theorem measurable_kernelTrunc (hψ : ∀ r, Measurable (ψ r)) (lam : (ι → R) → ℝ)
    (F : Finset (ι → R)) : Measurable (kernelTrunc ψ lam F) :=
  Finset.measurable_sum _ fun r _ => (measurable_prodKernel hψ r).const_mul _

omit [DecidableEq R] in
theorem degenTerm_kernelTrunc (U : V → Ω → ℝ) (coord : T → ι → V) (ψ : R → ℝ → ℝ)
    (lam : (ι → R) → ℝ) (F : Finset (ι → R)) (t : T) (ω : Ω) :
    degenTerm U coord (kernelTrunc ψ lam F) t ω
      = ∑ r ∈ F, lam r * degenTerm U coord (prodKernel ψ r) t ω := rfl

variable [DecidableEq ι] [IsProbabilityMeasure P]

/-- The truncated kernel is completely degenerate, being a finite sum of completely
degenerate product terms. -/
theorem condExp_degenTerm_kernelTrunc_eq_zero (h : IsBasisSystem P U ψ Rpos B₀)
    {coord : T → ι → V} {t : T} (hinj : Function.Injective (coord t))
    {lam : (ι → R) → ℝ} {F : Finset (ι → R)} (hρ : ∀ r ∈ F, ∀ i, r i ∈ Rpos)
    (e' : Set ι) (hne : e' ≠ Set.univ) :
    P[degenTerm U coord (kernelTrunc ψ lam F) t | latentSigma U (coord t '' e')] =ᵐ[P] 0 := by
  have hint : ∀ r ∈ F, Integrable (lam r • degenTerm U coord (prodKernel ψ r) t) P :=
    fun r _ => ((memLp_degenTerm_prodKernel h coord t r).integrable one_le_two).smul _
  have hfun : degenTerm U coord (kernelTrunc ψ lam F) t
      = ∑ r ∈ F, lam r • degenTerm U coord (prodKernel ψ r) t := by
    funext ω
    rw [degenTerm_kernelTrunc]
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
  have hzero : ∀ r ∈ F, ∀ᵐ ω ∂P,
      (P[lam r • degenTerm U coord (prodKernel ψ r) t |
        latentSigma U (coord t '' e')]) ω = 0 := by
    intro r hr
    have hsm := condExp_smul (μ := P) (lam r) (degenTerm U coord (prodKernel ψ r) t)
      (latentSigma U (coord t '' e'))
    filter_upwards [hsm,
      condExp_degenTerm_prodKernel_eq_zero h hinj (hρ r hr) e' hne] with ω hω hω0
    rw [hω]
    simp only [Pi.smul_apply, hω0, Pi.zero_apply, smul_zero]
  rw [hfun]
  refine (condExp_finsetSum hint _).trans ?_
  filter_upwards [(Filter.eventually_all_finset F).2 hzero] with ω hω
  simp only [Finset.sum_apply, Pi.zero_apply]
  exact Finset.sum_eq_zero fun r hr => hω r hr

end Truncation

/-! #### Identification with `Multiway.TensorBasis` -/

section Identify

variable {R : Type*} [DecidableEq R] [DecidableEq ι]
variable {ψ : R → ℝ → ℝ} {ν : Measure ℝ} [IsProbabilityMeasure ν]

/-- The representative of a finite sum in `Lp` is a.e. the pointwise sum. -/
theorem coeFn_finsetSum {α E J : Type*} [MeasurableSpace α] {μ : Measure α}
    [NormedAddCommGroup E] (s : Finset J) (f : J → Lp E 2 μ) :
    ((∑ j ∈ s, f j : Lp E 2 μ) : α → E) =ᵐ[μ] fun a => ∑ j ∈ s, (f j : α → E) a := by
  classical
  induction s using Finset.induction with
  | empty =>
      simp only [Finset.sum_empty]
      exact Lp.coeFn_zero E 2 μ
  | insert j s hj ih =>
      rw [Finset.sum_insert hj]
      filter_upwards [Lp.coeFn_add (f j) (∑ k ∈ s, f k), ih] with a h1 h2
      rw [h1]
      simp only [Pi.add_apply, h2, Finset.sum_insert hj]

omit [DecidableEq R] [DecidableEq ι] in
/-- The `Lp` element `⨂_k ψ_{r_k}` of `Multiway.TensorBasis` has the pointwise product as its
representative. -/
theorem coeFn_tensorBasisProd (b : HilbertBasis R ℝ (Lp ℝ 2 ν))
    (hrep : ∀ r, (b r : ℝ → ℝ) =ᵐ[ν] ψ r) (ρ : ι → R) :
    ((TensorBasis.basisProd (fun _ : ι => b) ρ : Lp ℝ 2 (Measure.pi (fun _ : ι => ν))) :
        (ι → ℝ) → ℝ)
      =ᵐ[Measure.pi (fun _ : ι => ν)] prodKernel ψ ρ := by
  have hdef : TensorBasis.basisProd (fun _ : ι => b) ρ
      = TensorBasis.tensorLp (fun i : ι => b (ρ i)) := rfl
  have hco := TensorBasis.coeFn_tensorLp (μ := fun _ : ι => ν) (fun i : ι => b (ρ i))
  have hcoord : ∀ᵐ u ∂(Measure.pi (fun _ : ι => ν)), ∀ i : ι,
      (b (ρ i) : ℝ → ℝ) (u i) = ψ (ρ i) (u i) := by
    rw [ae_all_iff]
    intro i
    exact (Measure.quasiMeasurePreserving_eval (fun _ : ι => ν) i).ae (hrep (ρ i))
  rw [hdef]
  filter_upwards [hco, hcoord] with u h0 h1
  rw [h0]
  show ∏ i : ι, (b (ρ i) : ℝ → ℝ) (u i) = ∏ i : ι, ψ (ρ i) (u i)
  exact Finset.prod_congr rfl fun i _ => h1 i

omit [DecidableEq R] in
/-- The truncation `trunc` of `Multiway.TensorBasis` has the finite sum
`∑_{𝐫 ∈ F} λ_𝐫 ∏_k ψ_{r_k}` as its representative, with `λ_𝐫 = ⟪⨂_kψ_{r_k}, h⟫`. -/
theorem coeFn_trunc_eq_kernelTrunc (b : HilbertBasis R ℝ (Lp ℝ 2 ν))
    (hrep : ∀ r, (b r : ℝ → ℝ) =ᵐ[ν] ψ r) (x : Lp ℝ 2 (Measure.pi (fun _ : ι => ν)))
    (F : Finset (ι → R)) :
    ((TensorBasis.trunc (TensorBasis.prodHilbertBasis (fun _ : ι => b)) x F :
        Lp ℝ 2 (Measure.pi (fun _ : ι => ν))) : (ι → ℝ) → ℝ)
      =ᵐ[Measure.pi (fun _ : ι => ν)]
        kernelTrunc ψ (fun r => ⟪TensorBasis.basisProd (fun _ : ι => b) r, x⟫_ℝ) F := by
  classical
  rw [TensorBasis.trunc_prodHilbertBasis]
  have hterm : ∀ r ∈ F, ∀ᵐ u ∂(Measure.pi (fun _ : ι => ν)),
      ((⟪TensorBasis.basisProd (fun _ : ι => b) r, x⟫_ℝ •
          TensorBasis.basisProd (fun _ : ι => b) r :
          Lp ℝ 2 (Measure.pi (fun _ : ι => ν))) : (ι → ℝ) → ℝ) u
        = ⟪TensorBasis.basisProd (fun _ : ι => b) r, x⟫_ℝ * prodKernel ψ r u := by
    intro r _
    filter_upwards [Lp.coeFn_smul (⟪TensorBasis.basisProd (fun _ : ι => b) r, x⟫_ℝ)
        (TensorBasis.basisProd (fun _ : ι => b) r),
      coeFn_tensorBasisProd b hrep r] with u h1 h2
    rw [h1]
    simp only [Pi.smul_apply, h2, smul_eq_mul]
  filter_upwards [coeFn_finsetSum F
      (fun r => ⟪TensorBasis.basisProd (fun _ : ι => b) r, x⟫_ℝ •
        TensorBasis.basisProd (fun _ : ι => b) r),
    (Filter.eventually_all_finset F).2 hterm] with u h0 h1
  rw [h0]
  exact Finset.sum_congr rfl fun r hr => h1 r hr

end Identify

/-! #### Moments of `h^{(e)}_L` and of the tail `h^{(e)} - h^{(e)}_L` -/

section Moments

variable {R : Type*} [DecidableEq R] [DecidableEq ι] [IsProbabilityMeasure P]
variable {U : V → Ω → ℝ} {ψ : R → ℝ → ℝ} {ν : Measure ℝ} [IsProbabilityMeasure ν]

omit [DecidableEq R] [IsProbabilityMeasure P] in
/-- `𝔼[h^{(e)}_L(U_t)²] = ‖h^{(e)}_L‖² = σ_e² - τ_e²(L)`. -/
theorem integral_degenTerm_kernelTrunc_sq (hU : ∀ v, Measurable (U v))
    (hindep : iIndepFun U P) (hlaw : ∀ v, P.map (U v) = ν)
    {coord : T → ι → V} {t : T} (hinj : Function.Injective (coord t))
    (b : HilbertBasis R ℝ (Lp ℝ 2 ν)) (hψ : ∀ r, Measurable (ψ r))
    (hrep : ∀ r, (b r : ℝ → ℝ) =ᵐ[ν] ψ r) (x : Lp ℝ 2 (Measure.pi (fun _ : ι => ν)))
    (F : Finset (ι → R)) :
    ∫ ω, degenTerm U coord
        (kernelTrunc ψ (fun r => ⟪TensorBasis.basisProd (fun _ : ι => b) r, x⟫_ℝ) F) t ω ^ 2 ∂P
      = ‖TensorBasis.trunc (TensorBasis.prodHilbertBasis (fun _ : ι => b)) x F‖ ^ 2 :=
  integral_degenTerm_sq_eq_norm_sq hU hindep hlaw hinj _
    (measurable_kernelTrunc hψ _ F) (coeFn_trunc_eq_kernelTrunc b hrep x F).symm

omit [DecidableEq R] [IsProbabilityMeasure P] in
/-- `𝔼[(h^{(e)} - h^{(e)}_L)(U_t)²] = ‖h - h_L‖² = τ_e²(L)`, which does not depend on `n`. -/
theorem integral_degenTerm_sub_kernelTrunc_sq (hU : ∀ v, Measurable (U v))
    (hindep : iIndepFun U P) (hlaw : ∀ v, P.map (U v) = ν)
    {coord : T → ι → V} {t : T} (hinj : Function.Injective (coord t))
    (b : HilbertBasis R ℝ (Lp ℝ 2 ν)) (hψ : ∀ r, Measurable (ψ r))
    (hrep : ∀ r, (b r : ℝ → ℝ) =ᵐ[ν] ψ r) (x : Lp ℝ 2 (Measure.pi (fun _ : ι => ν)))
    {G : (ι → ℝ) → ℝ} (hGm : Measurable G)
    (hG : G =ᵐ[Measure.pi (fun _ : ι => ν)] (x : (ι → ℝ) → ℝ)) (F : Finset (ι → R)) :
    ∫ ω, degenTerm U coord
        (G - kernelTrunc ψ (fun r => ⟪TensorBasis.basisProd (fun _ : ι => b) r, x⟫_ℝ) F)
        t ω ^ 2 ∂P
      = ‖x - TensorBasis.trunc (TensorBasis.prodHilbertBasis (fun _ : ι => b)) x F‖ ^ 2 := by
  refine integral_degenTerm_sq_eq_norm_sq hU hindep hlaw hinj _
    (hGm.sub (measurable_kernelTrunc hψ _ F)) ?_
  filter_upwards [hG, (coeFn_trunc_eq_kernelTrunc b hrep x F),
    Lp.coeFn_sub x (TensorBasis.trunc (TensorBasis.prodHilbertBasis (fun _ : ι => b)) x F)]
    with u h1 h2 h3
  show G u - kernelTrunc ψ _ F u = _
  rw [h3]
  simp only [Pi.sub_apply, h1, h2]

omit [DecidableEq R] [IsProbabilityMeasure P] in
/-- `σ_e² = (σ_e² - τ_e²(L)) + τ_e²(L)` on the moments: Pythagoras against the truncated
span. -/
theorem integral_degenTerm_pythagoras (hU : ∀ v, Measurable (U v))
    (hindep : iIndepFun U P) (hlaw : ∀ v, P.map (U v) = ν)
    {coord : T → ι → V} {t : T} (hinj : Function.Injective (coord t))
    (b : HilbertBasis R ℝ (Lp ℝ 2 ν)) (hψ : ∀ r, Measurable (ψ r))
    (hrep : ∀ r, (b r : ℝ → ℝ) =ᵐ[ν] ψ r) (x : Lp ℝ 2 (Measure.pi (fun _ : ι => ν)))
    {G : (ι → ℝ) → ℝ} (hGm : Measurable G)
    (hG : G =ᵐ[Measure.pi (fun _ : ι => ν)] (x : (ι → ℝ) → ℝ)) (F : Finset (ι → R)) :
    (∫ ω, degenTerm U coord
        (kernelTrunc ψ (fun r => ⟪TensorBasis.basisProd (fun _ : ι => b) r, x⟫_ℝ) F) t ω ^ 2 ∂P)
      + (∫ ω, degenTerm U coord
        (G - kernelTrunc ψ (fun r => ⟪TensorBasis.basisProd (fun _ : ι => b) r, x⟫_ℝ) F)
        t ω ^ 2 ∂P)
      = ∫ ω, degenTerm U coord G t ω ^ 2 ∂P := by
  rw [integral_degenTerm_kernelTrunc_sq hU hindep hlaw hinj b hψ hrep x F,
    integral_degenTerm_sub_kernelTrunc_sq hU hindep hlaw hinj b hψ hrep x hGm hG F,
    integral_degenTerm_sq_eq_norm_sq hU hindep hlaw hinj x hGm hG]
  exact TensorBasis.norm_sq_trunc_add_norm_sq_sub _ x F

end Moments

/-! #### The variance comparison and `δ(L) → 0` -/

section Varcomp

/-- The variance comparison: `s_n²(L)` and `n c'S_nc` are the same finite sum with coefficients
`σ_e² - τ_e²(L)` and `σ_e²`, so their difference divided by `n` is
`n^{-1}∑_eτ_e²(L)‖W^{(e)}_c‖_F² ≤ δ(L)`. -/
theorem abs_varcomp_le {E : Type*} (Es : Finset E) (sig tau W : E → ℝ) (cell n Cw : ℝ)
    (hn : 0 < n) (htau : ∀ e ∈ Es, 0 ≤ tau e) (hW : ∀ e ∈ Es, 0 ≤ W e)
    (hWb : ∀ e ∈ Es, W e ≤ Cw * n) :
    |((∑ e ∈ Es, (sig e - tau e) * W e) + cell) / n
        - ((∑ e ∈ Es, sig e * W e) + cell) / n|
      ≤ Cw * ∑ e ∈ Es, tau e := by
  have hkey : (∑ e ∈ Es, (sig e - tau e) * W e)
      = (∑ e ∈ Es, sig e * W e) - ∑ e ∈ Es, tau e * W e := by
    rw [← Finset.sum_sub_distrib]
    exact Finset.sum_congr rfl fun e _ => by ring
  have hnn : 0 ≤ ∑ e ∈ Es, tau e * W e :=
    Finset.sum_nonneg fun e he => mul_nonneg (htau e he) (hW e he)
  have hrw : ((∑ e ∈ Es, (sig e - tau e) * W e) + cell) / n
        - ((∑ e ∈ Es, sig e * W e) + cell) / n
      = -((∑ e ∈ Es, tau e * W e) / n) := by
    rw [hkey]
    field_simp
    ring
  rw [hrw, abs_neg, abs_of_nonneg (div_nonneg hnn hn.le), div_le_iff₀ hn]
  calc ∑ e ∈ Es, tau e * W e ≤ ∑ e ∈ Es, tau e * (Cw * n) :=
        Finset.sum_le_sum fun e he => mul_le_mul_of_nonneg_left (hWb e he) (htau e he)
    _ = Cw * (∑ e ∈ Es, tau e) * n := by rw [← Finset.sum_mul]; ring

/-- `δ(L) → 0`, from `τ_e(L) → 0` at each of the finitely many levels. -/
theorem tendsto_delta {E : Type*} (Es : Finset E) (Cw : ℝ) (tau : E → ℕ → ℝ)
    (h : ∀ e ∈ Es, Tendsto (tau e) atTop (𝓝 0)) :
    Tendsto (fun L => Cw * ∑ e ∈ Es, tau e L) atTop (𝓝 0) := by
  have hs : Tendsto (fun L => ∑ e ∈ Es, tau e L) atTop (𝓝 (∑ _e ∈ Es, (0 : ℝ))) :=
    tendsto_finsetSum Es fun e he => h e he
  rw [Finset.sum_const, smul_zero] at hs
  simpa using hs.const_mul Cw

/-- `τ_e²(L) → 0`, with the truncation taken at the box `max_k r_k ≤ L`. -/
theorem tendsto_normSq_sub_truncBox {Λ : Type*} [Fintype Λ] [DecidableEq Λ]
    {𝕜 F : Type*} [RCLike 𝕜] [NormedAddCommGroup F] [InnerProductSpace 𝕜 F]
    (B : HilbertBasis (Λ → ℕ) 𝕜 F) (x : F) :
    Tendsto (fun L => ‖x - TensorBasis.trunc B x (TensorBasis.box Λ L)‖ ^ 2) atTop (𝓝 0) := by
  have h := (TensorBasis.tendsto_norm_sub_truncBox B x).pow 2
  simpa using h

end Varcomp

/-! #### `hsecond` at a general second moment -/

section Second

variable [Nonempty ι] [Fintype T] [IsProbabilityMeasure P]

/-- `Step45.hsecond_of_coefficients` with a general common second moment
`𝔼[g(U_t)²]` in place of `1`. -/
theorem hsecond_of_moment {U : V → Ω → ℝ} {coord : T → ι → V} {g : (ι → ℝ) → ℝ} {c : T → ℝ}
    {mom : ℝ} (hU : ∀ v, Measurable (U v)) (hindep : iIndepFun U P) (hg : Measurable g)
    (hsq : ∀ t, MemLp (degenTerm U coord g t) 2 P)
    (hdeg : ∀ (t : T) (e' : Set ι), e' ≠ Set.univ →
      P[degenTerm U coord g t | latentSigma U (coord t '' e')] =ᵐ[P] 0)
    (hsep : ∀ t s : T, t ≠ s →
      (∃ k : ι, coord s k ∉ tupleSupport coord t) ∨
      (∃ k : ι, coord t k ∉ tupleSupport coord s))
    (hmom : ∀ t : T, ∫ ω, degenTerm U coord g t ω ^ 2 ∂P = mom)
    (hc : (∑ t : T, c t ^ 2) * mom ≤ 1) :
    ∫ ω, degenSum U coord g c ω ^ 2 ∂P ≤ 1 := by
  rw [Step45.integral_degenSum_sq hU hindep hg hsq hdeg hsep]
  refine le_trans (le_of_eq ?_) hc
  rw [Finset.sum_mul]
  exact Finset.sum_congr rfl fun t _ => by rw [hmom t]

end Second

/-! #### Factorization of the martingale differences -/

section Factorize

variable {R : Type*} [DecidableEq R] [DecidableEq ι] [Fintype T] [DecidableEq T]
variable [IsProbabilityMeasure P] {U : V → Ω → ℝ} {ψ : R → ℝ → ℝ} {Rpos : Set R} {B₀ : ℝ}

omit [Fintype T] [DecidableEq T] in
theorem latentSigma_singleton (U : V → Ω → ℝ) (v : V) :
    latentSigma U ({v} : Set V) = MeasurableSpace.comap (U v) inferInstance := by
  simp [latentSigma]

/-- `D^γ_κ = ψ_{r_{k⋆}}(U^{(k⋆)}_i)·A^γ_i` at the step revealing `U^{(k⋆)}_i`, with
`A^γ_i = ∑_s w^{(e)}_{c,(s,i)}∏_{k ∈ e∖{k⋆}}ψ_{r_k}(U^{(k)}_{s_k})`. The hypothesis `hw` says that
the coordinates of a sub-tuple other than `t_{k⋆}` are revealed before the block of dimension
`k⋆` begins. -/
theorem degenDiff_prodKernel_factor (h : IsBasisSystem P U ψ Rpos B₀)
    {coord : T → ι → V} (hinj : ∀ t, Function.Injective (coord t))
    {ρ : ι → R} (hρ : ∀ i, ρ i ∈ Rpos) {c : T → ℝ} {step : V → ℕ} (κ : ℕ)
    {kstar : ι} {w : V} (hw : ∀ t ∈ completedAt coord step κ, coord t kstar = w) :
    degenDiff P U coord (prodKernel ψ ρ) c step κ
      =ᵐ[P] fun ω => ψ (ρ kstar) (U w ω) *
        ∑ t ∈ completedAt coord step κ, c t *
          ∏ i ∈ Finset.univ.erase kstar, ψ (ρ i) (U (coord t i) ω) := by
  filter_upwards [degenDiff_eq_sum_completedAt (c := c) h.measurable_latent h.indep
    (measurable_prodKernel h.measurable_psi ρ)
    (fun t => (memLp_degenTerm_prodKernel h coord t ρ).integrable one_le_two)
    (fun t e' hne => condExp_degenTerm_prodKernel_eq_zero h (hinj t) hρ e' hne) κ] with ω hω
  rw [hω, Finset.mul_sum]
  refine Finset.sum_congr rfl fun t ht => ?_
  rw [degenTerm_prodKernel_split U coord ψ ρ t kstar ω, hw t ht]
  ring

omit [IsProbabilityMeasure P] in
/-- `A^γ_i` is `ℱ_{κ-1}`-measurable. -/
theorem stronglyMeasurable_blockA (h : IsBasisSystem P U ψ Rpos B₀)
    {coord : T → ι → V} {ρ : ι → R} {c : T → ℝ} {step : V → ℕ} {κ : ℕ} {kstar : ι}
    (hrev : ∀ t ∈ completedAt coord step κ, ∀ i, i ≠ kstar → step (coord t i) < κ) :
    StronglyMeasurable[latentSigma U (revealed step κ)]
      (fun ω => ∑ t ∈ completedAt coord step κ, c t *
        ∏ i ∈ Finset.univ.erase kstar, ψ (ρ i) (U (coord t i) ω)) := by
  have hm : Measurable[latentSigma U (revealed step κ)]
      (fun ω => ∑ t ∈ completedAt coord step κ, c t *
        ∏ i ∈ Finset.univ.erase kstar, ψ (ρ i) (U (coord t i) ω)) := by
    refine Finset.measurable_sum _ fun t ht => ?_
    refine Measurable.const_mul ?_ _
    refine Finset.measurable_prod _ fun i hi => ?_
    exact (h.measurable_psi (ρ i)).comp
      (measurable_latentSigma U (S := revealed step κ)
        (hrev t ht i (Finset.mem_erase.1 hi).1))
  exact hm.stronglyMeasurable

omit [DecidableEq T] [IsProbabilityMeasure P] in
/-- `|A^γ_i|` is bounded, which gives the integrability used below. -/
theorem abs_blockA_le (h : IsBasisSystem P U ψ Rpos B₀)
    {coord : T → ι → V} {ρ : ι → R} {c : T → ℝ} {S : Finset T} {kstar : ι} (ω : Ω) :
    |∑ t ∈ S, c t * ∏ i ∈ Finset.univ.erase kstar, ψ (ρ i) (U (coord t i) ω)|
      ≤ (∑ t : T, |c t|) * max B₀ 1 ^ Fintype.card ι := by
  classical
  calc |∑ t ∈ S, c t * ∏ i ∈ Finset.univ.erase kstar, ψ (ρ i) (U (coord t i) ω)|
      ≤ ∑ t ∈ S, |c t * ∏ i ∈ Finset.univ.erase kstar, ψ (ρ i) (U (coord t i) ω)| :=
        Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ t ∈ S, |c t| * max B₀ 1 ^ Fintype.card ι := by
        refine Finset.sum_le_sum fun t _ => ?_
        rw [abs_mul]
        refine mul_le_mul_of_nonneg_left ?_ (abs_nonneg _)
        calc |∏ i ∈ Finset.univ.erase kstar, ψ (ρ i) (U (coord t i) ω)|
            = ∏ i ∈ Finset.univ.erase kstar, |ψ (ρ i) (U (coord t i) ω)| :=
              Finset.abs_prod _ _
          _ ≤ ∏ _i ∈ Finset.univ.erase kstar, max B₀ 1 :=
              Finset.prod_le_prod₀ (fun i _ => abs_nonneg _)
                (fun i _ => le_trans (h.bound _ _) (le_max_left _ _))
          _ = max B₀ 1 ^ (Finset.univ.erase kstar).card := by rw [Finset.prod_const]
          _ ≤ max B₀ 1 ^ Fintype.card ι :=
              pow_le_pow_right₀ (le_max_right _ _) (Finset.card_le_univ _)
    _ ≤ ∑ t : T, |c t| * max B₀ 1 ^ Fintype.card ι :=
        Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _)
          (fun t _ _ => mul_nonneg (abs_nonneg _)
            (pow_nonneg (le_trans zero_le_one (le_max_right _ _)) _))
    _ = (∑ t : T, |c t|) * max B₀ 1 ^ Fintype.card ι := by rw [Finset.sum_mul]

/-- The one-step conditional variance: once each component's difference is factored as
`ψ_{ρ(γ)}(U_w)·A_γ`, the conditional variance is the quadratic form with the orthonormality
indicator. The components may have different arities. -/
theorem condExp_sq_step_of_prodKernel (h : IsBasisSystem P U ψ Rpos B₀)
    {Γ : Type*} [Fintype Γ] {step : V → ℕ} {κ : ℕ} {w : V} (hw : κ ≤ step w)
    {lam : Γ → ℝ} {ρ' : Γ → R} {A D : Γ → Ω → ℝ} {CA : ℝ}
    (hA : ∀ γ, StronglyMeasurable[latentSigma U (revealed step κ)] (A γ))
    (hAmeas : ∀ γ, Measurable (A γ)) (hAbd : ∀ γ ω, |A γ ω| ≤ CA)
    (hfac : ∀ γ, D γ =ᵐ[P] fun ω => ψ (ρ' γ) (U w ω) * A γ ω) :
    P[fun ω => (∑ γ, lam γ * D γ ω) ^ 2 | latentSigma U (revealed step κ)]
      =ᵐ[P] fun ω => ∑ γ, ∑ γ', lam γ * lam γ' *
        (if ρ' γ = ρ' γ' then (1 : ℝ) else 0) * (A γ ω * A γ' ω) := by
  classical
  have hcong : (fun ω => (∑ γ, lam γ * D γ ω) ^ 2)
      =ᵐ[P] fun ω => (∑ γ, lam γ * (ψ (ρ' γ) (U w ω) * A γ ω)) ^ 2 := by
    filter_upwards [(Filter.eventually_all_finset (Finset.univ : Finset Γ)).2
      (fun γ _ => hfac γ)] with ω hω
    congr 1
    exact Finset.sum_congr rfl fun γ _ => by rw [hω γ (Finset.mem_univ γ)]
  refine (condExp_congr_ae hcong).trans ?_
  have hind : Indep (MeasurableSpace.comap (U w) (inferInstance : MeasurableSpace ℝ))
      (latentSigma U (revealed step κ)) P := by
    rw [← latentSigma_singleton U w]
    exact latentSigma_indep h.measurable_latent h.indep
      (S := ({w} : Set V)) (S' := revealed step κ)
      (Set.disjoint_singleton_left.2 (by simp [revealed, Nat.not_lt.2 hw]))
  have hAint : ∀ γ γ' : Γ, Integrable (fun ω => A γ ω * A γ' ω) P := by
    intro γ γ'
    refine Integrable.mono' (g := fun _ => CA * CA) (integrable_const _)
      ((hAmeas γ).mul (hAmeas γ')).aestronglyMeasurable (Eventually.of_forall fun ω => ?_)
    rw [Real.norm_eq_abs, abs_mul]
    exact mul_le_mul (hAbd γ ω) (hAbd γ' ω) (abs_nonneg _)
      (le_trans (abs_nonneg _) (hAbd γ ω))
  exact Var.condExp_sq_step (latentSigma_le h.measurable_latent _) (h.measurable_latent w)
    h.measurable_psi h.bound (h.integral_mul w) hind lam ρ' A hA hAint

end Factorize

end Step2

/-! ### The conditional-variance algebra over all steps

For the pooled kernel `multiKernel ψ ρ lam = ∑_γ λ_γ ⨂_kψ_{r_k(γ)}`, this section sums the
one-step conditional variances over `κ` (`condVar_eq_blockQuad`), identifies the blocks with
`cvarEntry` of `Multiway.Concentration` (`blockSum_eq_blockA`, `quadForm_eq_blockQuad`), and
derives `halg` for the latent array (`halg_of_multiKernel`, with cell constant `0`), `hstep4`
from the variance comparison (`hstep4_of_varcomp`), and `hstep5` from the tail kernels
(`hstep5_of_tail`, `hstep5_of_tail_multi`). The bound in `hstep4` holds eventually at any `D`
strictly above `δ(L)`. -/

namespace Alg

open DegenerateSum Step2 Var StatLean.TimeSeries

variable {Ω : Type*} {m0 : MeasurableSpace Ω} {μ : Measure Ω}
variable {V ι T : Type*} [Fintype ι] [DecidableEq ι] [Fintype T] [DecidableEq T]
variable {R : Type*} [DecidableEq R] {ψ : R → ℝ → ℝ} {Rpos : Set R} {B₀ : ℝ}
variable {Γ : Type*} [Fintype Γ] [DecidableEq Γ]

/-! #### The pooled kernel `∑_γ λ_γ ⨂_k ψ_{r_k(γ)}` -/

/-- The truncated kernel `∑_{𝐫}λ^{(e)}_𝐫⨂_kψ_{r_k}`, written over a `Fintype` of components. -/
def multiKernel (ψ : R → ℝ → ℝ) (ρ : Γ → ι → R) (lam : Γ → ℝ) : (ι → ℝ) → ℝ :=
  fun u => ∑ γ, lam γ * prodKernel ψ (ρ γ) u

/-- The pooled kernel is `Step2.kernelTrunc`, with the retained multi-indices as
components. -/
theorem multiKernel_eq_kernelTrunc (ψ : R → ℝ → ℝ) (lam : (ι → R) → ℝ) (F : Finset (ι → R)) :
    multiKernel (Γ := {r // r ∈ F}) ψ (fun γ => (γ : ι → R)) (fun γ => lam (γ : ι → R))
      = kernelTrunc ψ lam F := by
  funext u
  show ∑ γ : {r // r ∈ F}, lam (γ : ι → R) * prodKernel ψ (γ : ι → R) u
      = ∑ r ∈ F, lam r * prodKernel ψ r u
  rw [← Finset.sum_coe_sort F (fun r => lam r * prodKernel ψ r u)]

theorem measurable_multiKernel (hψ : ∀ r, Measurable (ψ r)) (ρ : Γ → ι → R) (lam : Γ → ℝ) :
    Measurable (multiKernel ψ ρ lam) :=
  Finset.measurable_sum _ fun γ _ => (measurable_prodKernel hψ (ρ γ)).const_mul _

theorem degenTerm_multiKernel (U : V → Ω → ℝ) (coord : T → ι → V) (ψ : R → ℝ → ℝ)
    (ρ : Γ → ι → R) (lam : Γ → ℝ) (t : T) (ω : Ω) :
    degenTerm U coord (multiKernel ψ ρ lam) t ω
      = ∑ γ, lam γ * degenTerm U coord (prodKernel ψ (ρ γ)) t ω := rfl

variable {U : V → Ω → ℝ}

theorem memLp_degenTerm_multiKernel [IsProbabilityMeasure μ]
    (h : IsBasisSystem μ U ψ Rpos B₀) (coord : T → ι → V) (t : T) (ρ : Γ → ι → R)
    (lam : Γ → ℝ) : MemLp (degenTerm U coord (multiKernel ψ ρ lam) t) 2 μ := by
  have hfun : degenTerm U coord (multiKernel ψ ρ lam) t
      = ∑ γ : Γ, lam γ • degenTerm U coord (prodKernel ψ (ρ γ)) t := by
    funext ω
    rw [degenTerm_multiKernel]
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
  rw [hfun]
  exact memLp_finsetSum' _ fun γ _ => (memLp_degenTerm_prodKernel h coord t (ρ γ)).const_smul _

/-- The pooled kernel is completely degenerate. -/
theorem condExp_degenTerm_multiKernel_eq_zero [IsProbabilityMeasure μ]
    (h : IsBasisSystem μ U ψ Rpos B₀)
    {coord : T → ι → V} {t : T} (hinj : Function.Injective (coord t))
    {ρ : Γ → ι → R} (hρ : ∀ γ i, ρ γ i ∈ Rpos) {lam : Γ → ℝ}
    (e' : Set ι) (hne : e' ≠ Set.univ) :
    μ[degenTerm U coord (multiKernel ψ ρ lam) t | latentSigma U (coord t '' e')] =ᵐ[μ] 0 := by
  have hint : ∀ γ : Γ, Integrable (lam γ • degenTerm U coord (prodKernel ψ (ρ γ)) t) μ :=
    fun γ => ((memLp_degenTerm_prodKernel h coord t (ρ γ)).integrable one_le_two).smul _
  have hfun : degenTerm U coord (multiKernel ψ ρ lam) t
      = ∑ γ : Γ, lam γ • degenTerm U coord (prodKernel ψ (ρ γ)) t := by
    funext ω
    rw [degenTerm_multiKernel]
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
  have hzero : ∀ γ : Γ, ∀ᵐ ω ∂μ,
      (μ[lam γ • degenTerm U coord (prodKernel ψ (ρ γ)) t |
        latentSigma U (coord t '' e')]) ω = 0 := by
    intro γ
    have hsm := condExp_smul (μ := μ) (lam γ) (degenTerm U coord (prodKernel ψ (ρ γ)) t)
      (latentSigma U (coord t '' e'))
    filter_upwards [hsm,
      condExp_degenTerm_prodKernel_eq_zero h hinj (hρ γ) e' hne] with ω hω hω0
    rw [hω]
    simp only [Pi.smul_apply, hω0, Pi.zero_apply, smul_zero]
  rw [hfun]
  refine (condExp_finsetSum (fun γ _ => hint γ) _).trans ?_
  filter_upwards [ae_all_iff.2 hzero] with ω hω
  simp only [Finset.sum_apply, Pi.zero_apply]
  exact Finset.sum_eq_zero fun γ _ => hω γ

/-! #### The blocks `A^γ_i` and the factorization of the pooled difference -/

/-- `A^γ_i := ∑_sw^{(e)}_{c,(s,i)}∏_{k ∈ e∖{k⋆}}ψ_{r_k}(U^{(k)}_{s_k})`, at the step `κ` that
completes the sub-tuples it sums over. -/
noncomputable def blockA (U : V → Ω → ℝ) (coord : T → ι → V) (ψ : R → ℝ → ℝ) (ρ : Γ → ι → R)
    (c : T → ℝ) (step : V → ℕ) (kstar : ι) (γ : Γ) (κ : ℕ) : Ω → ℝ :=
  fun ω => ∑ t ∈ completedAt coord step κ, c t *
    ∏ i ∈ Finset.univ.erase kstar, ψ (ρ γ i) (U (coord t i) ω)

/-- `D_κ = ∑_γλ_γψ_{r_{k⋆}(γ)}(U^{(k⋆)}_i)A^γ_i` at the step revealing `U^{(k⋆)}_i`. -/
theorem degenDiff_multiKernel_factor [IsProbabilityMeasure μ]
    (h : IsBasisSystem μ U ψ Rpos B₀)
    {coord : T → ι → V} (hinj : ∀ t, Function.Injective (coord t))
    {ρ : Γ → ι → R} (hρ : ∀ γ i, ρ γ i ∈ Rpos) {lam : Γ → ℝ} {c : T → ℝ} {step : V → ℕ}
    (κ : ℕ) {kstar : ι} {w : V} (hw : ∀ t ∈ completedAt coord step κ, coord t kstar = w) :
    degenDiff μ U coord (multiKernel ψ ρ lam) c step κ
      =ᵐ[μ] fun ω => ∑ γ, lam γ *
        (ψ (ρ γ kstar) (U w ω) * blockA U coord ψ ρ c step kstar γ κ ω) := by
  filter_upwards [degenDiff_eq_sum_completedAt (c := c) h.measurable_latent h.indep
    (measurable_multiKernel h.measurable_psi ρ lam)
    (fun t => (memLp_degenTerm_multiKernel h coord t ρ lam).integrable one_le_two)
    (fun t e' hne => condExp_degenTerm_multiKernel_eq_zero h (hinj t) hρ e' hne) κ] with ω hω
  rw [hω]
  have hterm : ∀ t ∈ completedAt coord step κ,
      c t * degenTerm U coord (multiKernel ψ ρ lam) t ω
        = ∑ γ, lam γ * (ψ (ρ γ kstar) (U w ω) *
            (c t * ∏ i ∈ Finset.univ.erase kstar, ψ (ρ γ i) (U (coord t i) ω))) := by
    intro t ht
    rw [degenTerm_multiKernel, Finset.mul_sum]
    refine Finset.sum_congr rfl fun γ _ => ?_
    rw [degenTerm_prodKernel_split U coord ψ (ρ γ) t kstar ω, hw t ht]
    ring
  rw [Finset.sum_congr rfl hterm, Finset.sum_comm]
  refine Finset.sum_congr rfl fun γ _ => ?_
  show ∑ t ∈ completedAt coord step κ, lam γ * (ψ (ρ γ kstar) (U w ω) *
      (c t * ∏ i ∈ Finset.univ.erase kstar, ψ (ρ γ i) (U (coord t i) ω)))
    = lam γ * (ψ (ρ γ kstar) (U w ω) * ∑ t ∈ completedAt coord step κ, c t *
      ∏ i ∈ Finset.univ.erase kstar, ψ (ρ γ i) (U (coord t i) ω))
  simp only [Finset.mul_sum]

/-- The one-step conditional variance of the pooled difference, with the orthonormality
indicator. -/
theorem condExp_sq_degenDiff [IsProbabilityMeasure μ] (h : IsBasisSystem μ U ψ Rpos B₀)
    {coord : T → ι → V} (hinj : ∀ t, Function.Injective (coord t))
    {ρ : Γ → ι → R} (hρ : ∀ γ i, ρ γ i ∈ Rpos) {lam : Γ → ℝ} {c : T → ℝ} {step : V → ℕ}
    (κ : ℕ) {kstar : ι} {w : V} (hw : ∀ t ∈ completedAt coord step κ, coord t kstar = w)
    (hwstep : κ ≤ step w)
    (hrev : ∀ t ∈ completedAt coord step κ, ∀ i, i ≠ kstar → step (coord t i) < κ) :
    μ[fun ω => degenDiff μ U coord (multiKernel ψ ρ lam) c step κ ω ^ 2 |
        latentSigma U (revealed step κ)]
      =ᵐ[μ] fun ω => ∑ γ, ∑ γ', lam γ * lam γ' *
        (if ρ γ kstar = ρ γ' kstar then (1 : ℝ) else 0) *
        (blockA U coord ψ ρ c step kstar γ κ ω * blockA U coord ψ ρ c step kstar γ' κ ω) := by
  classical
  have hAsm : ∀ γ : Γ, StronglyMeasurable[latentSigma U (revealed step κ)]
      (blockA U coord ψ ρ c step kstar γ κ) := fun γ =>
    stronglyMeasurable_blockA h (ρ := ρ γ) (c := c) hrev
  have hAmeas : ∀ γ : Γ, Measurable (blockA U coord ψ ρ c step kstar γ κ) := fun γ =>
    ((hAsm γ).measurable.mono (latentSigma_le h.measurable_latent _) le_rfl)
  have hAbd : ∀ (γ : Γ) (ω : Ω), |blockA U coord ψ ρ c step kstar γ κ ω|
      ≤ (∑ t : T, |c t|) * max B₀ 1 ^ Fintype.card ι := fun γ ω =>
    abs_blockA_le h (coord := coord) (ρ := ρ γ) (c := c) ω
  have hcong : (fun ω => degenDiff μ U coord (multiKernel ψ ρ lam) c step κ ω ^ 2)
      =ᵐ[μ] fun ω => (∑ γ, lam γ *
        (ψ (ρ γ kstar) (U w ω) * blockA U coord ψ ρ c step kstar γ κ ω)) ^ 2 := by
    filter_upwards [degenDiff_multiKernel_factor h hinj hρ κ hw] with ω hω
    rw [hω]
  refine (condExp_congr_ae hcong).trans ?_
  exact condExp_sq_step_of_prodKernel h hwstep (lam := lam) (ρ' := fun γ => ρ γ kstar)
    (A := fun γ => blockA U coord ψ ρ c step kstar γ κ)
    (D := fun γ ω => ψ (ρ γ kstar) (U w ω) * blockA U coord ψ ρ c step kstar γ κ ω)
    hAsm hAmeas hAbd (fun _ => EventuallyEq.rfl)

/-! #### Summation over the steps -/

/-- `∑_κ𝔼[D_κ²∣ℱ_{κ-1}]` is the quadratic form in the blocks. -/
theorem condVar_eq_blockQuad [IsProbabilityMeasure μ]
    {U : ℕ → V → Ω → ℝ} {coord : ℕ → T → ι → V} {g : ℕ → (ι → ℝ) → ℝ} {c : ℕ → T → ℝ}
    {step : ℕ → V → ℕ} {k : ℕ → ℕ} {n : ℕ}
    {ρ : Γ → ι → R} {lam : Γ → ℝ} {kstar : ι} {wsite : ℕ → V}
    (h : IsBasisSystem μ (U n) ψ Rpos B₀)
    (hinj : ∀ t, Function.Injective (coord n t))
    (hρ : ∀ γ i, ρ γ i ∈ Rpos)
    (hg : g n = multiKernel ψ ρ lam)
    (hw : ∀ κ < k n, ∀ t ∈ completedAt (coord n) (step n) κ, coord n t kstar = wsite κ)
    (hwstep : ∀ κ < k n, κ ≤ step n (wsite κ))
    (hrev : ∀ κ < k n, ∀ t ∈ completedAt (coord n) (step n) κ, ∀ i, i ≠ kstar →
      step n (coord n t i) < κ) :
    mdsCondVariance k (rowDiff μ U coord g c step k) (rowSigma U step k) μ n
      =ᵐ[μ] fun ω => ∑ γ, ∑ γ', lam γ * lam γ' *
        (if ρ γ kstar = ρ γ' kstar then (1 : ℝ) else 0) *
        ∑ j : Fin (k n), (blockA (U n) (coord n) ψ ρ (c n) (step n) kstar γ (j : ℕ) ω *
          blockA (U n) (coord n) ψ ρ (c n) (step n) kstar γ' (j : ℕ) ω) := by
  classical
  have hstep : ∀ j : Fin (k n),
      μ[fun ω => rowDiff μ U coord g c step k n j ω ^ 2 | rowSigma U step k n j.castSucc]
        =ᵐ[μ] fun ω => ∑ γ, ∑ γ', lam γ * lam γ' *
          (if ρ γ kstar = ρ γ' kstar then (1 : ℝ) else 0) *
          (blockA (U n) (coord n) ψ ρ (c n) (step n) kstar γ (j : ℕ) ω *
            blockA (U n) (coord n) ψ ρ (c n) (step n) kstar γ' (j : ℕ) ω) := by
    intro j
    have hrd : rowDiff μ U coord g c step k n j
        = degenDiff μ (U n) (coord n) (multiKernel ψ ρ lam) (c n) (step n) (j : ℕ) := by
      show degenDiff μ (U n) (coord n) (g n) (c n) (step n) (j : ℕ) = _
      rw [hg]
    rw [hrd]
    exact condExp_sq_degenDiff h hinj hρ (lam := lam) (c := c n) (step := step n) (j : ℕ)
      (hw (j : ℕ) j.isLt) (hwstep (j : ℕ) j.isLt) (hrev (j : ℕ) j.isLt)
  filter_upwards [ae_all_iff.2 hstep] with ω hω
  show ∑ j : Fin (k n),
      (μ[fun ω' => rowDiff μ U coord g c step k n j ω' ^ 2 |
        rowSigma U step k n j.castSucc]) ω = _
  rw [Finset.sum_congr rfl fun j _ => hω j]
  simp only [Finset.mul_sum]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun γ _ => ?_
  rw [Finset.sum_comm]

/-! #### Identification with `cvarEntry` -/

section Match

variable [Fintype V] [DecidableEq V]

omit [DecidableEq R] [Fintype Γ] [DecidableEq Γ] [Fintype V] in
/-- The block `A^γ_i` of `Multiway.Concentration` is the martingale's block: the site set of a
sub-tuple is the image of its coordinates other than `k⋆`, the basis index at a site is the
component's index at that coordinate, and the coefficient array is `c` restricted to the
sub-tuples completed at that step and extended by zero. -/
theorem blockSum_eq_blockA {I : Type*} [Fintype I]
    {sites : ∀ _γ : Γ, T → Finset V} {rIdx : Γ → V → R} {arr : ∀ _γ : Γ, T → I → ℝ}
    {coord : T → ι → V} {ρ : Γ → ι → R} {c : T → ℝ} {step : V → ℕ} {kstar : ι} {idx : I → ℕ}
    (hinj : ∀ t, Function.Injective (coord t))
    (hsites : ∀ (γ : Γ) (t : T), sites γ t = (Finset.univ.erase kstar).image (coord t))
    (hrIdx : ∀ (γ : Γ) (t : T) (i : ι), i ≠ kstar → rIdx γ (coord t i) = ρ γ i)
    (harr : ∀ (γ : Γ) (t : T) (j : I),
      arr γ t j = if t ∈ completedAt coord step (idx j) then c t else 0)
    (γ : Γ) (j : I) :
    blockSum U ψ sites rIdx arr γ j = blockA U coord ψ ρ c step kstar γ (idx j) := by
  classical
  funext ω
  have hbp : ∀ t : T, basisProd U ψ sites rIdx γ t ω
      = ∏ i ∈ Finset.univ.erase kstar, ψ (ρ γ i) (U (coord t i) ω) := by
    intro t
    show ∏ w ∈ sites γ t, ψ (rIdx γ w) (U w ω) = _
    rw [hsites γ t, Finset.prod_image (fun a _ b _ hab => hinj t hab)]
    exact Finset.prod_congr rfl fun i hi => by rw [hrIdx γ t i (Finset.mem_erase.1 hi).1]
  show ∑ t : T, arr γ t j * basisProd U ψ sites rIdx γ t ω = _
  have hsum : ∀ t : T, arr γ t j * basisProd U ψ sites rIdx γ t ω
      = if t ∈ completedAt coord step (idx j) then
          c t * ∏ i ∈ Finset.univ.erase kstar, ψ (ρ γ i) (U (coord t i) ω) else 0 := by
    intro t
    rw [harr γ t j, hbp t]
    split_ifs <;> ring
  rw [Finset.sum_congr rfl fun t _ => hsum t, Finset.sum_ite_mem, Finset.univ_inter]
  rfl

omit [DecidableEq Γ] [Fintype V] [DecidableEq V] in
/-- `∑_{γ,γ'}λ_γλ_{γ'}X_{γγ'}` is the block quadratic form. `htag` reads the tag
`(k⋆_γ, r_{k⋆}(γ))` at one level, where `k⋆` is common. -/
theorem quadForm_eq_blockQuad {I : Type*} [Fintype I] {τ : Type*} [DecidableEq τ]
    {sites : ∀ _γ : Γ, T → Finset V} {rIdx : Γ → V → R} {arr : ∀ _γ : Γ, T → I → ℝ}
    {tag : Γ → τ} {lam : Γ → ℝ}
    {coord : T → ι → V} {ρ : Γ → ι → R} {c : T → ℝ} {step : V → ℕ} {kstar : ι} {idx : I → ℕ}
    (htag : ∀ γ γ' : Γ, tag γ = tag γ' ↔ ρ γ kstar = ρ γ' kstar)
    (hblk : ∀ (γ : Γ) (j : I),
      blockSum U ψ sites rIdx arr γ j = blockA U coord ψ ρ c step kstar γ (idx j))
    (ω : Ω) :
    quadForm U ψ sites rIdx arr tag lam ω
      = ∑ γ, ∑ γ', lam γ * lam γ' *
        (if ρ γ kstar = ρ γ' kstar then (1 : ℝ) else 0) *
        ∑ j : I, (blockA U coord ψ ρ c step kstar γ (idx j) ω *
          blockA U coord ψ ρ c step kstar γ' (idx j) ω) := by
  classical
  show ∑ γ : Γ, ∑ γ' : Γ, lam γ * lam γ' * cvarEntry U ψ sites rIdx arr tag γ γ' ω = _
  refine Finset.sum_congr rfl fun γ _ => Finset.sum_congr rfl fun γ' _ => ?_
  have hce : cvarEntry U ψ sites rIdx arr tag γ γ' ω
      = if tag γ = tag γ' then
          ∑ j : I, (blockSum U ψ sites rIdx arr γ j ω * blockSum U ψ sites rIdx arr γ' j ω)
        else 0 := rfl
  rw [hce]
  simp only [hblk]
  split_ifs with h1 h2 h3
  · ring
  · exact absurd ((htag γ γ').1 h1) h2
  · exact absurd ((htag γ γ').2 h3) h1
  · ring

omit [Fintype V] in
/-- `halg` for the latent array, with cell constant `cellc = 0`. -/
theorem halg_of_multiKernel [IsProbabilityMeasure μ] {τ : Type*} [DecidableEq τ]
    {U : ℕ → V → Ω → ℝ} {coord : ℕ → T → ι → V} {g : ℕ → (ι → ℝ) → ℝ} {c : ℕ → T → ℝ}
    {step : ℕ → V → ℕ} {k : ℕ → ℕ} {n : ℕ}
    {sites : ∀ _γ : Γ, T → Finset V} {rIdx : Γ → V → R}
    {arr : ∀ _γ : Γ, T → Fin (k n) → ℝ} {tag : Γ → τ}
    {ρ : Γ → ι → R} {lam : Γ → ℝ} {kstar : ι} {wsite : ℕ → V} {cellc : ℝ}
    (h : IsBasisSystem μ (U n) ψ Rpos B₀)
    (hinj : ∀ t, Function.Injective (coord n t))
    (hρ : ∀ γ i, ρ γ i ∈ Rpos)
    (hg : g n = multiKernel ψ ρ lam)
    (hw : ∀ κ < k n, ∀ t ∈ completedAt (coord n) (step n) κ, coord n t kstar = wsite κ)
    (hwstep : ∀ κ < k n, κ ≤ step n (wsite κ))
    (hrev : ∀ κ < k n, ∀ t ∈ completedAt (coord n) (step n) κ, ∀ i, i ≠ kstar →
      step n (coord n t i) < κ)
    (htag : ∀ γ γ' : Γ, tag γ = tag γ' ↔ ρ γ kstar = ρ γ' kstar)
    (hsites : ∀ (γ : Γ) (t : T), sites γ t = (Finset.univ.erase kstar).image (coord n t))
    (hrIdx : ∀ (γ : Γ) (t : T) (i : ι), i ≠ kstar → rIdx γ (coord n t i) = ρ γ i)
    (harr : ∀ (γ : Γ) (t : T) (j : Fin (k n)),
      arr γ t j = if t ∈ completedAt (coord n) (step n) (j : ℕ) then c n t else 0)
    (hcell : cellc = 0) :
    mdsCondVariance k (rowDiff μ U coord g c step k) (rowSigma U step k) μ n
      =ᵐ[μ] fun ω => quadForm (U n) ψ sites rIdx arr tag lam ω + cellc := by
  have hblk := blockSum_eq_blockA (U := U n) (ψ := ψ) (sites := sites) (rIdx := rIdx)
    (arr := arr) (ρ := ρ) (c := c n) (step := step n) (kstar := kstar)
    (idx := fun j : Fin (k n) => (j : ℕ)) hinj hsites hrIdx harr
  filter_upwards [condVar_eq_blockQuad (U := U) (coord := coord) (g := g) (c := c)
    (step := step) (k := k) (n := n) (ρ := ρ) (lam := lam) (kstar := kstar) (wsite := wsite)
    h hinj hρ hg hw hwstep hrev] with ω hω
  rw [hω, hcell, add_zero,
    quadForm_eq_blockQuad (idx := fun j : Fin (k n) => (j : ℕ)) htag hblk ω]

end Match

/-! #### `hstep4` from the variance comparison -/

section Step4

/-- From the variance comparison and `c'S_nc → σ²`, an eventual bound
`|σ²_{n,L} − σ²| ≤ D` at any `D` strictly above `δ(L)`. -/
theorem eventually_abs_sub_le {sc Sn : ℕ → ℝ} {sig2 d D : ℝ}
    (hSn : Tendsto Sn atTop (𝓝 sig2))
    (hvc : ∀ᶠ n : ℕ in atTop, |sc n - Sn n| ≤ d) (hD : d < D) :
    ∀ᶠ n : ℕ in atTop, |sc n - sig2| ≤ D := by
  obtain ⟨N, hN⟩ := Metric.tendsto_atTop.1 hSn (D - d) (by linarith)
  have hclose : ∀ᶠ n : ℕ in atTop, |Sn n - sig2| ≤ D - d :=
    Filter.eventually_atTop.2 ⟨N, fun n hn => by
      have := hN n hn
      rw [Real.dist_eq] at this
      exact this.le⟩
  filter_upwards [hvc, hclose] with n h1 h2
  calc |sc n - sig2| ≤ |sc n - Sn n| + |Sn n - sig2| := abs_sub_le _ _ _
    _ ≤ d + (D - d) := add_le_add h1 h2
    _ = D := by ring

/-- `hstep4`. `hs2` and `hSndef` express `s_n²(L)` and `nc'S_nc` as the same sum over levels
with coefficients `σ_e²−τ_e²(L)` and `σ_e²`. -/
theorem hstep4_of_varcomp {E : Type*} (Es : Finset E) (sig tau : E → ℝ) (W : ℕ → E → ℝ)
    (cell : ℕ → ℝ) (Cw : ℝ) (sc Sn : ℕ → ℝ) {sig2 D : ℝ}
    (hs2 : ∀ n : ℕ, 0 < n → sc n ^ 2
      = ((∑ e ∈ Es, (sig e - tau e) * W n e) + cell n) / (n : ℝ))
    (hSndef : ∀ n : ℕ, 0 < n → Sn n = ((∑ e ∈ Es, sig e * W n e) + cell n) / (n : ℝ))
    (htau : ∀ e ∈ Es, 0 ≤ tau e) (hW : ∀ (n : ℕ), ∀ e ∈ Es, 0 ≤ W n e)
    (hWb : ∀ (n : ℕ), ∀ e ∈ Es, W n e ≤ Cw * (n : ℝ))
    (hSn : Tendsto Sn atTop (𝓝 sig2)) (hD : Cw * ∑ e ∈ Es, tau e < D) :
    ∀ᶠ n : ℕ in atTop, |sc n ^ 2 - sig2| ≤ D := by
  refine eventually_abs_sub_le (sc := fun n => sc n ^ 2) hSn ?_ hD
  filter_upwards [Filter.eventually_gt_atTop 0] with n hn
  rw [hs2 n hn, hSndef n hn]
  exact abs_varcomp_le Es sig tau (W n) (cell n) (n : ℝ) Cw (by exact_mod_cast hn)
    htau (hW n) (hWb n)

/-- A padding of `δ(L)` that turns a bound against `c'S_nc` at every `n` into an eventual bound
against `c'Sc`; it still tends to `0`. -/
theorem tendsto_delta_pad {E : Type*} (Es : Finset E) (Cw : ℝ) (tau : E → ℕ → ℝ)
    (h : ∀ e ∈ Es, Tendsto (tau e) atTop (𝓝 0)) :
    Tendsto (fun L : ℕ => Cw * (∑ e ∈ Es, tau e L) + 1 / ((L : ℝ) + 1)) atTop (𝓝 0) := by
  have h1 := tendsto_delta Es Cw tau h
  have h2 : Tendsto (fun L : ℕ => 1 / ((L : ℝ) + 1)) atTop (𝓝 0) :=
    tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ)
  simpa using h1.add h2

theorem lt_delta_pad {E : Type*} (Es : Finset E) (Cw : ℝ) (tau : E → ℕ → ℝ) (L : ℕ) :
    Cw * (∑ e ∈ Es, tau e L) < Cw * (∑ e ∈ Es, tau e L) + 1 / ((L : ℝ) + 1) :=
  lt_add_of_pos_right _ (by positivity)

end Step4

/-! #### `hstep5`: the `L²` gap, at one level and summed over levels -/

section Step5

variable [IsProbabilityMeasure μ]

omit [Fintype ι] [DecidableEq ι] [Fintype T] [DecidableEq T] [IsProbabilityMeasure μ] in
/-- Complete degeneracy passes to a difference of kernels, in particular to the tail kernels
`h^{(e)}−h^{(e)}_L`. -/
theorem condExp_degenTerm_sub_eq_zero {coord : T → ι → V} {G g : (ι → ℝ) → ℝ} {t : T}
    {e' : Set ι}
    (hintG : Integrable (degenTerm U coord G t) μ)
    (hintg : Integrable (degenTerm U coord g t) μ)
    (hG : μ[degenTerm U coord G t | latentSigma U (coord t '' e')] =ᵐ[μ] 0)
    (hg : μ[degenTerm U coord g t | latentSigma U (coord t '' e')] =ᵐ[μ] 0) :
    μ[degenTerm U coord (G - g) t | latentSigma U (coord t '' e')] =ᵐ[μ] 0 := by
  have hfun : degenTerm U coord (G - g) t = degenTerm U coord G t - degenTerm U coord g t := rfl
  rw [hfun]
  filter_upwards [condExp_sub hintG hintg (latentSigma U (coord t '' e')), hG, hg]
    with ω h1 h2 h3
  rw [h1]
  simp only [Pi.sub_apply, h2, h3, Pi.zero_apply, sub_zero]

omit [DecidableEq ι] [DecidableEq T] in
/-- `hstep5` at one level. `hxi` writes `n^{-1/2}c'X̃'ν` on the untruncated kernel and `hscale`
is the scaling `σ_{n,L}·T_n(L)/s_n(L) = n^{-1/2}T_n(L)`, so the difference is the degenerate
sum of the tail kernel. -/
theorem hstep5_of_tail [Nonempty ι] {coord : T → ι → V} {G g : (ι → ℝ) → ℝ}
    {cf cfull : T → ℝ} {xi : Ω → ℝ} {sc taus D : ℝ}
    (hU : ∀ v, Measurable (U v)) (hindep : iIndepFun U μ)
    (hGg : Measurable (G - g))
    (hsqd : ∀ t, MemLp (degenTerm U coord (G - g) t) 2 μ)
    (hdegd : ∀ (t : T) (e' : Set ι), e' ≠ Set.univ →
      μ[degenTerm U coord (G - g) t | latentSigma U (coord t '' e')] =ᵐ[μ] 0)
    (hsep : ∀ t s : T, t ≠ s →
      (∃ i : ι, coord s i ∉ tupleSupport coord t) ∨
      (∃ i : ι, coord t i ∉ tupleSupport coord s))
    (hmom : ∀ t : T, ∫ ω, degenTerm U coord (G - g) t ω ^ 2 ∂μ = taus)
    (hxi : ∀ ω, xi ω = degenSum U coord G cfull ω)
    (hscale : ∀ t : T, sc * cf t = cfull t)
    (hbound : (∑ t : T, cfull t ^ 2) * taus ≤ D) :
    ∫ ω, (xi ω - sc * degenSum U coord g cf ω) ^ 2 ∂μ ≤ D := by
  have hrw : ∀ ω, xi ω - sc * degenSum U coord g cf ω = degenSum U coord (G - g) cfull ω := by
    intro ω
    rw [hxi ω, degenSum_apply, degenSum_apply, degenSum_apply, Finset.mul_sum,
      ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun t _ => ?_
    have hd : degenTerm U coord (G - g) t ω
        = degenTerm U coord G t ω - degenTerm U coord g t ω := rfl
    rw [hd, ← hscale t]
    ring
  simp only [hrw]
  rw [Step45.integral_degenSum_sq hU hindep hGg hsqd hdegd hsep]
  refine le_trans (le_of_eq ?_) hbound
  rw [Finset.sum_mul]
  exact Finset.sum_congr rfl fun t _ => by rw [hmom t]

/-- `hstep5` summed over levels: `n^{-1}∑_eτ_e²(L)‖W^{(e)}_c‖_F² ≤ δ(L)`, on `multiDegenSum`,
with orthogonality across levels from `Step45.integral_multiDegenSum_sq`. -/
theorem hstep5_of_tail_multi {Λ : Type*} [Fintype Λ] {ιm : Λ → Type*} [∀ l, Fintype (ιm l)]
    [∀ l, Nonempty (ιm l)] {Tm : Λ → Type*} [∀ l, Fintype (Tm l)] [∀ l, DecidableEq (Tm l)]
    {coord : ∀ l, Tm l → ιm l → V} {G g d : ∀ l, (ιm l → ℝ) → ℝ}
    {cf cfull : ∀ l, Tm l → ℝ} {xi : Ω → ℝ} {sc D : ℝ} {taus : Λ → ℝ}
    (hU : ∀ v, Measurable (U v)) (hindep : iIndepFun U μ)
    (hd : ∀ l, d l = G l - g l)
    (hdm : ∀ l, Measurable (d l))
    (hsqd : ∀ (l : Λ) (t : Tm l), MemLp (degenTerm U (coord l) (d l) t) 2 μ)
    (hdegd : ∀ (l : Λ) (t : Tm l) (e' : Set (ιm l)), e' ≠ Set.univ →
      μ[degenTerm U (coord l) (d l) t | latentSigma U (coord l t '' e')] =ᵐ[μ] 0)
    (hsep : ∀ (l l' : Λ) (t : Tm l) (s : Tm l'), (⟨l, t⟩ : Σ q : Λ, Tm q) ≠ ⟨l', s⟩ →
      (∃ i : ιm l', coord l' s i ∉ tupleSupport (coord l) t) ∨
      (∃ i : ιm l, coord l t i ∉ tupleSupport (coord l') s))
    (hmom : ∀ (l : Λ) (t : Tm l), ∫ ω, degenTerm U (coord l) (d l) t ω ^ 2 ∂μ = taus l)
    (hxi : ∀ ω, xi ω = multiDegenSum U coord G cfull ω)
    (hscale : ∀ (l : Λ) (t : Tm l), sc * cf l t = cfull l t)
    (hbound : (∑ l : Λ, (∑ t : Tm l, cfull l t ^ 2) * taus l) ≤ D) :
    ∫ ω, (xi ω - sc * multiDegenSum U coord g cf ω) ^ 2 ∂μ ≤ D := by
  have hrw : ∀ ω, xi ω - sc * multiDegenSum U coord g cf ω
      = multiDegenSum U coord d cfull ω := by
    intro ω
    rw [hxi ω, multiDegenSum_apply, multiDegenSum_apply, multiDegenSum_apply, Finset.mul_sum,
      ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun l _ => ?_
    rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun t _ => ?_
    have hdt : degenTerm U (coord l) (d l) t ω
        = degenTerm U (coord l) (G l) t ω - degenTerm U (coord l) (g l) t ω := by
      show d l (latentTuple U (coord l) t ω) = _
      rw [hd l]
      rfl
    rw [hdt, ← hscale l t]
    ring
  simp only [hrw]
  rw [Step45.integral_multiDegenSum_sq hU hindep hdm hsqd hdegd hsep]
  refine le_trans (le_of_eq ?_) hbound
  refine Finset.sum_congr rfl fun l _ => ?_
  rw [Finset.sum_mul]
  exact Finset.sum_congr rfl fun t _ => by rw [hmom l t]

end Step5

end Alg

/-! ### The cell steps

The statistic `T_n(L) = ∑_tc_tg(U_t) + ∑_oc'x̃_oε_o` has a latent part and a cell part. This
section concatenates the latent martingale-difference array with the cell steps `c'x̃_oε_o`
(`concatArray`, `isMDSArray_concat`), shows that the cell steps have the constant conditional
variances `(c'x̃_o)²σ²_ε(o)` (`mdsCondVariance_cell`), and obtains the martingale CLT for the
full statistic (`tendsto_charFun_total`, `tendsto_charFun_total_of_concentration`).
`IsCellModel` assumes the disturbances are measurable, square integrable, independent of the
design and of everything already revealed, with mean zero and second moment `σ²_ε(o)`; the cell
coefficients are constants, since the argument is conditional on `𝒟`. -/

namespace Cell


variable {Ω : Type*} {m0 : MeasurableSpace Ω} {μ : Measure Ω}

/-! #### Concatenation of martingale-difference arrays -/

/-- The array whose `n`-th row is the `n`-th row of `X` followed by that of `Y`. -/
noncomputable def concatArray (k m : ℕ → ℕ) (X : (n : ℕ) → Fin (k n) → Ω → ℝ)
    (Y : (n : ℕ) → Fin (m n) → Ω → ℝ) (n : ℕ) (i : Fin (k n + m n)) : Ω → ℝ :=
  if h : (i : ℕ) < k n then X n ⟨(i : ℕ), h⟩
  else Y n ⟨(i : ℕ) - k n, by have hi := i.isLt; omega⟩

set_option warn.classDefReducibility false in
/-- The filtration equal to `F` below the junction and to `G` at and above it. -/
def concatSigma (k m : ℕ → ℕ) (F : (n : ℕ) → Fin (k n + 1) → MeasurableSpace Ω)
    (G : (n : ℕ) → Fin (m n + 1) → MeasurableSpace Ω) (n : ℕ)
    (i : Fin (k n + m n + 1)) : MeasurableSpace Ω :=
  if h : (i : ℕ) < k n then F n ⟨(i : ℕ), by omega⟩
  else G n ⟨(i : ℕ) - k n, by have hi := i.isLt; omega⟩

variable {k m : ℕ → ℕ} {X : (n : ℕ) → Fin (k n) → Ω → ℝ} {Y : (n : ℕ) → Fin (m n) → Ω → ℝ}
  {F : (n : ℕ) → Fin (k n + 1) → MeasurableSpace Ω}
  {G : (n : ℕ) → Fin (m n + 1) → MeasurableSpace Ω}

theorem concatArray_castAdd (n : ℕ) (j : Fin (k n)) :
    concatArray k m X Y n (Fin.castAdd (m n) j) = X n j := by
  rw [concatArray]
  split_ifs with h
  · rfl
  · exact absurd j.isLt h

theorem concatArray_natAdd (n : ℕ) (j : Fin (m n)) :
    concatArray k m X Y n (Fin.natAdd (k n) j) = Y n j := by
  rw [concatArray]
  split_ifs with h
  · exact absurd h (by simp only [Fin.val_natAdd]; omega)
  · congr 1
    apply Fin.ext
    simp

theorem concatSigma_castAdd_castSucc (n : ℕ) (j : Fin (k n)) :
    concatSigma k m F G n ((Fin.castAdd (m n) j).castSucc) = F n j.castSucc := by
  rw [concatSigma]
  split_ifs with h
  · rfl
  · exact absurd j.isLt h

theorem concatSigma_natAdd_castSucc (n : ℕ) (j : Fin (m n)) :
    concatSigma k m F G n ((Fin.natAdd (k n) j).castSucc) = G n j.castSucc := by
  rw [concatSigma]
  split_ifs with h
  · exact absurd h (by simp only [Fin.val_castSucc, Fin.val_natAdd]; omega)
  · congr 1
    apply Fin.ext
    simp

theorem concatSigma_lt (n : ℕ) (i : Fin (k n + m n + 1)) (h : (i : ℕ) < k n) :
    concatSigma k m F G n i = F n ⟨(i : ℕ), by omega⟩ := by
  rw [concatSigma]; split_ifs; rfl

theorem concatSigma_ge (n : ℕ) (i : Fin (k n + m n + 1)) (h : ¬ (i : ℕ) < k n) :
    concatSigma k m F G n i = G n ⟨(i : ℕ) - k n, by have := i.isLt; omega⟩ := by
  rw [concatSigma]; split_ifs; rfl

theorem concatSigma_le (hF : ∀ n i, F n i ≤ m0) (hG : ∀ n i, G n i ≤ m0) (n : ℕ)
    (i : Fin (k n + m n + 1)) : concatSigma k m F G n i ≤ m0 := by
  rw [concatSigma]
  split_ifs
  · exact hF n _
  · exact hG n _

theorem concatSigma_mono (hFm : ∀ n, Monotone (F n)) (hGm : ∀ n, Monotone (G n))
    (hjoin : ∀ n, F n (Fin.last (k n)) ≤ G n 0) (n : ℕ) :
    Monotone (concatSigma k m F G n) := by
  intro i i' hii
  have hii' : (i : ℕ) ≤ (i' : ℕ) := hii
  rw [concatSigma, concatSigma]
  split_ifs with h1 h2 h2
  · exact hFm n (show (⟨(i : ℕ), _⟩ : Fin (k n + 1)) ≤ ⟨(i' : ℕ), _⟩ from hii')
  · refine le_trans (hFm n (show (⟨(i : ℕ), by omega⟩ : Fin (k n + 1)) ≤ Fin.last (k n) from
      by simp only [Fin.le_def, Fin.val_last]; omega)) (le_trans (hjoin n) (hGm n ?_))
    simp
  · exact absurd (lt_of_le_of_lt hii' h2) h1
  · exact hGm n (show (⟨(i : ℕ) - k n, _⟩ : Fin (m n + 1)) ≤ ⟨(i' : ℕ) - k n, _⟩ by
      simp only [Fin.le_def]; omega)

/-- The concatenation of two martingale-difference arrays is a martingale-difference array. -/
theorem isMDSArray_concat (hX : IsMDSArray k X F μ) (hY : IsMDSArray m Y G μ)
    (hjoin : ∀ n, F n (Fin.last (k n)) ≤ G n 0) :
    IsMDSArray (fun n => k n + m n) (concatArray k m X Y) (concatSigma k m F G) μ where
  le_ambient := concatSigma_le hX.le_ambient hY.le_ambient
  mono := concatSigma_mono hX.mono hY.mono hjoin
  adapted := by
    intro n i
    rcases lt_or_ge (i : ℕ) (k n) with h | h
    · have hval : concatArray k m X Y n i = X n ⟨(i : ℕ), h⟩ := by
        rw [concatArray]; split_ifs <;> rfl
      rw [hval]
      rcases lt_or_ge ((i : ℕ) + 1) (k n) with h2 | h2
      · have hs : concatSigma k m F G n i.succ
            = F n (⟨(i : ℕ), h⟩ : Fin (k n)).succ := by
          rw [concatSigma_lt n i.succ (by simp only [Fin.val_succ]; omega)]
          rfl
        rw [hs]
        exact hX.adapted n ⟨(i : ℕ), h⟩
      · have heq : (i : ℕ) + 1 = k n := by omega
        have hs : concatSigma k m F G n i.succ
            = G n ⟨(i : ℕ) + 1 - k n, by have := i.isLt; omega⟩ := by
          rw [concatSigma_ge n i.succ (by simp only [Fin.val_succ]; omega)]
          congr 1
        rw [hs]
        refine (hX.adapted n ⟨(i : ℕ), h⟩).mono ?_ le_rfl
        have hlast : (⟨(i : ℕ), h⟩ : Fin (k n)).succ = Fin.last (k n) := by
          apply Fin.ext; simpa using heq
        rw [hlast]
        refine le_trans (hjoin n) (le_of_eq ?_)
        congr 1
        apply Fin.ext
        simp only [Fin.val_zero]
        omega
    · have hval : concatArray k m X Y n i
          = Y n ⟨(i : ℕ) - k n, by have := i.isLt; omega⟩ := by
        rw [concatArray]; split_ifs with h3
        · omega
        · rfl
      rw [hval]
      have hs : concatSigma k m F G n i.succ
          = G n (⟨(i : ℕ) - k n, by have := i.isLt; omega⟩ : Fin (m n)).succ := by
        rw [concatSigma_ge n i.succ (by simp only [Fin.val_succ]; omega)]
        congr 1
        apply Fin.ext
        simp only [Fin.val_succ]
        omega
      rw [hs]
      exact hY.adapted n _
  memLp := by
    intro n i
    rw [concatArray]
    split_ifs
    · exact hX.memLp n _
    · exact hY.memLp n _
  condexp_zero := by
    intro n i
    rcases lt_or_ge (i : ℕ) (k n) with h | h
    · have hval : concatArray k m X Y n i = X n ⟨(i : ℕ), h⟩ := by
        rw [concatArray]; split_ifs <;> rfl
      have hs : concatSigma k m F G n i.castSucc
          = F n (⟨(i : ℕ), h⟩ : Fin (k n)).castSucc := by
        rw [concatSigma_lt n i.castSucc (by simpa using h)]
        rfl
      rw [hval, hs]
      exact hX.condexp_zero n ⟨(i : ℕ), h⟩
    · have hval : concatArray k m X Y n i
          = Y n ⟨(i : ℕ) - k n, by have := i.isLt; omega⟩ := by
        rw [concatArray]; split_ifs with h3
        · omega
        · rfl
      have hs : concatSigma k m F G n i.castSucc
          = G n (⟨(i : ℕ) - k n, by have := i.isLt; omega⟩ : Fin (m n)).castSucc := by
        rw [concatSigma_ge n i.castSucc (by simp only [Fin.val_castSucc]; omega)]
        rfl
      rw [hval, hs]
      exact hY.condexp_zero n _

/-- The row sum of the concatenation is the sum of the two row sums. -/
theorem mdsRowSum_concat (n : ℕ) (ω : Ω) :
    mdsRowSum (fun n => k n + m n) (concatArray k m X Y) n ω
      = mdsRowSum k X n ω + mdsRowSum m Y n ω := by
  show ∑ i : Fin (k n + m n), concatArray k m X Y n i ω = _
  rw [Fin.sum_univ_add]
  congr 1
  · exact Finset.sum_congr rfl fun j _ => by rw [concatArray_castAdd]
  · exact Finset.sum_congr rfl fun j _ => by rw [concatArray_natAdd]

/-- The conditional-variance process of the concatenation is the sum of the two processes. -/
theorem mdsCondVariance_concat (n : ℕ) (ω : Ω) :
    mdsCondVariance (fun n => k n + m n) (concatArray k m X Y) (concatSigma k m F G) μ n ω
      = mdsCondVariance k X F μ n ω + mdsCondVariance m Y G μ n ω := by
  show ∑ i : Fin (k n + m n), _ = _
  rw [Fin.sum_univ_add]
  congr 1
  · refine Finset.sum_congr rfl fun j _ => ?_
    rw [concatSigma_castAdd_castSucc, concatArray_castAdd]
  · refine Finset.sum_congr rfl fun j _ => ?_
    rw [concatSigma_natAdd_castSucc, concatArray_natAdd]


/-! #### The cell steps -/

set_option warn.classDefReducibility false in
/-- The cell filtration: everything the latent half ever reveals (`base`), together with the
cell disturbances already revealed. -/
def cellSigma (base : ℕ → MeasurableSpace Ω) (eps : ℕ → ℕ → Ω → ℝ) (m : ℕ → ℕ)
    (n : ℕ) (i : Fin (m n + 1)) : MeasurableSpace Ω :=
  base n ⊔ latentSigma (eps n) {j : ℕ | j < (i : ℕ)}

/-- The cell step `c'x̃_o ε_o`. -/
noncomputable def cellDiff (a : ℕ → ℕ → ℝ) (eps : ℕ → ℕ → Ω → ℝ) (m : ℕ → ℕ)
    (n : ℕ) (j : Fin (m n)) : Ω → ℝ := fun ω => a n (j : ℕ) * eps n (j : ℕ) ω

/-- The cell part of `T_n(L)`: `∑_o c'x̃_o ε_o`. -/
noncomputable def cellSum (a : ℕ → ℕ → ℝ) (eps : ℕ → ℕ → Ω → ℝ) (m : ℕ → ℕ) (n : ℕ) : Ω → ℝ :=
  fun ω => ∑ j : Fin (m n), a n (j : ℕ) * eps n (j : ℕ) ω

/-- `∑_o (c'x̃_o)²σ²_ε(o)`. -/
noncomputable def cellConst (a : ℕ → ℕ → ℝ) (sg : ℕ → ℕ → ℝ) (m : ℕ → ℕ) (n : ℕ) : ℝ :=
  ∑ j : Fin (m n), a n (j : ℕ) ^ 2 * sg n (j : ℕ)

/-- The cell model: disturbances independent of the design and of everything already
revealed, with mean zero and second moment `σ²_ε(o)`. -/
structure IsCellModel (μ : Measure Ω) (base : ℕ → MeasurableSpace Ω) (eps : ℕ → ℕ → Ω → ℝ)
    (sg : ℕ → ℕ → ℝ) (m : ℕ → ℕ) : Prop where
  /-- The latent σ-field the cell steps start from is a sub-σ-field. -/
  base_le : ∀ n, base n ≤ m0
  /-- The disturbances are measurable. -/
  meas : ∀ n j, Measurable (eps n j)
  /-- The disturbances are square integrable. -/
  l2 : ∀ n j, MemLp (eps n j) 2 μ
  /-- The disturbances are independent of the design and across cells. -/
  indep : ∀ (n : ℕ) (j : Fin (m n)),
    Indep (MeasurableSpace.comap (eps n (j : ℕ)) inferInstance)
      (cellSigma base eps m n j.castSucc) μ
  /-- `𝔼[ε_o] = 0`. -/
  mean : ∀ n j, ∫ ω, eps n j ω ∂μ = 0
  /-- `𝔼[ε_o²] = σ²_ε(o)`. -/
  var : ∀ n j, ∫ ω, eps n j ω ^ 2 ∂μ = sg n j

variable {base : ℕ → MeasurableSpace Ω} {eps : ℕ → ℕ → Ω → ℝ} {sg a : ℕ → ℕ → ℝ}

theorem cellSigma_le (h : IsCellModel (m0 := m0) μ base eps sg m) (n : ℕ)
    (i : Fin (m n + 1)) : cellSigma base eps m n i ≤ m0 :=
  sup_le (h.base_le n) (latentSigma_le (fun j => h.meas n j) _)

theorem cellSigma_mono (_h : IsCellModel (m0 := m0) μ base eps sg m) (n : ℕ) :
    Monotone (cellSigma base eps m n) := by
  intro i i' hii
  have hii' : (i : ℕ) ≤ (i' : ℕ) := hii
  have hsub : latentSigma (eps n) {j : ℕ | j < (i : ℕ)}
      ≤ latentSigma (eps n) {j : ℕ | j < (i' : ℕ)} :=
    latentSigma_mono (eps n) fun _ hv => lt_of_lt_of_le hv hii'
  show base n ⊔ latentSigma (eps n) {j : ℕ | j < (i : ℕ)}
      ≤ base n ⊔ latentSigma (eps n) {j : ℕ | j < (i' : ℕ)}
  exact sup_le le_sup_left (le_trans hsub le_sup_right)

theorem measurable_eps_cellSigma (n : ℕ) (j : Fin (m n)) :
    Measurable[cellSigma base eps m n j.succ] (eps n (j : ℕ)) :=
  (measurable_latentSigma (eps n) (show (j : ℕ) ∈ {i : ℕ | i < ((j.succ : Fin (m n + 1)) : ℕ)}
    by simp)).mono le_sup_right le_rfl

/-- The cell steps form a martingale-difference array. -/
theorem isMDSArray_cell [IsProbabilityMeasure μ]
    (h : IsCellModel (m0 := m0) μ base eps sg m) :
    IsMDSArray m (cellDiff a eps m) (cellSigma base eps m) μ where
  le_ambient := cellSigma_le h
  mono := cellSigma_mono h
  adapted n j := (measurable_eps_cellSigma n j).const_mul (a n (j : ℕ))
  memLp n j := (h.l2 n (j : ℕ)).const_mul (a n (j : ℕ))
  condexp_zero n j := by
    have hle₁ : MeasurableSpace.comap (eps n (j : ℕ)) (inferInstance : MeasurableSpace ℝ) ≤ m0 :=
      (h.meas n (j : ℕ)).comap_le
    have hle₂ : cellSigma base eps m n j.castSucc ≤ m0 := cellSigma_le h n j.castSucc
    have hsm : StronglyMeasurable[MeasurableSpace.comap (eps n (j : ℕ))
        (inferInstance : MeasurableSpace ℝ)] (cellDiff a eps m n j) :=
      (((comap_measurable (eps n (j : ℕ))).const_mul (a n (j : ℕ)))).stronglyMeasurable
    refine (condExp_indep_eq (m := m0) hle₁ hle₂ hsm (h.indep n j)).trans ?_
    filter_upwards with ω
    show ∫ ω', a n (j : ℕ) * eps n (j : ℕ) ω' ∂μ = (0 : Ω → ℝ) ω
    rw [integral_const_mul, h.mean n (j : ℕ)]
    simp

/-- At the cell steps the conditional variances are the constants `(c'x̃_o)²σ²_ε(o)`. -/
theorem mdsCondVariance_cell [IsProbabilityMeasure μ]
    (h : IsCellModel (m0 := m0) μ base eps sg m) (n : ℕ) :
    mdsCondVariance m (cellDiff a eps m) (cellSigma base eps m) μ n
      =ᵐ[μ] fun _ => cellConst a sg m n := by
  have hstep : ∀ j : Fin (m n),
      μ[fun ω => cellDiff a eps m n j ω ^ 2 | cellSigma base eps m n j.castSucc]
        =ᵐ[μ] fun _ => a n (j : ℕ) ^ 2 * sg n (j : ℕ) := by
    intro j
    have hle₁ : MeasurableSpace.comap (eps n (j : ℕ)) (inferInstance : MeasurableSpace ℝ) ≤ m0 :=
      (h.meas n (j : ℕ)).comap_le
    have hle₂ : cellSigma base eps m n j.castSucc ≤ m0 := cellSigma_le h n j.castSucc
    have hm1 : Measurable[MeasurableSpace.comap (eps n (j : ℕ))
        (inferInstance : MeasurableSpace ℝ)] (cellDiff a eps m n j) :=
      (comap_measurable (eps n (j : ℕ))).const_mul (a n (j : ℕ))
    have hsm : StronglyMeasurable[MeasurableSpace.comap (eps n (j : ℕ))
        (inferInstance : MeasurableSpace ℝ)] (fun ω => cellDiff a eps m n j ω ^ 2) := by
      have h2 : Measurable[MeasurableSpace.comap (eps n (j : ℕ))
          (inferInstance : MeasurableSpace ℝ)] (fun ω => cellDiff a eps m n j ω ^ 2) := by
        simp only [pow_two]
        exact hm1.mul hm1
      exact h2.stronglyMeasurable
    refine (condExp_indep_eq (m := m0) hle₁ hle₂ hsm (h.indep n j)).trans ?_
    filter_upwards with ω
    show ∫ ω', (a n (j : ℕ) * eps n (j : ℕ) ω') ^ 2 ∂μ = _
    have hc : ∀ ω' : Ω, (a n (j : ℕ) * eps n (j : ℕ) ω') ^ 2
        = a n (j : ℕ) ^ 2 * eps n (j : ℕ) ω' ^ 2 := fun ω' => by ring
    rw [integral_congr_ae (Filter.Eventually.of_forall hc), integral_const_mul, h.var n (j : ℕ)]
  filter_upwards [ae_all_iff.2 hstep] with ω hω
  show ∑ j : Fin (m n), _ = _
  exact Finset.sum_congr rfl fun j _ => hω j

/-- The cell row sum is `∑_o c'x̃_oε_o`. -/
theorem mdsRowSum_cell (n : ℕ) (ω : Ω) :
    mdsRowSum m (cellDiff a eps m) n ω = cellSum a eps m n ω := rfl

/-! #### The total array -/

section Total

variable {V ι T : Type*} [Fintype ι] [Fintype T] [DecidableEq T]
variable {U : ℕ → V → Ω → ℝ} {coord : ℕ → T → ι → V} {g : ℕ → (ι → ℝ) → ℝ} {c : ℕ → T → ℝ}
  {step : ℕ → V → ℕ} {k : ℕ → ℕ}

set_option warn.classDefReducibility false in
/-- The σ-field the cell steps start from: everything the latent half ever reveals. -/
def latentBase (U : ℕ → V → Ω → ℝ) (step : ℕ → V → ℕ) (k : ℕ → ℕ) (n : ℕ) :
    MeasurableSpace Ω :=
  latentSigma (U n) (revealed (step n) (k n))

/-- The martingale-difference array for `T_n(L)`: the latent differences of Lemma SM.C.2
followed by the cell steps `c'x̃_oε_o`. -/
noncomputable def totalDiff (μ : Measure Ω) (U : ℕ → V → Ω → ℝ) (coord : ℕ → T → ι → V)
    (g : ℕ → (ι → ℝ) → ℝ) (c : ℕ → T → ℝ) (step : ℕ → V → ℕ) (k : ℕ → ℕ)
    (a : ℕ → ℕ → ℝ) (eps : ℕ → ℕ → Ω → ℝ) (m : ℕ → ℕ) :
    (n : ℕ) → Fin (k n + m n) → Ω → ℝ :=
  concatArray k m (rowDiff μ U coord g c step k) (cellDiff a eps m)

set_option warn.classDefReducibility false in
/-- The filtration of the total array is the row filtration below the junction and, from the
junction on, the latent σ-field together with the disturbances already revealed. -/
def totalSigma (U : ℕ → V → Ω → ℝ) (step : ℕ → V → ℕ) (k : ℕ → ℕ)
    (eps : ℕ → ℕ → Ω → ℝ) (m : ℕ → ℕ) :
    (n : ℕ) → Fin (k n + m n + 1) → MeasurableSpace Ω :=
  concatSigma k m (rowSigma U step k) (cellSigma (latentBase U step k) eps m)

variable {a : ℕ → ℕ → ℝ} {eps : ℕ → ℕ → Ω → ℝ} {sg : ℕ → ℕ → ℝ} {m : ℕ → ℕ}

/-- The last σ-field of the row filtration is contained in the first σ-field of the cell
filtration. -/
theorem hjoin_total (n : ℕ) :
    rowSigma U step k n (Fin.last (k n)) ≤ cellSigma (latentBase U step k) eps m n 0 :=
  le_sup_left

omit [Fintype ι] [DecidableEq T] in
theorem isMDSArray_total [IsProbabilityMeasure μ]
    (hU : ∀ n v, Measurable (U n v))
    (hsq : ∀ n t, MemLp (degenTerm (U n) (coord n) (g n) t) 2 μ)
    (hc : IsCellModel (m0 := m0) μ (latentBase U step k) eps sg m) :
    IsMDSArray (fun n => k n + m n) (totalDiff μ U coord g c step k a eps m)
      (totalSigma U step k eps m) μ :=
  isMDSArray_concat (isMDSArray_degenDiff hU hsq) (isMDSArray_cell hc) hjoin_total

/-- The row sum of the total array is `T_n(L)`, the latent sum plus the cell sum. -/
theorem mdsRowSum_total_ae [Nonempty ι] [IsProbabilityMeasure μ]
    (hU : ∀ n v, Measurable (U n v)) (hindep : ∀ n, iIndepFun (U n) μ)
    (hg : ∀ n, Measurable (g n))
    (hint : ∀ n t, Integrable (degenTerm (U n) (coord n) (g n) t) μ)
    (hdeg : ∀ (n : ℕ) (t : T) (e' : Set ι), e' ≠ Set.univ →
      μ[degenTerm (U n) (coord n) (g n) t | latentSigma (U n) (coord n t '' e')] =ᵐ[μ] 0)
    (hN : ∀ n v, step n v < k n) (n : ℕ) :
    mdsRowSum (fun n => k n + m n) (totalDiff μ U coord g c step k a eps m) n
      =ᵐ[μ] fun ω => degenSum (U n) (coord n) (g n) (c n) ω + cellSum a eps m n ω := by
  filter_upwards [mdsRowSum_degenDiff_ae hU hindep hg hint hdeg hN n] with ω hω
  show mdsRowSum (fun n => k n + m n)
    (concatArray k m (rowDiff μ U coord g c step k) (cellDiff a eps m)) n ω = _
  rw [mdsRowSum_concat n ω, hω]
  rfl

omit [Fintype ι] [DecidableEq T] in
/-- `halg` for the total array from `halg` for the latent part (`hlat`, at `cellc = 0`): the
cell steps contribute `∑_o(c'x̃_o)²σ²_ε(o)`. -/
theorem condVar_total_of_latent [IsProbabilityMeasure μ]
    (hc : IsCellModel (m0 := m0) μ (latentBase U step k) eps sg m) {Q : Ω → ℝ} {cc : ℝ} {n : ℕ}
    (hlat : mdsCondVariance k (rowDiff μ U coord g c step k) (rowSigma U step k) μ n
      =ᵐ[μ] fun ω => Q ω + 0)
    (hcc : cc = cellConst a sg m n) :
    mdsCondVariance (fun n => k n + m n) (totalDiff μ U coord g c step k a eps m)
        (totalSigma U step k eps m) μ n
      =ᵐ[μ] fun ω => Q ω + cc := by
  filter_upwards [mdsCondVariance_cell (a := a) hc n, hlat] with ω hω hlatω
  show mdsCondVariance (fun n => k n + m n)
    (concatArray k m (rowDiff μ U coord g c step k) (cellDiff a eps m))
    (concatSigma k m (rowSigma U step k) (cellSigma (latentBase U step k) eps m)) μ n ω = _
  rw [mdsCondVariance_concat n ω, hlatω, hω, hcc]
  ring

omit [Fintype ι] [DecidableEq T] in
/-- The Lindeberg sum of the total array splits into the latent and cell sums. -/
theorem lindeberg_total
    (hlat : ∀ ε : ℝ, 0 < ε →
      Tendsto (fun n => ∑ i, ∫ ω in {ω | ε ≤ |rowDiff μ U coord g c step k n i ω|},
        (rowDiff μ U coord g c step k n i ω) ^ 2 ∂μ) atTop (𝓝 0))
    (hcell : ∀ ε : ℝ, 0 < ε →
      Tendsto (fun n => ∑ j, ∫ ω in {ω | ε ≤ |cellDiff a eps m n j ω|},
        (cellDiff a eps m n j ω) ^ 2 ∂μ) atTop (𝓝 0)) :
    ∀ ε : ℝ, 0 < ε →
      Tendsto (fun n => ∑ i, ∫ ω in
          {ω | ε ≤ |totalDiff μ U coord g c step k a eps m n i ω|},
        (totalDiff μ U coord g c step k a eps m n i ω) ^ 2 ∂μ) atTop (𝓝 0) := by
  intro ε hε
  have hsplit : ∀ n : ℕ, (∑ i, ∫ ω in
        {ω | ε ≤ |totalDiff μ U coord g c step k a eps m n i ω|},
        (totalDiff μ U coord g c step k a eps m n i ω) ^ 2 ∂μ)
      = (∑ i, ∫ ω in {ω | ε ≤ |rowDiff μ U coord g c step k n i ω|},
          (rowDiff μ U coord g c step k n i ω) ^ 2 ∂μ)
        + ∑ j, ∫ ω in {ω | ε ≤ |cellDiff a eps m n j ω|},
          (cellDiff a eps m n j ω) ^ 2 ∂μ := by
    intro n
    show ∑ i : Fin (k n + m n), _ = _
    rw [Fin.sum_univ_add]
    congr 1
    · refine Finset.sum_congr rfl fun j _ => ?_
      have hj : totalDiff μ U coord g c step k a eps m n (Fin.castAdd (m n) j)
          = rowDiff μ U coord g c step k n j := concatArray_castAdd n j
      rw [hj]
    · refine Finset.sum_congr rfl fun j _ => ?_
      have hj : totalDiff μ U coord g c step k a eps m n (Fin.natAdd (k n) j)
          = cellDiff a eps m n j := concatArray_natAdd n j
      rw [hj]
  simpa only [hsplit, add_zero] using (hlat ε hε).add (hcell ε hε)

/-- The martingale CLT for the full statistic `T_n(L) = ∑_tc_tg(U_t) + ∑_oc'x̃_oε_o`. -/
theorem tendsto_charFun_total [Nonempty ι] [IsProbabilityMeasure μ]
    (hU : ∀ n v, Measurable (U n v)) (hindep : ∀ n, iIndepFun (U n) μ)
    (hg : ∀ n, Measurable (g n))
    (hsq : ∀ n t, MemLp (degenTerm (U n) (coord n) (g n) t) 2 μ)
    (hdeg : ∀ (n : ℕ) (t : T) (e' : Set ι), e' ≠ Set.univ →
      μ[degenTerm (U n) (coord n) (g n) t | latentSigma (U n) (coord n t '' e')] =ᵐ[μ] 0)
    (hN : ∀ n v, step n v < k n)
    (hc : IsCellModel (m0 := m0) μ (latentBase U step k) eps sg m)
    {σ2 : ℝ} (hσ : 0 ≤ σ2)
    (hvar : ∀ δ : ℝ, 0 < δ →
      Tendsto (fun n => (μ {ω | δ ≤
        |mdsCondVariance (fun n => k n + m n) (totalDiff μ U coord g c step k a eps m)
          (totalSigma U step k eps m) μ n ω - σ2|}).toReal) atTop (𝓝 0))
    (hlind : ∀ ε : ℝ, 0 < ε →
      Tendsto (fun n => ∑ i, ∫ ω in
          {ω | ε ≤ |totalDiff μ U coord g c step k a eps m n i ω|},
        (totalDiff μ U coord g c step k a eps m n i ω) ^ 2 ∂μ) atTop (𝓝 0))
    (u : ℝ) :
    Tendsto (fun n => charFun (μ.map (fun ω =>
        degenSum (U n) (coord n) (g n) (c n) ω + cellSum a eps m n ω)) u) atTop
      (𝓝 (charFun (gaussianReal 0 (Real.toNNReal σ2)) u)) := by
  have hint : ∀ n t, Integrable (degenTerm (U n) (coord n) (g n) t) μ :=
    fun n t => (hsq n t).integrable one_le_two
  have hmap : ∀ n : ℕ, μ.map (fun ω =>
      degenSum (U n) (coord n) (g n) (c n) ω + cellSum a eps m n ω)
      = μ.map (mdsRowSum (fun n => k n + m n)
          (totalDiff μ U coord g c step k a eps m) n) := fun n =>
    Measure.map_congr (mdsRowSum_total_ae hU hindep hg hint hdeg hN n).symm
  simp only [hmap]
  exact mds_clt (isMDSArray_total (sg := sg) hU hsq hc) hσ hvar hlind u

end Total

/-! #### The conditional variance condition for the total array -/

section Assembly

open Matrix Var

variable {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}

/-- The martingale CLT for the full statistic with `hvar` derived from Lemma SM.C.3. `halg` is
required for the latent part at `cellc = 0`, as provided by `Alg.halg_of_multiKernel`, and the
cell constant of `hnorm` is `∑_o(c'x̃_o)²σ²_ε(o)`. -/
theorem tendsto_charFun_total_of_concentration [IsProbabilityMeasure μ]
    {ι : Type*} [Fintype ι] [Nonempty ι] {T : Type*} [Fintype T] [DecidableEq T]
    {K : Type*} [Fintype K] [DecidableEq K] {N : K → Type*}
    [∀ k, Fintype (N k)] [∀ k, DecidableEq (N k)]
    {R : Type*} [DecidableEq R] {ψ : R → ℝ → ℝ} {Rpos : Set R} {B₀ : ℝ}
    {Γ : Type*} [Fintype Γ] [DecidableEq Γ] {S : ℕ → Γ → Type*} [∀ n γ, Fintype (S n γ)]
    {Ix : ℕ → Type*} [∀ n, Fintype (Ix n)] {τ : Type*} [DecidableEq τ] {tag : Γ → τ}
    {U : ℕ → Site K N → Ω → ℝ}
    {sites : ∀ (n : ℕ) (γ : Γ), S n γ → Finset (Site K N)}
    {rIdx : ∀ _n : ℕ, Γ → Site K N → R}
    {arr : ∀ (n : ℕ) (γ : Γ), S n γ → Ix n → ℝ}
    {lev : Γ → Finset K} {pt : ∀ (n : ℕ) (γ : Γ), S n γ → K → Site K N}
    {lam : Γ → ℝ} {cellc : ℕ → ℝ} {cutmax totmax : ℕ → ℝ}
    {coord : ℕ → T → ι → Site K N} {g : ℕ → (ι → ℝ) → ℝ} {c : ℕ → T → ℝ}
    {step : ℕ → Site K N → ℕ} {k : ℕ → ℕ}
    {a : ℕ → ℕ → ℝ} {eps : ℕ → ℕ → Ω → ℝ} {sg : ℕ → ℕ → ℝ} {m : ℕ → ℕ}
    (hbs : ∀ n, IsBasisSystem μ (U n) ψ Rpos B₀)
    (hg : ∀ n, Measurable (g n))
    (hsq : ∀ n t, MemLp (degenTerm (U n) (coord n) (g n) t) 2 μ)
    (hdeg : ∀ (n : ℕ) (t : T) (e' : Set ι), e' ≠ Set.univ →
      μ[degenTerm (U n) (coord n) (g n) t | latentSigma (U n) (coord n t '' e')] =ᵐ[μ] 0)
    (hN : ∀ n v, step n v < k n)
    (hcm : IsCellModel μ (latentBase U step k) eps sg m)
    (hsite : ∀ (n : ℕ) (q : Γ) (x : S n q), sites n q x = (lev q).image (pt n q x))
    (hptc : ∀ (n : ℕ) (q q' : Γ) (x : S n q) (y : S n q') (b b' : K),
      pt n q x b = pt n q' y b' → b = b')
    (hptf : ∀ (n : ℕ) (q : Γ) (x : S n q), ∀ b ∈ lev q, (pt n q x b).1 = b)
    (hpos : ∀ (n : ℕ) (q : Γ) (x : S n q), ∀ w ∈ sites n q x, rIdx n q w ∈ Rpos)
    (hinj : ∀ (n : ℕ) (q : Γ) (x y : S n q), sites n q x = sites n q y → x = y)
    (hsep : ∀ (n : ℕ) (q q' : Γ) (x : S n q) (y : S n q'), tag q = tag q' →
      sites n q x = sites n q' y → (∀ w ∈ sites n q x, rIdx n q w = rIdx n q' w) → q = q')
    (hlam : ∑ γ, lam γ ^ 2 ≤ 1)
    (hcut : ∀ (n : ℕ) (γ : Γ),
      rectFrobNorm (Matrix.of (arr n γ) * (Matrix.of (arr n γ))ᵀ) ≤ cutmax n)
    (hcutA : ∀ (n : ℕ) (q : Γ), ∀ Bs ⊂ lev q,
      rectFrobNorm (Matrix.of (levMat lev (pt n) Bs q (arr n q)) *
        (Matrix.of (levMat lev (pt n) Bs q (arr n q)))ᵀ) ≤ cutmax n)
    (htot : ∀ (n : ℕ) (γ : Γ), rectFrobSq (arr n γ) ≤ totmax n)
    (hnorm : ∀ n, (∑ γ, lam γ ^ 2 * rectFrobSq (arr n γ)) + cellc n = 1)
    (hcellc : ∀ n, cellc n = cellConst a sg m n)
    (halg : ∀ n, mdsCondVariance k (rowDiff μ U coord g c step k) (rowSigma U step k) μ n
      =ᵐ[μ] fun ω => quadForm (U n) ψ (sites n) (rIdx n) (arr n) tag lam ω + 0)
    (hrate : Tendsto (fun n =>
        clauseBConst B₀ (Fintype.card Γ) (Fintype.card K)
          * (cutmax n * totmax n)) atTop (𝓝 0))
    (hlind : ∀ ε : ℝ, 0 < ε →
      Tendsto (fun n => ∑ i, ∫ ω in
          {ω | ε ≤ |totalDiff μ U coord g c step k a eps m n i ω|},
        (totalDiff μ U coord g c step k a eps m n i ω) ^ 2 ∂μ) atTop (𝓝 0))
    (u : ℝ) :
    Tendsto (fun n => charFun (μ.map (fun ω =>
        degenSum (U n) (coord n) (g n) (c n) ω + cellSum a eps m n ω)) u) atTop
      (𝓝 (charFun (gaussianReal 0 1) u)) := by
  have halgtot : ∀ n, mdsCondVariance (fun n => k n + m n)
      (totalDiff μ U coord g c step k a eps m) (totalSigma U step k eps m) μ n
      =ᵐ[μ] fun ω => quadForm (U n) ψ (sites n) (rIdx n) (arr n) tag lam ω + cellc n :=
    fun n => condVar_total_of_latent hcm (halg n) (hcellc n)
  have hvar := tendstoInProb_condVar_of_concentration (N := fun _ => N) (S := S) (Ix := Ix)
    (U := U) (sites := sites) (rIdx := rIdx) (arr := arr) (lev := lev) (pt := pt)
    (lam := lam) (cellc := cellc) (cutmax := cutmax) (totmax := totmax)
    (Vn := fun n => mdsCondVariance (fun n => k n + m n)
      (totalDiff μ U coord g c step k a eps m) (totalSigma U step k eps m) μ n)
    hbs hsite hptc hptf hpos hinj hsep hlam hcut hcutA htot hnorm halgtot hrate
  have h := tendsto_charFun_total (μ := μ) (U := U) (coord := coord) (g := g) (c := c)
    (step := step) (k := k) (a := a) (eps := eps) (sg := sg) (m := m)
    (fun n v => (hbs n).measurable_latent v) (fun n => (hbs n).indep)
    hg hsq hdeg hN hcm (σ2 := 1) zero_le_one hvar hlind u
  simpa using h

end Assembly
/-! #### The second moment of the row sum -/

section Second

variable {Ω : Type*} {m0 : MeasurableSpace Ω} {μ : Measure Ω} [IsProbabilityMeasure μ]
variable {k : ℕ → ℕ} {X : (n : ℕ) → Fin (k n) → Ω → ℝ}
  {F : (n : ℕ) → Fin (k n + 1) → MeasurableSpace Ω}

/-- Martingale-difference increments are orthogonal. -/
theorem integral_mul_eq_zero_of_mds (h : IsMDSArray k X F μ) (n : ℕ) {i j : Fin (k n)}
    (hij : i < j) : ∫ ω, X n i ω * X n j ω ∂μ = 0 := by
  have hle : F n j.castSucc ≤ m0 := h.le_ambient n _
  have hstep : F n i.succ ≤ F n j.castSucc := by
    refine h.mono n ?_
    simp only [Fin.le_def, Fin.val_succ, Fin.val_castSucc]
    exact hij
  have hXi : StronglyMeasurable[F n j.castSucc] (X n i) :=
    ((h.adapted n i).stronglyMeasurable).mono hstep
  have hXjint : Integrable (X n j) μ := (h.memLp n j).integrable one_le_two
  have hprod : Integrable (X n i * X n j) μ := (h.memLp n i).integrable_mul (h.memLp n j)
  have hpull := condExp_mul_of_stronglyMeasurable_left (m := F n j.castSucc) hXi hprod hXjint
  have hzero : μ[X n i * X n j | F n j.castSucc] =ᵐ[μ] 0 := by
    filter_upwards [hpull, h.condexp_zero n j] with ω hω hω0
    show (μ[X n i * X n j | F n j.castSucc]) ω = (0 : Ω → ℝ) ω
    rw [hω]
    show X n i ω * (μ[X n j | F n j.castSucc]) ω = (0 : Ω → ℝ) ω
    rw [show (μ[X n j | F n j.castSucc]) ω = (0 : Ω → ℝ) ω from hω0]
    simp
  calc ∫ ω, X n i ω * X n j ω ∂μ
      = ∫ ω, (μ[X n i * X n j | F n j.castSucc]) ω ∂μ := (integral_condExp hle).symm
    _ = 0 := by rw [integral_congr_ae hzero]; simp

/-- `𝔼[(∑_κD_κ)²] = 𝔼[V_n]` for a martingale-difference array. -/
theorem integral_mdsRowSum_sq (h : IsMDSArray k X F μ) (n : ℕ) :
    ∫ ω, (mdsRowSum k X n ω) ^ 2 ∂μ = ∫ ω, mdsCondVariance k X F μ n ω ∂μ := by
  have hoff : ∀ i j : Fin (k n), i ≠ j → ∫ ω, X n i ω * X n j ω ∂μ = 0 := by
    intro i j hij
    rcases lt_or_gt_of_ne hij with hlt | hgt
    · exact integral_mul_eq_zero_of_mds h n hlt
    · rw [integral_congr_ae (Filter.Eventually.of_forall fun ω => mul_comm (X n i ω) (X n j ω))]
      exact integral_mul_eq_zero_of_mds h n hgt
  have hprodint : ∀ i j : Fin (k n), Integrable (fun ω => X n i ω * X n j ω) μ :=
    fun i j => (h.memLp n i).integrable_mul (h.memLp n j)
  have hL : ∫ ω, (mdsRowSum k X n ω) ^ 2 ∂μ = ∑ i : Fin (k n), ∫ ω, X n i ω ^ 2 ∂μ := by
    have hexp : (fun ω => (mdsRowSum k X n ω) ^ 2)
        = fun ω => ∑ i : Fin (k n), ∑ j : Fin (k n), X n i ω * X n j ω := by
      funext ω
      show (∑ i, X n i ω) ^ 2 = _
      rw [pow_two, Finset.sum_mul_sum]
    rw [hexp, integral_finsetSum _ fun i _ =>
      integrable_finsetSum _ fun j _ => hprodint i j]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [integral_finsetSum _ fun j _ => hprodint i j]
    rw [Finset.sum_eq_single_of_mem i (Finset.mem_univ i)
      fun j _ hji => hoff i j (Ne.symm hji)]
    exact integral_congr_ae (Filter.Eventually.of_forall fun ω => (pow_two (X n i ω)).symm)
  have hR : ∫ ω, mdsCondVariance k X F μ n ω ∂μ = ∑ i : Fin (k n), ∫ ω, X n i ω ^ 2 ∂μ := by
    show ∫ ω, ∑ i : Fin (k n), (μ[fun ω' => X n i ω' ^ 2 | F n i.castSucc]) ω ∂μ = _
    rw [integral_finsetSum _ fun i _ => integrable_condExp]
    exact Finset.sum_congr rfl fun i _ => integral_condExp (h.le_ambient n i.castSucc)
  rw [hL, hR]

end Second

/-! #### `hsecond`, `hTr` and `hstep5` for the full statistic -/

section Consumer

open Var

variable {Ω : Type*} {m0 : MeasurableSpace Ω} {μ : Measure Ω} [IsProbabilityMeasure μ]
variable {V ι T : Type*} [Fintype ι] [Nonempty ι] [Fintype T] [DecidableEq T]
variable {R : Type*} [DecidableEq R] {ψ : R → ℝ → ℝ} {Rpos : Set R} {B₀ : ℝ}
variable {Γ : Type*} [Fintype Γ] [DecidableEq Γ] {S : Γ → Type*} [∀ γ, Fintype (S γ)]
variable {Ix : Type*} [Fintype Ix] {τ : Type*} [DecidableEq τ]

omit [IsProbabilityMeasure μ] in
/-- The cell part of `T_n(L)` is square integrable. -/
theorem memLp_cellSum {a : ℕ → ℕ → ℝ} {eps : ℕ → ℕ → Ω → ℝ} {sg : ℕ → ℕ → ℝ} {m : ℕ → ℕ}
    {base : ℕ → MeasurableSpace Ω} (hcm : IsCellModel (m0 := m0) μ base eps sg m) (n : ℕ) :
    MemLp (cellSum a eps m n) 2 μ := by
  have hfun : cellSum a eps m n
      = ∑ j : Fin (m n), (a n (j : ℕ)) • eps n (j : ℕ) := by
    funext ω
    show ∑ j : Fin (m n), a n (j : ℕ) * eps n (j : ℕ) ω = _
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
  rw [hfun]
  exact memLp_finsetSum' _ fun j _ => (hcm.l2 n (j : ℕ)).const_smul _

omit [DecidableEq Γ] in
/-- `hsecond` as an equality: `𝔼[(T_n(L)/s_n(L))²] = ∑_γλ_γ²‖W^{(e_γ)}_c‖_F² + cellc = 1`. -/
theorem integral_total_sq [Fintype V] [DecidableEq V]
    {U : ℕ → V → Ω → ℝ} {coord : ℕ → T → ι → V} {g : ℕ → (ι → ℝ) → ℝ} {c : ℕ → T → ℝ}
    {step : ℕ → V → ℕ} {k : ℕ → ℕ} {a : ℕ → ℕ → ℝ} {eps : ℕ → ℕ → Ω → ℝ} {sg : ℕ → ℕ → ℝ}
    {m : ℕ → ℕ} {sites : ∀ γ : Γ, S γ → Finset V} {rIdx : Γ → V → R}
    {arr : ∀ γ : Γ, S γ → Ix → ℝ} {tag : Γ → τ} {lam : Γ → ℝ} {cellc : ℝ} {n : ℕ}
    (hbs : IsBasisSystem μ (U n) ψ Rpos B₀)
    (hU : ∀ n v, Measurable (U n v)) (hindep : ∀ n, iIndepFun (U n) μ)
    (hg : ∀ n, Measurable (g n))
    (hsq : ∀ n t, MemLp (degenTerm (U n) (coord n) (g n) t) 2 μ)
    (hdeg : ∀ (n : ℕ) (t : T) (e' : Set ι), e' ≠ Set.univ →
      μ[degenTerm (U n) (coord n) (g n) t | latentSigma (U n) (coord n t '' e')] =ᵐ[μ] 0)
    (hN : ∀ n v, step n v < k n)
    (hcm : IsCellModel (m0 := m0) μ (latentBase U step k) eps sg m)
    (hpos : ∀ (γ : Γ) (s : S γ), ∀ w ∈ sites γ s, rIdx γ w ∈ Rpos)
    (hinj : ∀ (γ : Γ) (s s' : S γ), sites γ s = sites γ s' → s = s')
    (hsep : ∀ (γ γ' : Γ) (s : S γ) (s' : S γ'), tag γ = tag γ' → sites γ s = sites γ' s' →
      (∀ w ∈ sites γ s, rIdx γ w = rIdx γ' w) → γ = γ')
    (halg : mdsCondVariance k (rowDiff μ U coord g c step k) (rowSigma U step k) μ n
      =ᵐ[μ] fun ω => quadForm (U n) ψ sites rIdx arr tag lam ω + 0)
    (hcellc : cellc = cellConst a sg m n)
    (hnorm : (∑ γ, lam γ ^ 2 * rectFrobSq (arr γ)) + cellc = 1) :
    ∫ ω, (degenSum (U n) (coord n) (g n) (c n) ω + cellSum a eps m n ω) ^ 2 ∂μ = 1 := by
  have hint : ∀ n t, Integrable (degenTerm (U n) (coord n) (g n) t) μ :=
    fun n t => (hsq n t).integrable one_le_two
  have hmds := isMDSArray_total (a := a) (c := c) (sg := sg) hU hsq hcm
  have hrow := mdsRowSum_total_ae (a := a) (c := c) (eps := eps) (m := m)
    hU hindep hg hint hdeg hN n
  have h1 : ∫ ω, (degenSum (U n) (coord n) (g n) (c n) ω + cellSum a eps m n ω) ^ 2 ∂μ
      = ∫ ω, (mdsRowSum (fun n => k n + m n)
          (totalDiff μ U coord g c step k a eps m) n ω) ^ 2 ∂μ := by
    refine integral_congr_ae ?_
    filter_upwards [hrow] with ω hω
    rw [hω]
  have h2 := integral_mdsRowSum_sq hmds n
  have h3 : ∫ ω, mdsCondVariance (fun n => k n + m n)
        (totalDiff μ U coord g c step k a eps m) (totalSigma U step k eps m) μ n ω ∂μ
      = ∫ ω, (quadForm (U n) ψ sites rIdx arr tag lam ω + cellc) ∂μ :=
    integral_congr_ae (condVar_total_of_latent hcm halg hcellc)
  rw [h1, h2, h3, integral_add ((memLp_quadForm hbs).integrable one_le_two)
    (integrable_const _), integral_quadForm hbs hpos hinj hsep, integral_const]
  simpa using hnorm


omit [IsProbabilityMeasure μ] [Nonempty ι] [Fintype ι] [DecidableEq T] [DecidableEq Γ] in
/-- `hTr` for the full statistic `T_n(L)`. -/
theorem memLp_total {U : ℕ → V → Ω → ℝ} {coord : ℕ → T → ι → V} {g : ℕ → (ι → ℝ) → ℝ}
    {c : ℕ → T → ℝ} {a : ℕ → ℕ → ℝ} {eps : ℕ → ℕ → Ω → ℝ} {sg : ℕ → ℕ → ℝ} {m : ℕ → ℕ}
    {base : ℕ → MeasurableSpace Ω} (hcm : IsCellModel (m0 := m0) μ base eps sg m) {n : ℕ}
    (hlat : MemLp (degenSum (U n) (coord n) (g n) (c n)) 2 μ) :
    MemLp (fun ω => degenSum (U n) (coord n) (g n) (c n) ω + cellSum a eps m n ω) 2 μ :=
  hlat.add (memLp_cellSum hcm n)

omit [DecidableEq T] [DecidableEq Γ] in
/-- `hstep5` for the full statistic: the cell parts of `n^{-1/2}c'X̃'ν` and of
`σ_{n,L}T_n(L)/s_n(L)` cancel (`hscalecell`), so the `L²` gap is that of the latent tail and
`Alg.hstep5_of_tail` applies. -/
theorem hstep5_total_of_tail {U : V → Ω → ℝ} {coord : T → ι → V} {G g : (ι → ℝ) → ℝ}
    {cf cfull : T → ℝ} {xi : Ω → ℝ} {sc taus D : ℝ}
    {a acFull : ℕ → ℕ → ℝ} {eps : ℕ → ℕ → Ω → ℝ} {m : ℕ → ℕ} {n : ℕ}
    (hU : ∀ v, Measurable (U v)) (hindep : iIndepFun U μ)
    (hGg : Measurable (G - g))
    (hsqd : ∀ t, MemLp (degenTerm U coord (G - g) t) 2 μ)
    (hdegd : ∀ (t : T) (e' : Set ι), e' ≠ Set.univ →
      μ[degenTerm U coord (G - g) t | latentSigma U (coord t '' e')] =ᵐ[μ] 0)
    (hsep : ∀ t s : T, t ≠ s →
      (∃ i : ι, coord s i ∉ tupleSupport coord t) ∨
      (∃ i : ι, coord t i ∉ tupleSupport coord s))
    (hmom : ∀ t : T, ∫ ω, degenTerm U coord (G - g) t ω ^ 2 ∂μ = taus)
    (hxi : ∀ ω, xi ω = degenSum U coord G cfull ω + cellSum acFull eps m n ω)
    (hscale : ∀ t : T, sc * cf t = cfull t)
    (hscalecell : ∀ q : ℕ, sc * a n q = acFull n q)
    (hbound : (∑ t : T, cfull t ^ 2) * taus ≤ D) :
    ∫ ω, (xi ω - sc * (degenSum U coord g cf ω + cellSum a eps m n ω)) ^ 2 ∂μ ≤ D := by
  have hrw : ∀ ω, xi ω - sc * (degenSum U coord g cf ω + cellSum a eps m n ω)
      = degenSum U coord G cfull ω - sc * degenSum U coord g cf ω := by
    intro ω
    have hc : cellSum acFull eps m n ω = sc * cellSum a eps m n ω := by
      show ∑ q : Fin (m n), acFull n (q : ℕ) * eps n (q : ℕ) ω
        = sc * ∑ q : Fin (m n), a n (q : ℕ) * eps n (q : ℕ) ω
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl fun q _ => by rw [← hscalecell (q : ℕ)]; ring
    rw [hxi ω, hc]
    ring
  simp only [hrw]
  exact Alg.hstep5_of_tail (xi := fun ω => degenSum U coord G cfull ω) hU hindep hGg hsqd
    hdegd hsep hmom (fun _ => rfl) hscale hbound
end Consumer
